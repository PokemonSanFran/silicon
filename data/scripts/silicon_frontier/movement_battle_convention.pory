script BattleConvention_Movement_MovePlayerIntoBattlePosition
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == FALSE)
    {
        applymovement(LOCALID_CONVENTION_PARTNER,moves(set_invisible))
        waitmovement(LOCALID_CONVENTION_PARTNER)
    }

    callnative(Script_SiliconFrontier_GetBattleIndexValue)
    switch (var(VAR_TEMP_D))
    {
        case 0:
        case 4:
        applymovement(LOCALID_PLAYER,moves(walk_up * 3))
        applymovement(LOCALID_CONVENTION_PARTNER,moves(walk_up * 3))
        case 1:
        case 2:
        case 3:
        applymovement(LOCALID_CONVENTION_OPPONENT_A,moves(walk_up,face_down))
        applymovement(LOCALID_PLAYER,moves(walk_right * 3))
        applymovement(LOCALID_CONVENTION_PARTNER,moves(walk_right * 3))
        applymovement(LOCALID_CONVENTION_OPPONENT_B,moves(walk_down,face_up))
        case 5:
        case 6:
        case 7:
        case 8:
        applymovement(LOCALID_PLAYER,moves(walk_left * 3))
        applymovement(LOCALID_CONVENTION_PARTNER,moves(walk_left * 3))
        case 9:
        applymovement(LOCALID_PLAYER,moves(walk_down * 3))
        applymovement(LOCALID_CONVENTION_PARTNER,moves(walk_down * 3))
    }
    delay(24)
    fadescreen(FADE_TO_BLACK)

    callnative(Script_SiliconFrontier_GetBattleIndexValue)
    switch (var(VAR_TEMP_D))
    {
        case 0:
            setobjectxy(LOCALID_PLAYER,8,83)
            TeleportCamera(8,83)

            setobjectxy(LOCALID_CONVENTION_PARTNER,8,84)

            setobjectxy(LOCALID_CONVENTION_OPPONENT_A,9,76)
            setobjectxy(LOCALID_CONVENTION_OPPONENT_B,10,76)

            setobjectxyperm(LOCALID_CONVENTION_OPPONENT_A,9,76)
            setobjectxyperm(LOCALID_CONVENTION_OPPONENT_B,10,76)

            addobject(LOCALID_CONVENTION_OPPONENT_A)
            addobject(LOCALID_CONVENTION_OPPONENT_B)

            waitmovement(LOCALID_PLAYER)
            waitmovement(LOCALID_CONVENTION_PARTNER)

            moveobjecttocoords(LOCALID_PLAYER,9,80,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_PARTNER,9,81,DIR_EAST)
        case 1:
            setobjectxy(LOCALID_PLAYER,7,44)
            TeleportCamera(7,44)

            setobjectxy(LOCALID_CONVENTION_PARTNER,7,45)

            setobjectxy(LOCALID_CONVENTION_OPPONENT_A,9,40)
            setobjectxy(LOCALID_CONVENTION_OPPONENT_B,10,40)

            setobjectxyperm(LOCALID_CONVENTION_OPPONENT_A,9,40)
            setobjectxyperm(LOCALID_CONVENTION_OPPONENT_B,10,40)

            addobject(LOCALID_CONVENTION_OPPONENT_A)
            addobject(LOCALID_CONVENTION_OPPONENT_B)

            waitmovement(LOCALID_PLAYER)
            waitmovement(LOCALID_CONVENTION_PARTNER)

            moveobjecttocoords(LOCALID_PLAYER,9,44,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_PARTNER,9,45,DIR_EAST)
        case 2:
        case 3:
        case 4:
        case 5:
        case 6:
        case 7:
        case 8:
        case 9:
    }

    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == FALSE)
    {
        removeobject(LOCALID_CONVENTION_OPPONENT_B)
    }

    fadescreen(FADE_FROM_BLACK)
    waitmovement(LOCALID_PLAYER)
    waitmovement(LOCALID_CONVENTION_PARTNER)
}

script BattleConvention_Movement_MoveOpponentsIntoPosition
{
    callnative(Script_SiliconFrontier_GetBattleIndexValue)
    switch (var(VAR_TEMP_D))
    {
        case 0:
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_B,13,82,DIR_WEST)
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_A,13,81,DIR_WEST)
        case 1:
        case 2:
        case 3:
        case 4:
        case 5:
        case 6:
        case 7:
        case 8:
        case 9:
    }
    waitmovement(LOCALID_CONVENTION_OPPONENT_B)
    waitmovement(LOCALID_CONVENTION_OPPONENT_A)
}

script BattleConvention_Movement_MoveBattlersIntoBattle
{
    callnative(Script_SiliconFrontier_GetBattleIndexValue)
    switch (var(VAR_TEMP_D))
    {
        case 0:
            moveobjecttocoords(LOCALID_PLAYER,10,80,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_A,12,81,DIR_WEST)
            moveobjecttocoords(LOCALID_CONVENTION_PARTNER,10,81,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_B,12,82,DIR_WEST)
        case 1:
            moveobjecttocoords(LOCALID_PLAYER,10,44,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_A,12,44,DIR_WEST)
            moveobjecttocoords(LOCALID_CONVENTION_PARTNER,10,45,DIR_EAST)
            moveobjecttocoords(LOCALID_CONVENTION_OPPONENT_B,12,45,DIR_WEST)
        case 2:
        case 3:
        case 4:
        case 5:
        case 6:
        case 7:
        case 8:
        case 9:
    }
    waitmovement(LOCALID_PLAYER)
    waitmovement(LOCALID_CONVENTION_OPPONENT_A)
    waitmovement(LOCALID_CONVENTION_OPPONENT_B)
    waitmovement(LOCALID_CONVENTION_PARTNER)
}

script BattleConvention_Script_TryHidePartner
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == TRUE)
    {
        return
    }
    setobjectflagfromlocalid(LOCALID_CONVENTION_PARTNER)
}

script BattleConvention_Movement_MoveBattlersOutOfBattle
{
    applymovement(LOCALID_CONVENTION_OPPONENT_A,moves(walk_left))
    applymovement(LOCALID_CONVENTION_OPPONENT_B,moves(walk_left))
    waitmovement(LOCALID_CONVENTION_OPPONENT_A)
    waitmovement(LOCALID_CONVENTION_OPPONENT_B)
}

script BattleConvention_Movement_LeaveForBattleRoom
{
    goto(SiliconFrontier_Script_WalkIntoRoom)
}

script BattleConvention_Script_RefreshOpponentObjects
{
    removeobject(LOCALID_CONVENTION_OPPONENT_A)
    clearobjectflagfromlocalid(LOCALID_CONVENTION_OPPONENT_A)
    addobject(LOCALID_CONVENTION_OPPONENT_A)

    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == TRUE)
    {
        removeobject(LOCALID_CONVENTION_OPPONENT_B)
        clearobjectflagfromlocalid(LOCALID_CONVENTION_OPPONENT_B)
        addobject(LOCALID_CONVENTION_OPPONENT_B)
    }
}

script BattleConvention_Movement_CueAttendant
{
    cueobjectplayer(LOCALID_CONVENTION_OPPONENT_A)
    cueobjectplayer(LOCALID_CONVENTION_OPPONENT_B)
}
