script SiliconFrontier_Script_DoGameBoardSequence
{
    callnative(Script_SiliconFrontier_GetFacilityFromCurrentChallenge)
    if (var(VAR_TEMP_F) != SILICON_FACILITY_ARCADE)
    {
        return
    }

    call(BattleStudio_Movement_MoveMCToGameBoard)
    call(BattleStudio_Dialogue_LetsSeeEvent)
    closemessage
    callnative(SiliconFrontier_DeleteAllHeldItems)
    callnative(StartArcadeGameBoardFromOverworld)
    waitstate
    goto(SiliconFroniter_Script_HandleGameResults)
}


script SiliconFroniter_Script_HandleGameResults
{
    //apply overworld effect if any
    call(BattleStudio_Movement_FaceImpact)
    if (var(LOCAL_VAR_GAME_BOARD_SUCCESS) == TRUE)
    {
        call(BattleStudio_Dialogue_AnnounceNextBattleSuccess)
    }
    else
    {
        call(BattleStudio_Dialogue_AnnounceNextBattleFailure)
    }
    closemessage
    call(BattleStudio_Movement_MoveMCToGameBoard)
    // instead of skip battle, increment the counter by 1 and contnue ahead here
    return
}

script SiliconFrontier_BattleStudio_Script_FacePlayerAttendant
{
    turnobject(LOCALID_PLAYER,DIR_EAST)
    turnobject(LOCALID_ZENZU_ISLAND_GYM_ATTENDANT,DIR_WEST)
}

script BattleStudio_Script_DescribeRoulette
{
    callnative(Script_Buffer_GetCursorSpeed)
    msgbox(format("The roulette's current speed is {STR_VAR_1}."),,SPEAKER_BATTLE_STUDIO)
    if (var(LOCAL_VAR_ROULETTE_DATA) == ARCADE_SPEED_LEVEL_MIN)
    {
        msgbox(format("This is the lowest speed."),,SPEAKER_BATTLE_STUDIO)
    }
    if (var(LOCAL_VAR_ROULETTE_DATA) == ARCADE_SPEED_LEVEL_4)
    {
        msgbox(format("This is the default speed."),,SPEAKER_BATTLE_STUDIO)
    }
    if (var(LOCAL_VAR_ROULETTE_DATA) == ARCADE_SPEED_LEVEL_MAX)
    {
        msgbox(format("This is the fastest speed."),,SPEAKER_BATTLE_STUDIO)
    }

    callnative(Script_IsCursorRandom)
    if (var(LOCAL_VAR_ROULETTE_DATA) == TRUE)
    {
        msgbox(format("The cursor is in Random mode, meaning it will randomly move around the Game Board."),,SPEAKER_BATTLE_STUDIO)
    }
    callnative(Script_GetBerryItemArcade)
    msgbox(format("If the roulette event is Give Berry, the recieving side will be loaned {STR_VAR_1}. If the roulette event is Give Item, the recieving side will be loaned {STR_VAR_2}."),,SPEAKER_BATTLE_STUDIO)
    buffernumberstring(STR_VAR_1,SILICON_FRONTIER_STREAK_LENGTH_BOSS)
    msgbox(format("The roulette's properties are reset every {STR_VAR_1} battles."),,SPEAKER_BATTLE_STUDIO)
    goto(BattleStudio_Script_AskRoulette)
}

script BattleStudio_Script_AskRoulette
{
    msgbox(format("Would you like to learn about specific Roulette Events?"),MSGBOX_YESNO,SPEAKER_BATTLE_STUDIO)
    goto_if_eq(VAR_RESULT,NO,SiliconFrontier_Script_BattleMenu)
    goto(BattleStudio_Script_ShowEventList)
}

script BattleStudio_Script_ShowEventList
{
    dynmultichoice(0,0,FALSE,3,0,NULL,
            "Lower HP",
            "Poison",
            "Paralyze",
            "Burn",
            "Sleep",
            "Freeze",
            "Give Berry",
            "Give Item",
            "Level Up",
            "Sun",
            "Rain",
            "Sand",
            "Snow",
            "Fog",
            "Trick Room",
            "Swap",
            "Speed Up",
            "Speed Down",
            "Random",
            "Give BP Small",
            "No Battle",
            "Give BP Big",
            "No Event",
            "Never mind.")

    switch(var(VAR_RESULT))
    {
    case ARCADE_EVENT_LOWER_HP:
        msgbox(format("All of the Pokemon of the given side will lose 20% of their HP."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_POISON:
        msgbox(format("All of the Pokemon of the given side will be poisoned."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_PARALYZE:
        msgbox(format("All of the Pokemon of the given side will be laralyzed."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_BURN:
        msgbox(format("All of the Pokemon of the given side will be burned."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SLEEP:
        msgbox(format("One randomly chosen Pokemon from each party of the given side will be asleep. If the randomly chosen Pokemon cannot be put to sleep, nothing happens! "),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_FREEZE:
        msgbox(format("One randomly chosen Pokemon from each party of the given side will be frozen. If the randomly chosen Pokemon cannot be put to sleep, nothing happens!"),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_GIVE_BERRY:
        msgbox(format("Every 10 battles, a berry is randomly chosen based on the length of your streak. When this event is selected, all of the Pokemon of the given side will be side will be given that berry. Every 10 battles, the berry is removed."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_GIVE_ITEM:
        msgbox(format("Every 10 battles, an item is randomly chosen based on the length of your streak. When this event is selected, all of the Pokemon of the given side will be side will be given that item. Every 10 battles, the item is removed."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_LEVEL_UP:
        msgbox(format("All of the Pokemon of the given side will gain 3 levels."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SUN:
        msgbox(format("The battle will be conducted under permanent harsh sunlight."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_RAIN:
        msgbox(format("The battle will be conducted under permanent rain."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SAND:
        msgbox(format("The battle will be conducted under permanent sandstorm."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SNOW:
        msgbox(format("The battle will be conducted under permanent snow."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_FOG:
        msgbox(format("The battle will be conducted under permanent fog."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_TRICK_ROOM:
        msgbox(format("The battle will be conducted under permanent Trick Room."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SWAP:
        msgbox(format("One randomly chosen Pokemon from each party will be swapped with a Pokemon on the opposing side."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SPEED_UP:
        msgbox(format("The roulette speed will increase by one level."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_SPEED_DOWN:
        msgbox(format("The roulette speed will decrease by one level."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_RANDOM:
        msgbox(format("The roulette will randomly move between events."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_GIVE_BP_SMALL:
        msgbox(format("The battle will award 1 extra Battle Point."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_NO_BATTLE:
        msgbox(format("The battle is skipped."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_GIVE_BP_BIG:
        msgbox(format("The battle will award 3 extra Battle Points."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_NO_EVENT:
        msgbox(format("The battle occurs as normal."),,SPEAKER_BATTLE_STUDIO)
    case ARCADE_EVENT_COUNT:
        goto(SiliconFrontier_Script_BattleMenu)
    case MULTI_B_PRESSED:
        goto(SiliconFrontier_Script_BattleMenu)
    }
    goto(BattleStudio_Script_ShowEventList)
}
