script RestrictedSparring_Dialogue_ExplainFacility
{
    msgbox(format("At the {STR_VAR_1}, defeat as many Trainers in a row as you can! Once you register with your party, you battle against a randomly chosen Trainer. If you defeat them, your party is healed and then you battle another Trainer. You keep going until you finally lose."),,SPEAKER_RESTRICTED_SPARRING)
}

