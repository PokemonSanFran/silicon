script RestrictedSparring_Dialogue_WelcomeBackNewChallenge
{
    msgbox(format("Welcome back! Are you ready to start a new {STR_VAR_1} challenge?"),MSGBOX_YESNO,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WelcomeBackContinueChallenge
{
    msgbox(format("Welcome back! Are you here to continue your {STR_VAR_1} challenge?"),MSGBOX_YESNO,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WelcomeToThe
{
    msgbox(format("Welcome to the {STR_VAR_1}! What would you like to do?"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_HopeToSeeYou
{
    msgbox(format("We hope to see you again!"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WhatWouldYouLikeInfo
{
    msgbox(format("What would you like information on?"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_ExplainFacility
{
    msgbox(format("At the {STR_VAR_1}, defeat as many Trainers in a row as you can.  You may only register Pokemon of one specific type of your choice. You then battle against a randomly chosen Trainer. If you defeat them, then you battle another Trainer. Between battles, you may heal your party up to two times during a single streak. You keep going until you finally lose."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_YouCanCompete
{
    msgbox(format("You can compete with any Pokemon normally found in Resido."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_YouCannotCompete
{
    msgbox(format("You cannot compete with these Pokemon."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_YouRecieveBP
{
    msgbox(format("After every win, you recieve {STR_VAR_1} Battle Point. Battle Points can be used to purchases prizes!"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_EveryXWins
{
    msgbox(format("Every {STR_VAR_1} wins, you'll get {STR_VAR_2} Battle Points, and every win after that will reward an extra {STR_VAR_3} Battle Point."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_OneTimeBonus
{
    msgbox(format("After earning the {STR_VAR_1} or {STR_VAR_2} for the first time, you'll get a one time bonus of {STR_VAR_3} Points!"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_OnceYourParty
{
    msgbox(format("Once your party has been registered, you must save the game to proceed."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_DontTryToCheat
{
    msgbox(format("Don't try to cheat!"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WinningSilver
{
    msgbox(format("After winning {STR_VAR_1} battles in a row, Trainers will recieve the {STR_VAR_2}."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WinningGold
{
    msgbox(format("If they can get to a streak of {STR_VAR_1} wins, Trainers will recieve the coveted {STR_VAR_2}!"),,SPEAKER_RESTRICTED_SPARRING)
}

