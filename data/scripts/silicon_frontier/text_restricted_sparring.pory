}

script RestrictedSparring_Dialogue_IfYouReset
{
    msgbox(format("If you turn off or reset your game before saving again, you will be disqualified, and your entire streak and prizes will be forfeit."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_YouCannotEnter
{
    msgbox(format("Unfortunately, you cannot enter the facility until you save. Please return when you're ready to save."),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_WouldYouLikeToContinue
{
    msgbox(format("Would you like to continue your {STR_VAR_2} battle streak?"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_ThereWasAnError
{
    msgbox(format("There was an error of some kind. Your battle could not be saved."),,SPEAKER_RESTRICTED_SPARRING)
}

