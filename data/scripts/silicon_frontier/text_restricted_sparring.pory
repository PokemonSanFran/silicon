}

script RestrictedSparring_Dialogue_WeHopeContinue
{
    msgbox(format("We hope you continue training with us going forward!"),,SPEAKER_RESTRICTED_SPARRING)
}

script RestrictedSparring_Dialogue_YouWillStop
