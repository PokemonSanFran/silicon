script BattleJam_Movement_MovePlayerIntoBattlePosition
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == FALSE)
    {
        moveobjecttocoords(LOCALID_PLAYER,3,5,DIR_EAST)
    }
    else
    {
        moveobjecttocoords(LOCALID_TOWER_PARTNER,3,4,DIR_EAST)
        moveobjecttocoords(LOCALID_PLAYER,3,6,DIR_EAST)
        waitmovement(LOCALID_TOWER_PARTNER)
    }
    waitmovement(LOCALID_PLAYER)
}

script BattleJam_Movement_MoveOpponentsIntoPosition
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == FALSE)
    {
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_A,6,5,DIR_WEST)
    }
    else
    {
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_A,6,4,DIR_WEST)
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_B,6,6,DIR_WEST)
    }
    waitmovement(LOCALID_PLAYER)
    waitmovement(LOCALID_TOWER_OPPONENT_A)

    if (var(VAR_TEMP_E) == TRUE)
    {
        waitmovement(LOCALID_TOWER_OPPONENT_B)
    }
}

script BattleJam_Movement_MoveBattlersIntoBattle
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == FALSE)
    {
        moveobjecttocoords(LOCALID_PLAYER,4,5,DIR_EAST)
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_A,5,5,DIR_WEST)
        waitmovement(LOCALID_PLAYER)
        waitmovement(LOCALID_TOWER_OPPONENT_A)
    }
    else
    {
        moveobjecttocoords(LOCALID_PLAYER,4,6,DIR_EAST)
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_A,5,4,DIR_WEST)
        moveobjecttocoords(LOCALID_TOWER_PARTNER,4,4,DIR_EAST)
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_B,5,6,DIR_WEST)
        waitmovement(LOCALID_PLAYER)
        waitmovement(LOCALID_TOWER_OPPONENT_A)
        waitmovement(LOCALID_TOWER_OPPONENT_B)
        waitmovement(LOCALID_TOWER_PARTNER)
    }
}

script BattleJam_Script_TryHidePartner
{
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == TRUE)
    {
        return
    }
    setobjectflagfromlocalid(LOCALID_TOWER_PARTNER)
}

script BattleJam_Movement_MoveBattlersOutOfBattle
{
    moveobjecttocoords(LOCALID_TOWER_OPPONENT_A,4,1,DIR_NORTH)
    moveobjecttocoords(LOCALID_PLAYER,2,5,DIR_WEST)
    moveobjecttocoords(LOCALID_TIRABUDIN_BATTLE_ROOM_ATTENDANT,1,5,DIR_EAST)
    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == TRUE)
    {
        moveobjecttocoords(LOCALID_TOWER_OPPONENT_B,5,1,DIR_NORTH)
        moveobjecttocoords(LOCALID_TOWER_PARTNER,1,4,DIR_SOUTH)
    }

    waitmovement(LOCALID_TOWER_OPPONENT_A)
    applymovement(LOCALID_TOWER_OPPONENT_A,moves(set_invisible))
    waitmovement(LOCALID_TOWER_OPPONENT_A)
    playse(SE_EXIT)
    if (var(VAR_TEMP_E) == TRUE)
    {
        waitmovement(LOCALID_TOWER_OPPONENT_B)
        applymovement(LOCALID_TOWER_OPPONENT_B,moves(set_invisible))
        waitmovement(LOCALID_TOWER_OPPONENT_B)
        playse(SE_EXIT)
    }
    waitmovement(LOCALID_TOWER_PARTNER)
    waitmovement(LOCALID_PLAYER)
    waitmovement(LOCALID_TIRABUDIN_BATTLE_ROOM_ATTENDANT)
}

script BattleJam_Movement_LeaveForBattleRoom
{
    moveobjecttocoords(LOCALID_BATTLE_TOWER_SINGLES_ATTENDANT,5,2,DIR_WEST)
    delay(32)
    opendoor(4,1)
    moveobjecttocoords(LOCALID_PLAYER,4,3,DIR_NORTH)
    waitmovement(LOCALID_PLAYER)
    waitdooranim
    playse(SE_EXIT)
    applymovement(LOCALID_PLAYER,moves(walk_up * 2,set_invisible))
    waitmovement(LOCALID_PLAYER)
    waitse
    closedoor(4,1)
    waitdooranim
    warpsilent(MAP_TIRABUDIN_PLACE_GYM_BATTLE_ROOM,0)
    waitstate
}

script BattleJam_Script_RefreshOpponentObjects
{
    removeobject(LOCALID_TOWER_OPPONENT_A)
    clearobjectflagfromlocalid(LOCALID_TOWER_OPPONENT_A)
    addobject(LOCALID_TOWER_OPPONENT_A)

    callnative(Script_SiliconFroniter_IsCurrentChallengeTypeMulti)
    if (var(VAR_TEMP_E) == TRUE)
    {
        removeobject(LOCALID_TOWER_OPPONENT_B)
        clearobjectflagfromlocalid(LOCALID_TOWER_OPPONENT_B)
        addobject(LOCALID_TOWER_OPPONENT_B)
    }
}

script BattleJam_Movement_CueAttendant
{
    cueobjectplayer(LOCALID_TIRABUDIN_BATTLE_ROOM_ATTENDANT)
}
