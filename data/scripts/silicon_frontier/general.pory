script SiliconFrontier_Dialogue_InteractAttendant
{
    lock
    callnative(SiliconFrontier_SetCurrentChallengeFacilityFromMap)
    callnative(Script_SiliconFrontier_GetLastChallengeTypeFromCurrentFacility)
    call_if_ne(VAR_RESULT,SILICON_FRONTIER_CHALLENGE_TYPE_NONE,SiliconFrontier_Dialogue_AskResume)
    goto(SiliconFroniter_Dialogue_AskMenu)
}

script SiliconFrontier_Dialogue_AskResume
{
    callnative(BufferLastChallengeType)
    callnative(SiliconFrontier_GetLastChallengeStreakLength)
    if (var(VAR_RESULT) == 0)
    {
        call(SiliconFrontier_Dialogue_WelcomeBackNewChallenge)
    }
    else
    {
        call(SiliconFrontier_Dialogue_WelcomeBackContinueChallenge)
    }
    if (var(VAR_RESULT) == NO)
    {
        callnative(SiliconFrontier_ResetLastChallenge)
        return
    }
    callnative(SiliconFrontier_SetCurrentChallengeFromLastChallenge)
    goto(SiliconFrontier_Script_ChoosePartyMons)
}

script SiliconFroniter_Dialogue_AskMenu
{
    callnative(Script_BufferGetFacilityName)
    call(SiliconFrontier_Dialogue_WelcomeToThe)
    dynmultichoice(0,0,FALSE,3,0,NULL, "Start Challenge", "Info", "Never mind.")
    switch (var(VAR_RESULT))
    {
        case 0: goto(SiliconFrontier_Script_RegisterChallenge)
        case 1: goto(SiliconFrontier_Dialogue_ExplainFacilityMenu)
        case MULTI_B_PRESSED:
        case 2: goto(SiliconFrontier_Script_QuitAttendant)
    }
}
script SiliconFrontier_Script_QuitAttendant
{
    callnative(SiliconFrontier_ResetCurrentChallenge)
    callnative(SiliconFrontier_ResetCurrentPartner)
    call(SiliconFrontier_Dialogue_HopeToSeeYou)
    closemessage
    release
    end
}

script SiliconFrontier_Dialogue_ExplainFacilityMenu
{
    call(SiliconFrontier_Dialogue_WhatWouldYouLikeInfo)
    dynmultichoice(0,0,FALSE,3,0,NULL, "Rules", "Pokemon Allowed", "Battle Points", "Saving", "Bosses", "Never mind.")
    switch(var(VAR_RESULT))
    {
        case 0: call(SiliconFrontier_Dialogue_ExplainFacility)
        case 1: call(SiliconFrontier_Dialogue_AllowedPokemon)
        case 2: call(SiliconFrontier_Dialogue_BattlePoints)
        case 3: call(SiliconFrontier_Dialogue_ExplainSaving)
        case 4: call(SiliconFrontier_Dialogue_ExplainBadges)
        default: goto(SiliconFroniter_Dialogue_AskMenu)
    }
    goto(SiliconFrontier_Dialogue_ExplainFacilityMenu)
}

script SiliconFrontier_Dialogue_AllowedPokemon
{
    callnative(Script_SiliconFroniter_CountCaughtBlockedSpecies)
    call(SiliconFrontier_Dialogue_YouCanCompete)
    if (var(VAR_0x8005))
    {
        call(SiliconFrontier_Dialogue_YouCannotCompete)
        callnative(ShowBattleFrontierCaughtBannedSpecies)
        waitstate
    }
}

script SiliconFrontier_Dialogue_BattlePoints
{
    callnative(Script_BufferBasePoints)
    call(SiliconFrontier_Dialogue_YouRecieveBP)

    callnative(Script_BufferBossPoints)
    call(SiliconFrontier_Dialogue_EveryXWins)

    callnative(Script_BufferMilestonePoints)
    call(SiliconFrontier_Dialogue_OneTimeBonus)
}

script SiliconFrontier_Dialogue_ExplainSaving
{
    call(SiliconFrontier_Dialogue_OnceYourParty)
    call(SiliconFrontier_Dialogue_IfYouReset)
    call(SiliconFrontier_Dialogue_DontTryToCheat)
}

script SiliconFrontier_Dialogue_ExplainBadges
{
    callnative(Script_BufferSilverBadgeAndStreak)
    call(SiliconFrontier_Dialogue_WinningSilver)
    callnative(Script_BufferGoldBadgeAndStreak)
    call(SiliconFrontier_Dialogue_WinningGold)
}

script SiliconFrontier_Script_RegisterChallenge
{
    call(SiliconFrontier_Dialogue_WhichChallenge)
    dynmultipush(gText_Single,SILICON_FRONTIER_CHALLENGE_TYPE_SINGLE)
    dynmultipush(gText_Double,SILICON_FRONTIER_CHALLENGE_TYPE_DOUBLE)
    dynmultipush(gText_Multi,SILICON_FRONTIER_CHALLENGE_TYPE_MULTI)
    dynmultipush("Never mind.",MULTI_B_PRESSED)
    dynmultistack(0, 0, FALSE, 3, TRUE, 0, NULL)
    goto_if_eq(VAR_RESULT,MULTI_B_PRESSED,SiliconFrontier_Script_QuitAttendant)
    callnative(SiliconFrontier_SetCurrentChallengeFacilityFromMap)
    callnative(SiliconFrontier_SetCurrentChallengeChallengeTypeFromVarResult)
    call(RestrictedSparring_Script_PickSparringType)
    call(RestrictedSparring_Script_HandleHealsBeforeChallenge)
    goto(SiliconFrontier_Script_ChoosePartyMons)
}

script SiliconFrontier_Script_ChoosePartner
{
    callnative(Script_SiliconFrontier_GetTypeFromCurrentChallenge)
    if (var(VAR_TEMP_0) != SILICON_FRONTIER_CHALLENGE_TYPE_MULTI)
    {
        return
    }
    callnative(SiliconFrontier_DebugChoosePartner)
}

script SiliconFrontier_Script_ChoosePartyMons
{
    callnative(SiliconFrontier_SetLastChallengeFromCurrentChallenge)
    callnative(Script_SiliconFrontier_IsPartyValidForChallenge)
    if (var(VAR_RESULT) == FALSE)
    {
        goto(SiliconFrontier_Dialogue_NotEnough)
    }
    call(SiliconFrontier_Script_ChoosePartner)
    call(SiliconFrontier_Dialogue_WhichPokemon)
    closemessage
    special(SavePlayerParty)
    callnative(SiliconFrontier_SetPartyScreenPickAmount)
    special(ChoosePartyForBattleFrontier)
    goto_if_eq(VAR_RESULT,FALSE,SiliconFrontier_Script_QuitAttendant)
    callnative(SiliconFrontier_SetSelectedMons)
    callnative(SiliconFrontier_CheckMonEligibility)
    callnative(Script_SiliconFrontier_AreChosenMonsEligible)
    if (var(VAR_RESULT) == FALSE)
    {
        goto(SiliconFrontier_Dialogue_InvalidParty)
    }
    call(SiliconFrontier_Dialogue_YourPartyHas)
    setvar(VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_STARTED)
    startmenu_savescreen
    goto_if_unset(FLAG_SYS_SAVE_SUCCESSFUL,SiliconFrontier_Script_NeedToSave)
    special(ReducePlayerPartyToSelectedMons)
    call(SiliconFrontier_Dialogue_IfYouReset)
    closemessage
    goto(SiliconFrontier_Movement_LeaveForBattleRoom)
}

script SiliconFrontier_Script_NeedToSave
{
    special(LoadPlayerParty)
    callnative(SiliconFrontier_ResetCurrentPartner)
    callnative(SiliconFrontier_ResetCurrentChallenge)
    call(SiliconFrontier_Dialogue_YouCannotEnter)
    goto(SiliconFrontier_Script_QuitAttendant)
}

script SiliconFrontier_Script_WalkIntoRoom
{
    lock
    setvar(VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_IN_PROGRESS)
    goto(SiliconFrontier_Script_StartBattle)
}

script SiliconFrontier_Script_StartBattle
{
    callnative(SiliconFrontier_AllowRecordedBattle)
    call(SiliconFrontier_Movement_MovePlayerIntoBattlePosition)
    callnative(LevelUpAllPokemonForFrontier)

    callnative(SiliconFrontier_SetUpOpponent)

    call(SiliconFrontier_Script_RefreshOpponentObjects)
    call(SiliconFrontier_Movement_MoveOpponentsIntoPosition)
    callnative(SiliconFrontier_SetUpTextA)
    msgbox(format("{STR_VAR_1}"))
    closemessage

    call(SiliconFrontier_Movement_MoveBattlersIntoBattle)
    callnative(SiliconFrontier_StartFacilityBattle)
    waitstate
    specialvar(VAR_RESULT,GetBattleOutcome)
    goto_if_ne(VAR_RESULT,B_OUTCOME_WON,SiliconFrontier_Script_LossBattle)
    goto(SiliconFrontier_Script_WonBattle)
    end
}

script SiliconFrontier_Script_WonBattle
{
    lock
    callnative(SiliconFrontier_TryIncrementWinStreakAndRecord)
    showbpbox
    callnative(SiliconFrontier_BufferBP)
    variableaddbp(VAR_0x8007,TRUE)
    call(SiliconFrontier_Movement_MoveBattlersOutOfBattle)
    callnative(Script_SiliconFrontier_GetFacilityFromCurrentChallenge)
    if (var(VAR_TEMP_F) != SILICON_FACILITY_SPARRING)
    {
        bypass_healblock
    }
    call(SiliconFrontier_Movement_CueAttendant)
    hidebpbox
    waitse
    callnative(SiliconFrontier_TryAwardBadge)
    call_if_ne(VAR_RESULT,SILICON_FRONTIER_BOSS_PHASE_COUNT,SiliconFrontier_Dialogue_AwardBadge)
    clearflag(FLAG_TEMP_12)
    goto(SiliconFrontier_Script_BattleMenu)
}

script SiliconFrontier_Script_TryShowQuitMenuOption
{
    callnative(Script_SiliconFrontier_GetFacilityFromCurrentChallenge)
    if (var(VAR_TEMP_F) == SILICON_FACILITY_SPARRING)
    {
        dynmultipush("Quit",SILICON_FACILITY_STREAK_MENU_QUIT)
    }
    else
    {
        dynmultipush("Leave",SILICON_FACILITY_STREAK_MENU_LEAVE)
    }
}

script SiliconFrontier_Script_TryShowHeal
{
    callnative(Script_SiliconFrontier_GetRemainingHeals)
    if (var(VAR_TEMP_E) <= 0)
    {
        return
    }

    if (flag(FLAG_TEMP_12) == TRUE)
    {
        return
    }

    dynmultipush("Heal",SILICON_FACILITY_STREAK_MENU_HEAL)
}

script SiliconFrontier_Script_TryShowRecord
{
    callnative(Script_SiliconFrontier_CanBattleBeRecorded)
    if (var(VAR_TEMP_E) == TRUE)
    {
        dynmultipush("Record",SILICON_FACILITY_STREAK_MENU_RECORD)
    }
}

script SiliconFrontier_Script_BattleMenu
{
    playse(SE_USE_ITEM)
    callnative(SiliconFrontier_BufferCurrentStreakString)
    call(SiliconFrontier_Dialogue_YourPartyHasBeenHealed)
    waitse
    dynmultipush("Continue",SILICON_FACILITY_STREAK_MENU_CONTINUE)
    call(SiliconFrontier_Script_TryShowQuitMenuOption)
    call(SiliconFrontier_Script_TryShowHeal)
    call(SiliconFrontier_Script_TryShowRecord)
    dynmultistack(0, 0, TRUE, 3, TRUE, 0, NULL)

    switch(var(VAR_RESULT))
    {
        case SILICON_FACILITY_STREAK_MENU_CONTINUE:
            closemessage
            goto(SiliconFrontier_Script_StartBattle)
        case SILICON_FACILITY_STREAK_MENU_LEAVE:
            goto(SiliconFrontier_Script_LeaveChallenge)
        case SILICON_FACILITY_STREAK_MENU_RECORD:
            goto(SiliconFroniter_Script_RecordBattle)
        case SILICON_FACILITY_STREAK_MENU_QUIT:
            goto(RestrictedSparring_Script_AskQuit)
        case SILICON_FACILITY_STREAK_MENU_HEAL:
            goto(RestrictedSparring_Script_AskHeal)
    }
}

script SiliconFroniter_Script_RecordBattle
{
    frontier_savebattle
    if (var(VAR_RESULT) == FALSE)
    {
        call(SiliconFrontier_Dialogue_ThereWasAnError)
    }
    else
    {
        playse(SE_SAVE)
        call(SiliconFrontier_Dialogue_YourBattleWasRecorded)
    }
    goto(SiliconFrontier_Script_BattleMenu)
}

script SiliconFrontier_Dialogue_AwardBadge
{
    callnative(SiliconFrontier_BufferAwardSpeech)
    call(SiliconFrontier_Dialogue_CongratulationsOnYourWin)
    playfanfare(MUS_GET_BADGE)
    call(SiliconFrontier_Dialogue_ForYourWonderfulAchievement)
    waitfanfare

    if (var(VAR_RESULT) == SILICON_FRONTIER_BOSS_PHASE_SILVER)
    {
        call(SiliconFrontier_BufferGoldMilestone)
        call(SiliconFrontier_Dialogue_WeLookForward)
    }

    call(BattleJam_Dialogue_WeHopeContinue)
}

script SiliconFrontier_Script_LossBattle
{
    lock
    callnative(SiliconFrontier_ResetCurrentStreak)
    goto(SiliconFrontier_Script_LeaveBattleRoom)
}

script SiliconFrontier_Script_LeaveChallenge
{
    call(SiliconFrontier_Dialogue_YouWillStop)
    closemessage
    goto(SiliconFrontier_Script_LeaveBattleRoom)
}

script SiliconFrontier_Script_LeaveBattleRoom
{
    setvar(VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_ENDED)

    callnative(Script_SiliconFrontier_GetFacilityFromCurrentChallenge)
    switch (var(VAR_TEMP_F))
    {
        case SILICON_FACILITY_SPARRING:
            warpsilent(MAP_HODOU_CITY_GYM,6,7)
        case SILICON_FACILITY_TOWER:
            warpsilent(MAP_TIRABUDIN_PLACE_GYM_LOBBY,4,5)
        case SILICON_FACILITY_ARCADE:
        case SILICON_FACILITY_FACTORY:
    }
    waitstate
}

script SiliconFrontier_Dialogue_Disqualified
{
    lock
    faceplayer
    callnative(SiliconFrontier_ResetCurrentStreak)
    call(SiliconFrontier_Dialogue_YouTurnedOff)
    goto(SiliconFrontier_Script_SaveAfterQuitChallenge)
}

script SiliconFrontier_Script_SaveAfterQuitChallenge
{
    lock
    call(SiliconFrontier_Dialogue_WeWillNow)
    closemessage
    callnative(SiliconFrontier_ResetCurrentPartner)
    callnative(SiliconFrontier_ResetCurrentChallenge)
    special(LoadPlayerParty)
    setvar(VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_NOT_STARTED)
    setflag(FLAG_SHOULD_SKIP_CREDITS)
    startmenu_savescreen
    clearflag(FLAG_SHOULD_SKIP_CREDITS)
    call_if_unset(FLAG_SYS_SAVE_SUCCESSFUL,SiliconFrontier_Dialogue_SaveFailed)
    goto(SiliconFrontier_Script_QuitAttendant)
}

script SiliconFrontier_Dialogue_NotEnough
{
    callnative(BufferLastChallengeType)
    callnative(BufferPartySizeForChallenge)
    call(SiliconFrontier_Dialogue_NotEnoughMons)
    goto(SiliconFrontier_Script_AdjustPartyQuit)
}

script SiliconFrontier_Dialogue_InvalidParty
{
    setvar(VAR_0x8006,0)
    do
    {
        callnative(SiliconFrontier_ReturnPartyCodes)
        switch (var(VAR_RESULT))
        {
            case SILICON_FRONTIER_ELIGIBILITY_CODE_PASS: delay(1)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_EGG:
                call(SiliconFrontier_Dialogue_EligibilityEgg)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_LEGENDARY:
                call(SiliconFrontier_Dialogue_EligibilityLegendary)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_SPECIES:
                call(SiliconFrontier_Dialogue_EligibilitySpecies)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_ITEM:
                call(SiliconFrontier_Dialogue_EligibilityItem)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_TYPE:
                call(RestrictedSparring_Dialogue_EligibilityType)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_SPECIES_ITEM:
                call(SiliconFrontier_Dialogue_EligibilitySpecies)
                call(SiliconFrontier_Dialogue_EligibilityItem)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_SPECIES_TYPE:
                call(SiliconFrontier_Dialogue_EligibilitySpecies)
                call(RestrictedSparring_Dialogue_EligibilityType)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_ITEM_TYPE:
                call(RestrictedSparring_Dialogue_EligibilityType)
                call(SiliconFrontier_Dialogue_EligibilityItem)
            case SILICON_FRONTIER_ELIGIBILITY_CODE_ALL:
                call(SiliconFrontier_Dialogue_EligibilitySpecies)
                call(RestrictedSparring_Dialogue_EligibilityType)
                call(SiliconFrontier_Dialogue_EligibilityItem)
        }
        addvar(VAR_0x8006,1)
    } while (var(VAR_0x8006) < FRONTIER_DOUBLES_PARTY_SIZE)
    special(LoadPlayerParty)
    goto(SiliconFrontier_Script_AdjustPartyQuit)
}

script SiliconFrontier_Script_AdjustPartyQuit
{
    call(SiliconFrontier_Dialogue_AdjustPartyQuit)
    goto(SiliconFrontier_Script_QuitAttendant)
}

script Debug_ToggleBosses
{
    msgbox(format("what boss do you want to unlock?"))
    dynmultichoice(0,0,TRUE,5,0,NULL,"Pua","Baiya","Ami_Argento","Tala","Dimu","Adaora","Emrys","Magnus","Bd","Charlotte","Neriene","Frank","Shinzo","Kei_Ying","Belen","Eleanor")
    callnative(DebugToggleBosses)
    msgbox(format("done"))
    closemessage
    end
}

script SiliconFrontier_Script_FacePlayerUp
{
    turnobject(LOCALID_PLAYER,DIR_NORTH)
}

