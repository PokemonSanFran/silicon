mapscripts CuconuTown_SharpriseCompound_2F_Corridor_MapScripts
{
}

script CuconuTown_SharpriseCompound_2F_Dialogue_Statue
{
	lock
	msgbox(format("A statue of a regal-looking Pokémon."), MSGBOX_DEFAULT)
	closemessage
	release
	end
}

script CuconuTown_SharpriseCompound_2F_Dialogue_CharlotteDoor
{
	lock
	msgbox(format("The door is slightly ajar. It's probably Charlotte's. You shouldn't go in."), MSGBOX_DEFAULT)
	closemessage
	release
	end
}

script CuconuTown_SharpriseCompound_2F_Dialogue_LockDoor
{
	lock
	msgbox(format("The door is firmly locked."), MSGBOX_DEFAULT)
	closemessage
	release
	end
}

script CuconuTown_SharpriseCompound_2F_Dialogue_Bookcase
{
	lock
	msgbox(format("It's full of books about Pokémon battling.\nAnd also, about how to invest in cryptocurrencies."), MSGBOX_DEFAULT)
	closemessage
	release
	end
}
