mapscripts TirabudinPlace_MapScripts
{
	MAP_SCRIPT_ON_RESUME
	{
		callnative(WarpTaxiAfterCutscene)
        call_if_eq(VAR_TIRABUDIN_PLACE_STATE,PARADE_NOT_STARTED,AndWeMarchOn_Script_GenerateParadeCrowd)
	}
    MAP_SCRIPT_ON_TRANSITION
    {
        call(Quest_LastMusicVenue_HidePublicDrummers)
        callnative(LetsGrabLunch_IncrementStoryVariable)
        call(Quest_Inversehallucinogenic_ControlLeaderVisibilityOutside_Script)
    }

    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_TIRABUDIN_PLACE_STATE, PARADE_NOT_STARTED: AndWeMarchOn_Script_WarpPlayerStartParade
        FLAG_VISITED_TIRABUDIN_PLACE, FALSE: Generic_Mappreview
        VAR_STORYLINE_STATE, STORY_WEST_RESIDO_COMPLETE: TheStrikeStrikesBack_PhoneCall_Dialogue
        VAR_STORYLINE_STATE, STORY_RESTORATION_1_COMPLETE: YouRealizeWereEvilRight_PhoneCall_Dialogue
    ]
}

