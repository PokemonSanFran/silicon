mapscripts QiuVillage_MapScripts
{
	MAP_SCRIPT_ON_RESUME
	{
		callnative(WarpTaxiAfterCutscene)
	}
    MAP_SCRIPT_ON_TRANSITION
    {
        call(Quest_Returndoll_Script_DollVisibility)

        call_if_ne(VAR_STORYLINE_STATE,STORY_BEFORE_RAMESH_BREAKIN,ImIn_Script_HideEntireQiuRaidParty)
        call_if_ne(VAR_TOWER_RAID_STATE,0,ImIn_Script_HideEntireQiuRaidParty)
        call_if_eq(VAR_STORYLINE_STATE,STORY_BEFORE_RAMESH_BREAKIN,ImIn_Script_HideQiuSpecificRaidPartyMembers)

        call(CutePokemon_Script_ControlMelissaQiuOutsideVisibility)
        call(Quest_Breaktheinternet_QiuVillageGuy_Visibility_Script)
        call_if_gt(VAR_TOWER_RAID_STATE,0,ImIn_DestroyWall_Script)
    }
    MAP_SCRIPT_ON_LOAD
    {
        call_if_gt(VAR_TOWER_RAID_STATE,0,ImIn_DestroyWall_Script)
    }
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        FLAG_VISITED_QIU_VILLAGE, FALSE: Generic_Mappreview
    ]

}

script Ramesh_House_LockedDoor_Script
{
    msgbox(format("The front door is locked."),MSGBOX_SIGN)
    end
}

script QiuVillage_Guy_Interact_Script
{
    msgbox(gText_ExpandedPlaceholder_Empty,MSGBOX_NPC)
    goto_if_quest_active(QUEST_BREAKTHEINTERNET,Quest_Breaktheinternet_QiuVillage_Script)
    end
}
