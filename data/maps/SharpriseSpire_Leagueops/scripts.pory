const PLAYER = OBJ_EVENT_ID_PLAYER

mapscripts SharpriseSpire_Leagueops_MapScripts{
    MAP_SCRIPT_ON_TRANSITION
    {
        switch(var(VAR_SHARPRISESPIRE_CONFERENCE_STATE))
        {
            case POST_WOW_YOURE_STRONG: call(TheGangsAllHere_ObjectSetup_Script)
            case START_THE_GANGS_ALL_HERE: call(TheGangsAllHere_MidMission_Object_Script)
            case POST_THE_GANGS_ALL_HERE: call(TheGangsAllHere_ObjectCleanUp_Script)
            case PRE_WELCOME_TO_THE_WAR_ROOM: call(WelcomeToTheWarRoom_Object_Setup_Script)
            case POST_WELCOME_TO_THE_WAR_ROOM: call(WelcomeToTheWarRoom_Object_Hide_Script)
            case PRE_YOU_REALIZE_WERE_EVIL_RIGHT: call(YouRealizeWereEvilRight_Object_Setup_Script)
            case POST_YOU_REALIZE_WERE_EVIL_RIGHT:
                call(YouRealizeWereEvilRight_Object_Cleanup_Script)
            case START_FALSE_TIMELINE:
                call(CongratsYoureanAsshole_ObjectCleanUp_Script)
                call(YouHaveYourOrders_ObjectSetUp_Script)
                call(LetsBurnThisMotherDown_ShowLucrezia_Script)
                call_if_quest_complete(QUEST_MANHUNT,Manhunt_Script_HideRamesh)
            case TRUE_RAID_START:
                  call(SharpriseSpire_Leagueops_TrueTimeline_Objects_Script)
            default: call(SharpriseSpire_Leagueops_EmptyConferenceRoomOffices)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_SHARPRISESPIRE_CONFERENCE_STATE, PRE_WELCOME_TO_THE_WAR_ROOM: SharpriseSpire_Leagueops_MovePlayerIntoPosition_Script
        VAR_SHARPRISESPIRE_CONFERENCE_STATE, PRE_YOU_REALIZE_WERE_EVIL_RIGHT: SharpriseSpire_Leagueops_MovePlayerIntoPosition_Script
        VAR_SHARPRISESPIRE_CONFERENCE_STATE, POST_WOW_YOURE_STRONG: TheGangsAllHere_OliverAppearStairs_Script
        VAR_LETSBURNTHISMOTHERSTATE,DEFEATED_BAIYA_ARANTRAZ: LetsBurnThisMotherDown_MissionComplete_Dialogue
        VAR_HOWDISAPPOINTING_STATE,DEFEATED_ADAORA_HODOU_CITY: HowDisappointing_MissionComplete_Dialogue
        VAR_MANHUNT_STATE,DEFEATED_MANHUNT_VIGRIM: Manhunt_MissionComplete_Dialogue
        VAR_STORYLINE_STATE,STORY_3RD_THE_TIDE_TAKEDOWN: ExhibitionBattle_CheckMissionProgress_Script
        VAR_STORYLINE_STATE,STORY_THE_TIDE_FINISHED: ExhibitionBattle_TimeSkip_Script
    ]
    MAP_SCRIPT_ON_LOAD {
        call(ImIn_RevealLucreziaWarp_Script)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_SHARPRISESPIRE_CONFERENCE_STATE,PRE_WELCOME_TO_THE_WAR_ROOM: WelcomeToTheWarRoom_Object_Setup_Script
    ]
}

script SharpriseSpire_Leagueops_TrueTimeline_Objects_Script{
        switch(var(VAR_TOWER_RAID_STATE)){
            case TEAM_ENTERED_SHARPRISESPIRE: call(ImIn_PreCharlotte_Object_Script)
            case SAVE_CHARLOTTE_SHARPRISESPIRE:
            default: call(ImIn_SaveCharlotte_Object_Script)
    }
    return
}

script SharpriseSpire_Leagueops_EmptyConferenceRoomOffices{
        setobjectflagfromlocalid(LOCALID_SHARPRISE_OLIVER)
        setobjectflagfromlocalid(LOCALID_SHARPRISE_CHARLOTTE)
        setobjectflagfromlocalid(LOCALID_SHARPRISE_LUCREZIA)
        setobjectflagfromlocalid(LOCALID_LEAGUEOPS_RAMESH)
        setobjectflagfromlocalid(LOCALID_LEAGUEOPS_KEIYING)
}
script SharpriseSpire_Leagueops_MovePlayerIntoPosition_Script{
    lock
        getplayerxy(VAR_TEMP_0,VAR_TEMP_1)

        if (var(VAR_TEMP_0) != 17){
            fadescreen(FADE_TO_BLACK)
                setobjectxy(PLAYER,17,29)
                TeleportCamera(17,29)
                fadescreen(FADE_FROM_BLACK)
        }

    switch (var(VAR_SHARPRISESPIRE_CONFERENCE_STATE)){
        case PRE_WELCOME_TO_THE_WAR_ROOM: goto(WelcomeToTheWarRoom_ExplainSitaution_Dialogue)
        case PRE_YOU_REALIZE_WERE_EVIL_RIGHT: goto(YouRealizeWereEvilRight_Open_Dialogue)
    }
}

script SharpriseSpire_Leagueops_Oliver_Event_Script{
    lock
    faceplayer
    switch (var(VAR_STORYLINE_STATE))
{
        case STORY_MORNING_OF_TIMELINE_SPLIT: call(CongratsYoureAnAsshole_Intro_Dialogue)
        case STORY_START_FALSE_TIMELINE:
        case STORY_1ST_THE_TIDE_TAKEDOWN:
        case STORY_2ND_THE_TIDE_TAKEDOWN: call(LetsBurnThisMotherDown_Interact_Oliver_Script)
    }
    release
    end
}

script SharpriseSpire_Leagueops_Keiying_Event_Script{
    lock
    faceplayer
    switch(var(VAR_STORYLINE_STATE)){
        case STORY_MORNING_OF_TIMELINE_SPLIT: call(CongratsYoureAnAsshole_Intro_Dialogue)
        case STORY_START_FALSE_TIMELINE:
        case STORY_1ST_THE_TIDE_TAKEDOWN:
        case STORY_2ND_THE_TIDE_TAKEDOWN: call(YouHaveYourOrders_Interact_Keiying_Script)
}
release
end
}

script SharpriseSpire_Leagueops_Ramesh_Event_Script{
    lock
    faceplayer
    switch(var(VAR_STORYLINE_STATE)){
        case STORY_MORNING_OF_TIMELINE_SPLIT: return
        case STORY_START_FALSE_TIMELINE:
        case STORY_1ST_THE_TIDE_TAKEDOWN:
        case STORY_2ND_THE_TIDE_TAKEDOWN: goto(Manhunt_Interact_Ramesh_Script)
}
release
end
}

script SharpriseSpire_Leagueops_CheckRewardStatus_Script
{
    callnative(Script_FalseTimeline_CheckRewardStatus)
    call_if_eq(VAR_RESULT,TRUE,SharpriseSpire_Leagueops_ClearSecondaryCharacters_Script)
}

script SharpriseSpire_Leagueops_ClearSecondaryCharacters_Script
{
    removeobject(LOCALID_SHARPRISE_CHARLOTTE)
    removeobject(LOCALID_SHARPRISE_LUCREZIA)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_CHARLOTTE)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_LUCREZIA)
}

script LeagueOps_LucreziaComputer_Script
{
    lock
    msgbox(format("There is an open email draft on Lucrezia's screen."))
    if (var(VAR_STORYLINE_STATE) >= STORY_WARP_TILE_ACCESSIBLE)
    {
        msgbox(format("I am disappointed in the Champion's recent behavior, as I know you are as well. Though, before {PLAYER} turned we extracted enough value from {SUBJECT} to cover our investment many times over so I consider this loss acceptable. PARC is now fully operational, The Tide is eliminated, and there is nothing that can sta"))
    }
    elif (var(VAR_STORYLINE_STATE) >= STORY_WON_FINALS)
    {
        msgbox(format("As predicted, our preferred candidate continues to succeed and show promise. We have begun Ramesh's second phase media tour and our approval ratings are slowly beginning to climb by using the Trainer as our public face.\nThey were instrumental in landing a blow against The Tide and we are making progress with reviving PARC."))
    }
    else
    {
        msgbox(format("We have identified two candidates from the Kickstart Program that we believe will be most malleable and guarentee our return on investment. There are no other League participants of note at this time."))
    }
    releaseall
    end
}

