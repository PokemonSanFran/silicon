mapscripts PintillonHouse_Exterior_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
    {
        call_if_ge(VAR_BATTLE_8_STATE,DEFEATED_BAIYA_PINTILLONHOUSE,Battle8_Script_HideBaiya)
    }
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        FLAG_VISITED_PINTILLONHOUSE, FALSE: Generic_Mappreview
        VAR_STORYLINE_STATE, STORY_WEST_RESIDO_COMPLETE: TheStrikeStrikesBack_PhoneCall_Dialogue
    ]
}
