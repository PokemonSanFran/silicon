mapscripts PetarosaBorough_MapScripts {
	MAP_SCRIPT_ON_RESUME
	{
		callnative(WarpTaxiAfterCutscene)
	}
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_STORYLINE_STATE, STORY_WEST_RESIDO_COMPLETE: TheStrikeStrikesBack_PhoneCall_Dialogue
                FLAG_VISITED_PETAROSA_BOROUGH, FALSE: Generic_Mappreview
    ]

    MAP_SCRIPT_ON_TRANSITION {
        call_if_lt(VAR_FORT_YOBU_STATE,MET_KEIYING_OUTSIDE_GYM,FriendsForDinner_BlockMansionAccess_Script)
        call_if_set(FLAG_TIMELINE_TRUE,FriendsForDinner_BlockMansionAccess_Script)
        call(Quest_Breaktheinternet_WarehouseGuard_Script)
    }
}

script PetarosaBorough_MansionGuard_InteractScript
{
    if (flag(FLAG_TIMELINE_TRUE))
    {
        msgbox(format("You are no longer welcome here, {PLAYER}."), MSGBOX_NPC,SPEAKER_KEIYING_GUARD)
    }
    elif (var(VAR_FORT_YOBU_STATE) < MET_KEIYING_OUTSIDE_GYM)
    {
        msgbox(format("If you have no business here, please carry on."),MSGBOX_NPC,SPEAKER_KEIYING_GUARD)
    }
    elif (var(VAR_KEIYING_STATE) >= STATE_KEIYING_POST_RAISON_DETRE)
    {
        msgbox(format("I don't believe Kei-Ying is home, but you're welcome to explore the garden, {PLAYER}.."),MSGBOX_NPC,SPEAKER_KEIYING_GUARD)
    }
    else
    {
        msgbox(format("{PLAYER}, Kei-Ying has been expecting you."), MSGBOX_NPC,SPEAKER_KEIYING_GUARD)
    }
    end
}
