mapscripts PerlaciaCity_Exhibition_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
    {
        call_if_quest_not_active(QUEST_ALOHAFROMALOLA,AlohaFromAlola_Script_HideEmrysExhibition)
    }
    MAP_SCRIPT_ON_RESUME
    {
        call_if_eq(VAR_EMRYS_STATE,EMRYS_QUEST_PROGRESS_EXHIBITION_BATTLE_START,AlohaFromAlola_Script_CreateCrowd)
    }
}
