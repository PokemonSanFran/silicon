const PLAYER = OBJ_EVENT_ID_PLAYER
const CHARLOTTE = 1
const ADAORA = 2
const VIGRIM = 3
const BAIYA = 4
const PKMNA = 5
const PKMNB = 6

mapscripts NavalBase_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        call(Navalbase_Object_Setup_Script)
    }
    MAP_SCRIPT_ON_LOAD {
        if (var(VAR_NAVAL_BASE_STATE) > CHASE_VIGRIM){
            call(WhyAreYouHelpingThem_BlowHoleWall)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        FLAG_VISITED_NAVAL_BASE, FALSE: Generic_Mappreview
        VAR_NAVAL_BASE_STATE, NAVAL_BASE_RAID_NOT_STARTED: WhyAreYouHelpingThem_StartRaid
    ]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_NAVAL_BASE_STATE, NAVAL_BASE_RAID_NOT_STARTED: WhyAreYouHelpingThem_Script_CreateRaidPolice
    ]
}

script Navalbase_Object_Setup_Script
{
    switch(var(VAR_NAVAL_BASE_STATE))
    {
        case NAVAL_BASE_RAID_NOT_STARTED: goto(WhyAreYouHelpingThem_HideObject_Script)
        case NAVAL_BASE_RAID_START: goto(WhyAreYouHelpingThem_MoveObject_Script)
        case CHASE_VIGRIM: goto(WhyAreYouHelpingThem_MoveObjectBoss_Script)
        case SAVE_BAIYA_NAVAL_BASE: goto(WhyAreYouHelpingThem_ObjectSetUpPostSave_Script)
        default: goto(WhyAreYouHelpingThem_ObjectCleanUp_Script)
    }
    return
}
