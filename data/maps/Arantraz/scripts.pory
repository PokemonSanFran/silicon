const PLAYER = OBJ_EVENT_ID_PLAYER

mapscripts Arantraz_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
	{
		call_if_lt(VAR_STORYLINE_STATE,STORY_CLEAR,Quest_Rematches_Script_HideTala)
		call_if_quest_not_complete(QUEST_BREAKTHEINTERNET,Quest_Rematches_Script_HideTala)
        call(YouRealizeTheyreEvilRight_HideObject_Script)
        call_if_subquest_complete(QUEST_BODEGABURNOUT,SUB_QUEST_14,Quest_Bodegaburnout_Script_Hide_BodegaburnoutRescueDiveN)
    }

    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
	[
        VAR_STORYLINE_STATE, STORY_EPILOGUE: Epilogue_Script_ObjectVisibility
    ]

    MAP_SCRIPT_ON_FRAME_TABLE
	[
        VAR_STORYLINE_STATE, STORY_EPILOGUE: Epilogue_Script_TalaApproachesBaiya
            FLAG_VISITED_ARANTRAZ, FALSE: Generic_Mappreview
        VAR_ARANTRAZ_STATE, BAIYA_SUMMONED_ARANTRAZ: YouRealizeTheyreEvilRight_PlayerLandedDialogue
    ]
}

script ArantrazAttendant_HealPlayer_Script
{
	lock
	call(Common_EventScript_OutOfCenterPartyHeal)
	msgbox(format("I've healed your party! You can battle these Trainers as often as you like."))
	call(ResetArantrazExhibit_Script)
	closemessage
	release
	end
}

script ResetArantrazExhibit_Script
{
    clearflag(TRAINER_FLAGS_START + TRAINER_0D416B2C)
    clearflag(TRAINER_FLAGS_START + TRAINER_0D4BA0F1)
    clearflag(TRAINER_FLAGS_START + TRAINER_0DA021EF)
    clearflag(TRAINER_FLAGS_START + TRAINER_0E19F1A8)
    clearflag(TRAINER_FLAGS_START + TRAINER_0F03CF8D)
    clearflag(TRAINER_FLAGS_START + TRAINER_0E42221A)

    if (var(VAR_ARANTRAZ_STATE) == FIRST_ARRIVED_ARANTRAZ)
    {
        setvar(VAR_ARANTRAZ_EXHIBIT_STATE,ARANTRAZ_EXHIBIT_NOT_STARTED)
    }
}

script Arantraz_ChooseFerryDestination_Script
{
    call(Ferry_Interact_Dialogue)
}

script Arantraz_Script_Interact_BodegaburnoutRescueDiveN
{
    trainerbattle_single(TRAINER_QUEST_BODEGABURNOUTRESCUEDIVEN,format("Oh! I haven’t seen another human in so long. Keep me company?"),format("If my Pokémon are knocked out, will I be even more lonely?"),Quest_Bodegaburnout_Script_Handle_BodegaburnoutRescueDiveN)
}

script Route4_EventScript_0ED24EF1
{
    trainerbattle_single(TRAINER_0ED24EF1,format("I am a Route Trainer"),format("I lost!"))
    msgbox(format("You defeated me!"),MSGBOX_AUTOCLOSE)
    end
}

script Arantaz_Dialogue_Sign1
{
    buffermapname(STR_VAR_1,MAP_ARANTRAZ)
    msgbox(format("{STR_VAR_1} was originally built as a prison for Resido's most dangerous criminals. {STR_VAR_1} Prison was nationally praised for its state of the art facilities, forward thinking approach to rehabilitation, and no escape attempts."),MSGBOX_SIGN)
}

script Arantaz_Dialogue_Sign2
{
    msgbox(format("The Resido criminal underbelly, using agents within the prison, staged a prison riot. The agents took guards hostage, and demanded that the government turn the island over to the prisoners. This occupation lasted for years, and the demands of the prisoners grew more unreasonable as time went on."),MSGBOX_SIGN)
}

script Arantaz_Dialogue_Sign3
{
    msgbox(format("The prisoners began to turn to the citizens of the region for support. One of their most vocal allies was Magnus, the strongest member of the Resido Elite Four. Magnus organized public rallies and marches, demanding for the release of the prisoners into society, citing the need for a different rehabilitation approach."),MSGBOX_SIGN)
}

script Arantaz_Dialogue_Sign4
{
    msgbox(format("As tensions between the prisoners, their sympathizers, and the government reached a fever pitch, disaster suddenly struck. An unprecedented earthquake ripped through the eastern seaboard of the region, destroying the structure of the prison. Hundreds were injured, and many were killed."),MSGBOX_SIGN)
}

script Arantaz_Dialogue_Sign5
{
    buffermapname(STR_VAR_1,MAP_ARANTRAZ)
    msgbox(format("The natural disaster left the prisoners broken and defeated, and they quickly surrendered. The prisoners were charged with conspiracy and instigation, seperated, and sent to different prisons around the nation. {STR_VAR_1} was shut down."),MSGBOX_SIGN)
}

script Arantaz_Dialogue_Sign6
{
    msgbox(format("The Resido Parks and Recreation has dedicated this plaza to the guards who lost their lives in the disaster and the struggle that divided the region for so long. Late at night, some say you can hear their spirits, still fighting to this day to keep our region safe from criminals."),MSGBOX_SIGN)
}
