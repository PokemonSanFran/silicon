mapscripts TirabudinPlace_Gym_BattleRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION
    {
        setobjectflagfromlocalid(LOCALID_TOWER_OPPONENT_A)
        setobjectflagfromlocalid(LOCALID_TOWER_OPPONENT_B)
        call(BattleJam_Script_TryHidePartner)
    }
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_SILICON_FACILITY_CHALLENGE_STATUS, SILICON_FRONTIER_CHALLENGE_STARTED: SiliconFrontier_Script_WalkIntoRoom
    ]
}

