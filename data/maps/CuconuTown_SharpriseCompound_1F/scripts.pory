mapscripts CuconuTown_SharpriseCompound_1F_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
    {
        call_if_eq(VAR_STORYLINE_STATE,STORY_FERRY_FIXED,AaandWereBack_ObjectHide_Script)
        call_if_eq(VAR_STORYLINE_STATE,STORY_DEFEATED_GARBODOR,VSGarbodor_ReturnToTheCompound_ObjectSetUp)

        call_if_eq(VAR_PLAYER_HOME_STATE,HAS_NOT_MET_CHARLOTTE,ImProbablyBetterThanYou_ObjectSetUp)
        call_if_eq(VAR_PLAYER_HOME_STATE,HAS_MET_CHARLOTTE,ImProbablyBetterThanYou_PostCutscene_ObjectSetUp_Script)
        call_if_eq(VAR_PLAYER_HOME_STATE,CHECKED_OUT_BEDROOM,Swagbag_ObjectSetUp)
        call_if_eq(VAR_PLAYER_HOME_STATE,POST_SWAGBAG,swagbag_ObjectHide_Script)
        call_if_eq(VAR_PLAYER_HOME_STATE,SLEPT_AFTER_SWAGBAG,TwoHoursAgo_ObjectSetUp)
        call_if_eq(VAR_PLAYER_HOME_STATE,FINISHED_1_1,AaandWereBack_ObjectSetUp_Script)
        call_if_eq(VAR_PLAYER_HOME_STATE,POST_NAVAL_BASE_RAID,WhyAreYouHelpingThem_BackAtCompound_ObjectSetUp_Script)
        call_if_eq(VAR_PLAYER_HOME_STATE,NEXT_DAY_CHAMPIONSHIP,AaandWereBack_ObjectHide_Script)
    }

    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_PLAYER_HOME_STATE, HAS_NOT_MET_CHARLOTTE: ImProbablyBetterThanYou_CharlotteIntro_Dialogue
        VAR_PLAYER_HOME_STATE, CHECKED_OUT_BEDROOM: Swagbag_WelcomeToResido_Dialogue
        VAR_PLAYER_HOME_STATE, POST_NAVAL_BASE_RAID:WhyAreYouHelpingThem_BackAtCompound_Dialogue
        VAR_STORYLINE_STATE, STORY_DEFEATED_GARBODOR: VSGarbodor_ReturnToTheCompound_Dialogue
    ]
}

script Charlotte_CuconuTown_Compound_1F_InteractScript
{
    lock
    if (var(VAR_STORYLINE_STATE) == STORY_EAST_RESIDO_COMPLETE)
    {
        call(AaandWereBack_Charlotte_Dialogue)
    }
    else
    {
        call(ImProbablyBetterThanYou_Annoyed_Dialogue)
    }
    release
    end
}

script Oliver_CuconuTown_Compound_1F_InteractScript
{
    lockall
    call_if_ne(VAR_PLAYER_HOME_STATE,SLEPT_AFTER_SWAGBAG,swagbag_HelpPlayer_Script)
    call_if_unset(FLAG_RECIEVED_LEFTOVERS,TwoHoursAgo_TheyreEager_Dialogue)

    if(flag(FLAG_TEMP_1F))
    {
        call(TwoHoursAgo_ExplainLeftovers_Dialouge)
    }
    else
    {
        call(swagbag_HelpPlayer_Script)
    }
    closemessage
    releaseall
    end
}

script CuconuTown_SharpriseCompound_1F_Dialogue_CharlotteFood
{
	lock
	switch (var(VAR_PLAYER_HOME_STATE))
	{
		case PLAYER_HOME_STATE_NONE:
		case HAS_NOT_MET_CHARLOTTE:
		case HAS_MET_CHARLOTTE: 
		case CHECKED_OUT_BEDROOM:
		case POST_SWAGBAG: 
		msgbox(format("Charlotte's partially eaten truffle burger is on a decorated plate. She's a very clean eater."))

		case SLEPT_AFTER_SWAGBAG: msgbox(format("Oliver's breakfast is strewn all over the table. It appears to be a combination of beef jerky and energy drinks."))

		default:
		case FINISHED_1_1: 
		case POST_NAVAL_BASE_RAID: 
		case NEXT_DAY_CHAMPIONSHIP:msgbox(format("The table is empty, aside from your food."))
	}
	closemessage
	release
	end
}

script CuconuTown_SharpriseCompound_1F_Dialogue_FavoriteFood
{
	lock
	callnative(BufferFavoriteFood)
	msgbox(format("There is a plate with {STR_VAR_1}. It smells delicious and is the perfect temperature!"))
	switch (var(VAR_PLAYER_HOME_STATE))
	{
		default:
		case PLAYER_HOME_STATE_NONE:
		case HAS_NOT_MET_CHARLOTTE:
		case HAS_MET_CHARLOTTE: msgbox(format("Woah! Is this why they asked for my favorite food?"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_SHOCK)

		case CHECKED_OUT_BEDROOM:
		case POST_SWAGBAG: msgbox(format("Wait, wasn't this food here earlier too? How is it still fresh?"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_SHOCK)

		case SLEPT_AFTER_SWAGBAG: msgbox(format("I was going to get food once I was on the road but..."),,SPEAKER_ALICIA,TAIL_THOUGHT)  
		case FINISHED_1_1: msgbox(format("How is this always here? Is this somebody's entire job?"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_CONFUSE)
		case POST_NAVAL_BASE_RAID: msgbox(format("Was somebody here cooking while we were at the raid?"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_CONFUSE)
		case NEXT_DAY_CHAMPIONSHIP: msgbox(format("I'm impressed how consistent this is!"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_SHOCK)
	}

	msgbox(format("If they went through the trouble to prepare my favorite..."),,SPEAKER_PLAYER,TAIL_THOUGHT)
	closemessage
	call(Common_EventScript_OutOfCenterPartyHeal)
	fadedefaultbgm
	msgbox(format("You and your Pokemon thought the food was delicious!"))
	closemessage
	releaseall
	end
}
