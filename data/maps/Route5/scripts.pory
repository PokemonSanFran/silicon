mapscripts Route5_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
    }
    MAP_SCRIPT_ON_RESUME{
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_FAINTED_FOG_STATE, ENCOUNTERED_FOG_MON: WarpPlayerAfterFogEncounter
    ]
}

script Route5_InteractHomeless_Script
{
    lock
    if (!flag(FLAG_EDUCATED_FOG_ROUTE5) && var(VAR_FAINTED_FOG_STATE))
    {
        call(FlyingBlind_Dialogue_ExplainKarl)
    }
    call(FlyingBlind_Dialogue_LotsOfPeople)
    call(EventScript_UnhousedInteractPlayer)
    closemessage
    release
    end
}

script Route8_EventScript_Sign1
{
    msgbox(format("▶ Route 5\n{LEFT_ARROW} Irisina Town\n{RIGHT_ARROW} Mermereza City\pTravellers are advised to be mindful of the heavy fog."), MSGBOX_SIGN)
    closemessage
    end
}

script Route8_EventScript_Sign2
{
    msgbox(format("▶ Route 5\n{RIGHT_ARROW} Mermereza City\n{LEFT_ARROW} Irisina Town\pTravellers are advised to be mindful of the heavy fog."), MSGBOX_SIGN)
    closemessage
    end
}

script Route8_EventScript_SignHouse
{
    msgbox(format("House placeholder."), MSGBOX_SIGN)
        closemessage
