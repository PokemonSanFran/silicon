mapscripts Route5_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        call(Quest_Ultrawormholeresearch_ControlTotemVisibility)
    }
    MAP_SCRIPT_ON_RESUME{
        call(Quest_Ultrawormholeresearch_TryRemoveTotem_Script)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_FAINTED_FOG_STATE, ENCOUNTERED_FOG_MON: WarpPlayerAfterFogEncounter
    ]
}

script Route5_InteractHomeless_Script
{
    lock
    if (!flag(FLAG_EDUCATED_FOG_ROUTE5) && var(VAR_FAINTED_FOG_STATE))
    {
        call(FlyingBlind_Dialogue_ExplainKarl)
    }
    call(FlyingBlind_Dialogue_LotsOfPeople)
    call(EventScript_UnhousedInteractPlayer)
    closemessage
    release
    end
}

script Route8_EventScript_Sign1
{
	buffermapname(STR_VAR_1,MAP_ROUTE5)
	buffermapname(STR_VAR_2,MAP_IRISINA_TOWN)
	buffermapname(STR_VAR_3,MAP_MERMEREZA_CITY)
    msgbox(format("▶ {STR_VAR_1}\n{LEFT_ARROW} {STR_VAR_2}\n{RIGHT_ARROW} {STR_VAR_3}\pTravellers are advised to be mindful of the heavy fog."), MSGBOX_SIGN)
    closemessage
    end
}

script Route8_EventScript_Sign2
{
	buffermapname(STR_VAR_1,MAP_ROUTE5)
	buffermapname(STR_VAR_2,MAP_MERMEREZA_CITY)
	buffermapname(STR_VAR_3,MAP_IRISINA_TOWN)
    msgbox(format("▶ {STR_VAR_1}\n{RIGHT_ARROW} {STR_VAR_2}\n{LEFT_ARROW} {STR_VAR_3}\pTravellers are advised to be mindful of the heavy fog."), MSGBOX_SIGN)
    closemessage
    end
}

script Route8_EventScript_SignHouse
{
    msgbox(format("House placeholder."), MSGBOX_SIGN)
        closemessage
    end
}

