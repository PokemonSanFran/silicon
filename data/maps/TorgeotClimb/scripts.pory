mapscripts TorgeotClimb_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call_if_subquest_not_complete(QUEST_WALLACEARMY,SUB_QUEST_3,WallaceArmy_Script_HideStanE)
        call(Quest_IBelieveICanFly_Gertrude_Visibility_Script)
		call(OkayLetsFixit_Script_HikoVisibility)
        call_if_quest_not_complete(QUEST_FINDTHEGUILTY,Quest_Findtheguilty_Script_HideTorgeotFindtheguilityplantH)
    }

    MAP_SCRIPT_ON_LOAD {
        call(Script_RemoveTint)
    }

    MAP_SCRIPT_ON_FRAME_TABLE [
            FLAG_VISITED_TORGEOT_CLIMB_BASE, FALSE: Generic_Mappreview
        VAR_TIME_TRAVEL_STATE, TIME_TRAVEL_FIRST_RETURN: OkayLetsFixit_ReturnToPeak_Script
    ]
}

script TorgeotClimb_Script_Interact_WallacearmystanE
{
    goto_if_quest_active(QUEST_WALLACEARMY,Quest_WallaceArmy_Battle_WallacearmystanE)
    msgbox(format("Wallace is so clever! Every performance he does makes my heart flutter!"),,SPEAKER_WALLACEARMYSTANE)
    bufferspeciesname(STR_VAR_1,SPECIES_WALLACE_MON_E)
    msgbox(format("The way he coordinates with his {STR_VAR_1}… So mesmerizing…"),,SPEAKER_WALLACEARMYSTANE)
    closemessage
    release
    end
}
