mapscripts ZenzuIsland_Gym_MapScripts{
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_ENDED: SiliconFrontier_Script_FacePlayerUp
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_IN_PROGRESS: SiliconFrontier_Dialogue_Disqualified
        VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_STARTED: SiliconFrontier_Dialogue_Disqualified
        VAR_SILICON_FACILITY_CHALLENGE_STATUS,SILICON_FRONTIER_CHALLENGE_ENDED: SiliconFrontier_Script_SaveAfterQuitChallenge
    ]
    MAP_SCRIPT_ON_TRANSITION
    {
        call(BattleStudio_Script_HideOpponents)
        callnative(SiliconFrontier_SetPartnerObject)
    }
}
