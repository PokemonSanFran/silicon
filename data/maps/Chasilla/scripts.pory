mapscripts Chasilla_MapScripts{
	MAP_SCRIPT_ON_RESUME
	{
		callnative(WarpTaxiAfterCutscene)
	}
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_CHASILLA_STATE, DEFEATED_PUA: SorryAboutMyFriends_Adaora_Visible_Script
    ]
    MAP_SCRIPT_ON_TRANSITION {
        call_if_set(FLAG_PENDING_DAYCARE_EGG,BreedingCenter_Script_SignifyEggReady)
        call(swagbag2_SetUp_Object_Script)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_CHASILLA_STATE, DEFEATED_PUA: SorryAboutMyFriends_CheckCutscene_Script
        FLAG_VISITED_CHASILLA, FALSE: Generic_Mappreview
    ]

    MAP_SCRIPT_ON_RETURN_TO_FIELD{
    }
}

script Chasilla_University_Locked_Door_Script{
    msgbox(format("The door is locked."),MSGBOX_SIGN)
    release
    end
}
