mapscripts Oroland_Warehouse_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
	{
		callnative(Script_WarehouseRave_IsRaveHappening)
		if (var(VAR_RESULT) == TRUE)
		{
			call(WarehouseRave_SetUpRave_Script)
		}
		call_if_ne(VAR_WAREHOUSE_RAVE_STATE,SAVE_KEIYING_WAREHOUSE,WarehouseRave_Hide_Keiying)
		call_if_eq(VAR_WAREHOUSE_RAVE_STATE,SAVE_KEIYING_WAREHOUSE,WarehouseRave_MoveObject_Script)
	}
    MAP_SCRIPT_ON_RESUME
    {
        call(WarehouseRave_ControlExits_Script)
    }
    MAP_SCRIPT_ON_LOAD
    {
        call(WarehouseRave_ControlExits_Script)
    }
}

