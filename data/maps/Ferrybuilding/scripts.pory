const PLAYER = OBJ_EVENT_ID_PLAYER

mapscripts Ferrybuilding_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION
    {
        call_if_lt(VAR_FERRYBUILDING_STATE,CHIEF_LEFT_WAR_ROOM,SurvivalChance333_HideObject_Script)
        call_if_gt(VAR_FERRYBUILDING_STATE,SAVE_SURVIVAL_CHANCE_BATTLE,SurvivalChance333_HideObject_Script)
    }

    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_FERRYBUILDING_STATE, CHIEF_LEFT_WAR_ROOM: SurvivalChance333_ExplainPlan_Dialogue
    ]
}

script Ferrybuilding_InteractFerryAttendant_Script
{
    if (var(VAR_FERRY_STATE) < FERRY_HALAI_ISLAND_AVAILABLE)
    {
        msgbox(format("Unfortunately, the ferry is currently out of order. Please come back later."),MSGBOX_NPC)
        release
        end
    }
    goto(Ferry_Interact_Dialogue)
}
