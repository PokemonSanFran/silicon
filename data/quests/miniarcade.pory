script BattleArcadeMiniQuest_Script_StartQuest
{
    msgbox(format("This is a placeholder dialogue, but this guy is needed for another quest."))
	closemessage
	completequest(QUEST_BATTLEARCADEMINIQUEST)
	release
	end
}

script BattleArcadeMiniQuest_Script_Complete
{
    msgbox(format("This is placeholder dialogue. This guy isn't needed until Restore Zenzu Island starts."))
	closemessage
	release
	end
}
