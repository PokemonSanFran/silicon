script WallaceArmy_Script_HideWallacearmytidememberA
{
    setobjectflagfromlocalid(LOCALID_WALLACEARMYTIDEMEMBERA)
}

script WallaceArmy_Script_InteractWallacearmytidememberA
{
    lock
    faceplayer
    goto_if_quest_active(QUEST_WALLACEARMY,WallaceArmy_Dialogue_QuestActive)
    goto_if_quest_inactive(QUEST_WALLACEARMY,WallaceArmy_Dialogue_QuestInactive)
    goto_if_quest_reward(QUEST_WALLACEARMY,WallaceArmy_Dialogue_QuestReward)
    goto_if_quest_complete(QUEST_WALLACEARMY,WallaceArmy_Dialogue_QuestComplete)
}

script WallaceArmy_Script_HideStanB
{
    setobjectflagfromlocalid(LOCALID_ROUTE1_WALLACEARMYSTANB)
}
script WallaceArmy_Script_HideStanC
{
    setobjectflagfromlocalid(LOCALID_ROUTE99_WALLACEARMYSTANC)
}
script WallaceArmy_Script_HideStanD
{
    setobjectflagfromlocalid(LOCALID_ROUTE9_WALLACEARMYSTAND)
}
script WallaceArmy_Script_HideStanE
{
    setobjectflagfromlocalid(LOCALID_TORGEOTCLIMB_WALLACEARMYSTANE)
}
script WallaceArmy_Script_HideStanF
{
    setobjectflagfromlocalid(LOCALID_NAVALBASE_WALLACEARMYSTANF)
}

script WallaceArmy_Dialogue_QuestActive
{
    callnative(WallaceArmy_OnlyOneStanRemains)
    if (var(VAR_RESULT) == TRUE)
    {
        msgbox(format("I’ve never seen any of these terminally online sorts actually have the guts to call anybody out in person, but this one might just be crazy enough to be legit."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
        msgbox(format("It sure is a sight to behold, huh? Hahahaha. Good luck in your battle with the final boss of the insane Wallace fandom."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
        msgbox(format("If you can convince them to calm down, I should think the whole “Wallace Army” will too."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    }
    else
    {
        msgbox(format("The hate’s still flowing in! Have you been able to reason with any of these people yet?"),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    }
    closemessage
    release
    end
}

script WallaceArmy_Dialogue_QuestInactive
{
    msgbox(format("I never thought we of all people would draw the ire of superfans..."),,SPEAKER_WALLACEARMYTIDEMEMBERA,TAIL_WHISPER)
    msgbox(format("Hey! Ever heard of the famous idol, Wallace?"),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("I think I have in passing… Aren’t they from Hoenn?"),,SPEAKER_PLAYER)
    msgbox(format("Yep! He’s a Gym Leader & Coordinator who’s slowly risen in fame over the past 20 years."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("He was gonna be performing at the Sharprise Arena during his current tour, but then after tickets went on sale the tour date suddenly vanished."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("Sharprise is saying on Buzzr that he cancelled due to safety concerns after The Tide said they were gonna be staging a massive protest there on the day."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("So naturally his fans went into a frenzy and started harassing us all. We’ve been threatened, doxx’ed, everything."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("But look at this DM one of our we got from Wallace himself. I'll forward it to you."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    showzap(ZAP_QUEST_WALLACEARMY_DM)
    msgbox(format("He canceled to show solidarity with us."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("Haha, wow. Stand-up guy!"),,SPEAKER_PLAYER)
    msgbox(format("Do you think you could find these people and settle them down? Actually talking is the best cure for Buzzr fingers, I find."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    startquest(QUEST_WALLACEARMY)
    cueobjectplayer(LOCALID_WALLACEARMYTIDEMEMBERA)
    msgbox(format("My hope is that a little human interaction will get some of these people to chill out."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("I think I’ve isolated all but one of the signals, and added them to your ToDo List."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("Follow up on the four known signals, then get back to me, okay?"),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    release
    end
}

script WallaceArmy_Dialogue_QuestReward
{
    checkitemspace(ITEM_QUEST_WALLACEARMY_REWARD,1)
    goto_if_eq(VAR_RESULT,TRUE,WallaceArmy_Script_GiveReward)
    msgbox(format("At last, the onslaught is over."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("Empty your bag real quick and then grab me again, okay?"),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    release
    end
}

script WallaceArmy_Script_GiveReward
{
    msgbox(format(" Thanks so much for your help, {PLAYER}."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("At last, the onslaught is over. WallacearmystanF got the rest of the fans to listen to reason."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("This is the best I can do for you. Hope you find it satisfactory."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    cueobjectplayer(LOCALID_WALLACEARMYTIDEMEMBERA)
    giveitem(ITEM_QUEST_WALLACEARMY_REWARD,1)
    completequest(QUEST_WALLACEARMY)
    release
    end
}

script WallaceArmy_Dialogue_QuestComplete
{
    msgbox(format("I think a nice, long social media break is in order."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    msgbox(format("I’m happy that The Tide is a collective. We always know to come together."),,SPEAKER_WALLACEARMYTIDEMEMBERA)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Battle_WallacearmystanB
{
    msgbox(format("I CAN NOT BELIEVE that Wallace’s show was canceled because of the stupid Tide!"),,SPEAKER_WALLACEARMYSTANB)
    msgbox(format("Wait, I think I recognize you! You’re one of them!"),,SPEAKER_WALLACEARMYSTANB)
    msgbox(format("You helped scare Wallace off! I’ll never forgive you!"),,SPEAKER_WALLACEARMYSTANB)
    closemessage
    trainerbattle_no_intro(TRAINER_QUEST_WALLACEARMY_STANB,format("AHHHHH! One Wallace Army Opp DOWNED!"))
    subquestmenu(QUEST_MENU_COMPLETE_QUEST,QUEST_WALLACEARMY,SUB_QUEST_1)
    msgbox(format("It’s not fair!! Why did The Tide have to take Wallace away from me?"),,SPEAKER_WALLACEARMYSTANB)
    msgbox(format("Okay, firstly, The Tide didn’t take him away…"),,SPEAKER_PLAYER)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("That makes sense I guess… I knew Wallace would be on the right side of things!"),,SPEAKER_WALLACEARMYSTANB)
    msgbox(format("I’ll just have to buy a ticket in another region and see him there… but I was gonna do that anyways! Heh…"),,SPEAKER_WALLACEARMYSTANB)
    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {
        msgbox(format("I wish there was a way to get back at Sharprise for their crimes…"),,SPEAKER_WALLACEARMYSTANB)
        buffermapname(STR_VAR_1,MAP_SHARPRISE_SPIRE_TOP)
        msgbox(format("Hmm… What if we could get a floorplan for {STR_VAR_1}?..."),,SPEAKER_WALLACEARMYSTANB)
    }
    closemessage
    moveobjecttocoords(LOCALID_ROUTE1_WALLACEARMYSTANB,25, 16,DIR_NORTH)
    delay(24)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_ROUTE1_WALLACEARMYSTANB)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    call(Quest_WallaceArmy_Script_TrySendLastZap)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Battle_WallacearmystanC
{
    msgbox(format("I won’t stop until all of Resido - no, the world knows that The Tide is a terrorist organisation!! They must be stopped!"),,SPEAKER_WALLACEARMYSTANC)
    msgbox(format("Are you a fan of Wallace by any chance?... Because you should know that it’s not The Tide’s fault that the show got canceled."),,SPEAKER_PLAYER)
    msgbox(format("BETRAYER!!! You’re working for them! You are the enemy!"),,SPEAKER_WALLACEARMYSTANC)
    closemessage
    trainerbattle_no_intro(TRAINER_QUEST_WALLACEARMY_STANC,format("And what else are you gonna take from me now? Huh!?"))
    subquestmenu(QUEST_MENU_COMPLETE_QUEST,QUEST_WALLACEARMY,SUB_QUEST_2)
    msgbox(format("Listen to me, The Tide has no interest in stopping Wallace from performing…"),,SPEAKER_PLAYER)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("I didn’t realise Sharprise was mistreating their workers like that… It looks like Wallace made the right call."),,SPEAKER_WALLACEARMYSTANC)
    msgbox(format("I’m gonna show solidarity by buying more Wallace merch! Which, I mean, I was already planning to do of course! Duh!"),,SPEAKER_WALLACEARMYSTANC)
    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {
    msgbox(format("I wish there was a way to get back at Sharprise for their crimes…"),,SPEAKER_WALLACEARMYSTANC)
        buffermapname(STR_VAR_1,MAP_SHARPRISE_SPIRE_TOP)
    msgbox(format("What if we get a list of the staff who work at {STR_VAR_1}?..."),,SPEAKER_WALLACEARMYSTANC)
    }
    closemessage
    moveobjecttocoords(LOCALID_ROUTE99_WALLACEARMYSTANC,6, 0,DIR_NORTH)
    delay(24)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_ROUTE99_WALLACEARMYSTANC)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    call(Quest_WallaceArmy_Script_TrySendLastZap)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Battle_WallacearmystanD
{
    msgbox(format("I can’t believe The Tide forced Wallace to cancel!"),,SPEAKER_WALLACEARMYSTAND)
    msgbox(format("The police wanna know who their leader, that Vigrim, is! I do too!"),,SPEAKER_WALLACEARMYSTAND)
    msgbox(format("Vigrim had nothing to do with it."),,SPEAKER_PLAYER)
    msgbox(format("You’re working with The Tide! You can’t be trusted!"),,SPEAKER_WALLACEARMYSTAND)
    closemessage
    trainerbattle_no_intro(TRAINER_QUEST_WALLACEARMY_STAND,format("Woman down! Woman down! I surrender!"))
    subquestmenu(QUEST_MENU_COMPLETE_QUEST,QUEST_WALLACEARMY,SUB_QUEST_3)
    msgbox(format("Okay… I’ll promise not to look into this Vigrim person if you promise not to hurt me…"),,SPEAKER_WALLACEARMYSTAND)
    msgbox(format("I’m not here to hurt anybody, I just want to talk."),,SPEAKER_PLAYER)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
msgbox(format("Hmm. I never guess I never thought about how our silly online messages could actually be causing people distress."),,SPEAKER_WALLACEARMYSTAND)
msgbox(format("I’ll take down the ones that reveal any personal information."),,SPEAKER_WALLACEARMYSTAND)
msgbox(format("To be honest I’m… Shocked you’d ever post such a thing in the first place."),,SPEAKER_PLAYER)
msgbox(format("Well from here on out I’m gonna double down on positivity online with more fancams! Which totally was not in my plans already!"),,SPEAKER_WALLACEARMYSTAND)
    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {

        buffermapname(STR_VAR_1,MAP_SHARPRISE_SPIRE_TOP)
    msgbox(format("We need to get Sharprise back for their crimes!"),,SPEAKER_WALLACEARMYSTAND)
    msgbox(format("What if we got a hold of the {STR_VAR_1} security schedule?..."),,SPEAKER_WALLACEARMYSTAND)
    }
    closemessage
    moveobjecttocoords(LOCALID_ROUTE9_WALLACEARMYSTAND,19, 2,DIR_NORTH)
    delay(24)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_ROUTE9_WALLACEARMYSTAND)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    call(Quest_WallaceArmy_Script_TrySendLastZap)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Battle_WallacearmystanE
{
msgbox(format("GAHHHHH! Wallace’s show was canceled!?!? Can nothing go right in this world!? GAHHHHH!"),,SPEAKER_WALLACEARMYSTANE,TAIL_SHOUT,EMOTE_ANGRY)
msgbox(format("I wonder if The Tide are working with other idols to ensure Wallace can’t succeed…"),,SPEAKER_WALLACEARMYSTANE,TAIL_WHISPER)
msgbox(format("The show’s cancellation was actually because of Sharprise."),,SPEAKER_PLAYER)
msgbox(format("You must be one of their agents! To the Wallace Army jail with you!"),,SPEAKER_WALLACEARMYSTANE,,EMOTE_ANGRY)
    closemessage
    trainerbattle_no_intro(TRAINER_QUEST_WALLACEARMY_STANE,format("The Wallace Army’s enemies are numerous… And they are powerful."))
    subquestmenu(QUEST_MENU_COMPLETE_QUEST,QUEST_WALLACEARMY,SUB_QUEST_4)
    msgbox(format("So? Which of the idols is The Tide working with after all?"),,SPEAKER_WALLACEARMYSTANE)
    msgbox(format("None of them - you’ve got the situation all wrong."),,SPEAKER_PLAYER)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("I’ve been weaponized by a corporation! Happens to everyone I guess."),,SPEAKER_WALLACEARMYSTANE)
    msgbox(format("Our countermeasure is simple! We recruit more members of the Fantina Fam to our cause! Then the Wallace Army will be utterly unstoppable!"),,SPEAKER_WALLACEARMYSTANE)
    msgbox(format("Are more rabid fans really the answer?"),,SPEAKER_PLAYER,TAIL_THOUGHT)
    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {
        buffermapname(STR_VAR_1,MAP_SHARPRISE_SPIRE_TOP)
    msgbox(format("There has to be a way to pay Sharprise back for their grave transgressions!"),,SPEAKER_WALLACEARMYSTANE)
    msgbox(format("How about finding out where the cameras are in {STR_VAR_1}?..."),,SPEAKER_WALLACEARMYSTANE)
    }
    closemessage
    moveobjecttocoords(LOCALID_TORGEOTCLIMB_WALLACEARMYSTANE,20,0,DIR_NORTH)
    delay(24)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_TORGEOTCLIMB_WALLACEARMYSTANE)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    call(Quest_WallaceArmy_Script_TrySendLastZap)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Script_TrySendLastZap
{
    callnative(Script_WallaceArmy_OnlyOneStanRemains)
    if (var(VAR_RESULT) == FALSE)
    {
        return
    }
    playse(SE_POKENAV_CALL)
    msgbox(format("Hmm, Wallacearmytidemembera forwarded me another message..."),,SPEAKER_PLAYER,TAIL_THOUGHT)
    showzap(ZAP_QUEST_WALLACEARMY_FINAL_STAN)
    buffermapname(STR_VAR_1,MAP_QUEST_WALLACEARMY_STAN_F)
    setflag(FLAG_QUEST_WALLACEARMY_WALLACEARMYSTANF_READY)
    msgbox(format("Guess I have to go to the {STR_VAR_1}..."),,SPEAKER_PLAYER,TAIL_THOUGHT)
    closemessage
    release
    end
}

script Quest_WallaceArmy_Script_InteractWallacearmystanF
{
    lock
    faceplayer
    goto(Quest_WallaceArmy_Battle_Start)
}

script Quest_WallaceArmy_Intro_WallacearmystanF
{
    lock
    clearflag(FLAG_QUEST_WALLACEARMY_WALLACEARMYSTANF_READY)
    moveobjecttocoords(LOCALID_PLAYER,11,7,DIR_NORTH)
    waitmovement(LOCALID_PLAYER)
    clearobjectflagfromlocalid(LOCALID_NAVALBASE_WALLACEARMYSTANF)
    applymovement(LOCALID_PLAYER,moves(face_left, delay_16, face_right, delay_16, face_up, delay_16,face_left))
    waitmovement(LOCALID_PLAYER)
    msgbox(format("Maybe they’re not coming after all?..."),,SPEAKER_PLAYER,TAIL_THOUGHT)
    msgbox(format("The Wallace Army will never submit to terrorists! If Wallace has only one fan, it is me! If Wallace has no fans, I am dead!"),,SPEAKER_WALLACEARMYSTANF)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    addobject(LOCALID_NAVALBASE_WALLACEARMYSTANF)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("If the world is against Wallace, then I am against the world!"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("Well, hello there. I am WallacearmystanF."),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("..."),,SPEAKER_PLAYER)
    msgbox(format("You must be The Tide’s lapdog!"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("Did you clear everybody out when you learned I was coming?"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("Actually the police raided this place a while ago."),,SPEAKER_PLAYER)
    msgbox(format("Good! I hope the police take this whole organization down."),,SPEAKER_WALLACEARMYSTANF)
    closemessage
    startmenu_savescreen
    goto(Quest_WallaceArmy_Battle_Start)
}

script Quest_WallaceArmy_Battle_Start
{
    msgbox(format("Now I will show you the real power of my love for Wallace!"),,SPEAKER_WALLACEARMYSTANF)
    closemessage
    trainerbattle_no_intro(TRAINER_QUEST_WALLACEARMY_STANF,format("But I’m his strongest soldier! How did I lose?"))
    subquestmenu(QUEST_MENU_COMPLETE_QUEST,QUEST_WALLACEARMY,SUB_QUEST_5)
    callnative(Quest_WallaceArmy_CountRemainingSubquestsTryProgressReward)

    msgbox(format("Wallace lets me ignore the realities of the world."),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("I don’t understand why The Tide wants to take that away."),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("The people being mistreated by Sharprise don’t have the luxury of ignoring reality."),,SPEAKER_PLAYER)
    msgbox(format("Neither The Tide OR Wallace want to let Sharprise get away with such things."),,SPEAKER_PLAYER)
    msgbox(format("What do you mean by “mistreated”?"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("Let me explain…"),,SPEAKER_PLAYER)
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("Clearly I… Misunderstood the situation."),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("I’ll redirect the fire toward Sharprise, the true enemy!"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("I’m not sure that Sharprise will suffer as much as The Tide did."),,SPEAKER_PLAYER)
    msgbox(format("Hmm… I’ve really made a mess of it… I’m sorry. Please tell The Tide I’m sorry."),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("I need to go back and watch some videos from 2002. Cleanse my palette."),,SPEAKER_WALLACEARMYSTANF)

    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {
        msgbox(format("Sharprise has to pay for their crimes."),,SPEAKER_WALLACEARMYSTANF)
            msgbox(format("I will rally the Wallace Army, Sootopolis Squad and all! They will face consequences!"),,SPEAKER_WALLACEARMYSTANF)
    }
closemessage
    moveobjecttocoords(LOCALID_NAVALBASE_WALLACEARMYSTANF,1, 1,DIR_NORTH)
    delay(24)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_NAVALBASE_WALLACEARMYSTANF)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    closemessage
    release
    end
}
script WallaceArmy_TryScript_HideRaidParty
{
    callnative(Script_HasSharpriseRaidStarted)
    if (var(VAR_RESULT) == TRUE)
    {
        return
    }

    callnative(Script_HasSharpriseRaidCompleted)
    if (var(VAR_RESULT) == FALSE)
    {
        return
    }
    call(WallaceArmy_Script_HideRaidParty)
}

script WallaceArmy_Script_HideRaidParty
{
    setobjectflagfromlocalid(LOCALID_SHARPRISE_GIFT_SHOP_WALLACEARMYSTANB)
}

