}
script SharpriseRaid_Dialogue_WallacearmystanF
{
    lock
    faceplayer
    msgbox(format("Ha! If I knew I’d see you again if I just waited here for a bit!"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("I was tempted to climb all the way up and take on the rest of Sharprise myself!"),,SPEAKER_WALLACEARMYSTANF)
    msgbox(format("But I know this is your fight. So make the Wallace Army proud!"),,SPEAKER_WALLACEARMYSTANF)
