{
    lock
    faceplayer
    msgbox(format("Heh, you must be surprised to see me here!"),,SPEAKER_WALLACEARMYSTANB)
    msgbox(format("Well, you should know that the Wallace Army can do anything it sets its mind to!"),,SPEAKER_WALLACEARMYSTANB)
    closemessage
    release
    end
}
