{
    lock
    faceplayer
    msgbox(format("The Wallace Army vowed to have revenge against Sharprise!"),,SPEAKER_WALLACEARMYSTANC)
    msgbox(format("I heard about the raid because… Well, I have my methods."),,SPEAKER_WALLACEARMYSTANC)
    closemessage
    release
    end
}
