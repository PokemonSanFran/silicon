    end
}
script SharpriseRaid_Dialogue_WallacearmystanE
{
    lock
    faceplayer
    msgbox(format("The trainers guarding the gift shop were surprisingly easy to beat!"),,SPEAKER_WALLACEARMYSTANE)
    msgbox(format("Granted, WallacearmystanF did most of the fighting."),,SPEAKER_WALLACEARMYSTANE)
