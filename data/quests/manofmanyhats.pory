const FLAG_HIDE_INSTALLNATUREPROBESWORKER = FLAG_TEMP_A
const FLAG_UNLOCK_DOOR = FLAG_TEMP_2
const INSTALLNATUREPROBESWORKER_WAITER = LOCALID_QIU_VILLAGE_RESTAURANT_INSTALLNATUREPROBESWORKER
const INSTALLNATUREPROBESWORKER_FISHERMAN = LOCALID_POPIDORA_ARCADE_INSTALLNATUREPROBESWORKER
const INSTALLNATUREPROBESWORKER_ATTENDANT = LOCALID_LAKE_WAJABI_INSTALLNATUREPROBESWORKER
const INSTALLNATUREPROBESWORKER_INTERACT = VAR_LAST_TALKED
const TOOK_STATION_ITEM1 = FLAG_ITEM_QUEST_MANOFMANYHATS_ITEM1
const TOOK_STATION_ITEM2 = FLAG_ITEM_QUEST_MANOFMANYHATS_ITEM2

//Quest_ManOfManyHats_

script Quest_ManOfManyHats_Installnatureprobesworker_Waiter_Visibility_Script
{
    call_if_quest_not_complete(QUEST_INSTALLNATUREPROBES,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Boba)
    questmenu(QUEST_MENU_CHECK_INACTIVE,QUEST_MANOFMANYHATS)
    if (var(VAR_RESULT) == TRUE)
    {
        return
    }
    callnative(Script_Quest_ManOfManyHats_ShouldStayBoba)
    call_if_eq(VAR_RESULT,FALSE,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Boba)
}

script Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Boba
{
    setobjectflagfromlocalid(INSTALLNATUREPROBESWORKER_WAITER)
}

script Quest_ManOfManyHats_Installnatureprobesworker_Fisherman_Visibility_Script
{
    call_if_quest_not_complete(QUEST_INSTALLNATUREPROBES,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Fish)
    questmenu(QUEST_MENU_CHECK_INACTIVE,QUEST_MANOFMANYHATS)
    if (var(VAR_RESULT) == TRUE)
    {
        return
    }
    callnative(Script_Quest_ManOfManyHats_ShouldStayFish)
    call_if_eq(VAR_RESULT,FALSE,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Fish)
}

script Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Fish
{
    setobjectflagfromlocalid(INSTALLNATUREPROBESWORKER_FISHERMAN)
}

script Quest_ManOfManyHats_Installnatureprobesworker_Attendant_Visibility_Script
{
    call_if_quest_not_complete(QUEST_INSTALLNATUREPROBES,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Arcade)
    questmenu(QUEST_MENU_CHECK_INACTIVE,QUEST_MANOFMANYHATS)
    if (var(VAR_RESULT) == TRUE)
    {
        return
    }
    callnative(Script_Quest_ManOfManyHats_ShouldStayArcade)
    call_if_eq(VAR_RESULT,FALSE,Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Arcade)
}

script Quest_ManOfManyHats_Script_HideInstallNatureProbesWorker_Arcade
{
    setobjectflagfromlocalid(INSTALLNATUREPROBESWORKER_ATTENDANT)
}


script Quest_ManOfManyHats_Installnatureprobesworker_Waiter_Dialogue{
	call(Quest_ManOfManyHats_Installnatureprobesworker_Interact_Script)
	callnative(Quest_ManOfManyHats_ManOfManyHatsIncrementBoba)
	msgbox("A “20% sweetness” boba order?{PAUSE 30} You must\nbe joking! {PAUSE 30}The machine only has buttons\nfor 10 or 30%!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_SWEAT)	
	callnative(Quest_ManOfManyHats_ManOfManyHatsSetThirdJobVisible)
	goto_if_eq(VAR_RESULT,TRUE,Quest_ManOfManyHats_StartQuest_Dialogue)
    closemessage
    release
    end
}

script Quest_ManOfManyHats_Installnatureprobesworker_Fisherman_Dialogue{
	call(Quest_ManOfManyHats_Installnatureprobesworker_Interact_Script)
	callnative(Quest_ManOfManyHats_ManOfManyHatsIncrementFish)
	msgbox("Is this too tangled…?{PAUSE 30} No, surely it's not.\nBut, it looks so{PAUSE 30}.{PAUSE 30}.{PAUSE 30}.{PAUSE 60}Gah!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_SWEAT)
	callnative(Quest_ManOfManyHats_ManOfManyHatsSetThirdJobVisible)
	goto_if_eq(VAR_RESULT,TRUE,Quest_ManOfManyHats_StartQuest_Dialogue)
    closemessage
    release
    end
}

script Quest_ManOfManyHats_Installnatureprobesworker_ArcadeAttendant_Dialogue{
	call(Quest_ManOfManyHats_Installnatureprobesworker_Interact_Script)
	callnative(Quest_ManOfManyHats_ManOfManyHatsIncrementArcade)
	msgbox("Ugh! The buttons on this thing are all\ncovered in butter! How does that even\nhappen?\pAnd more importantly… How am I gonna\nclean all this?",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_SWEAT)
	callnative(Quest_ManOfManyHats_ManOfManyHatsSetThirdJobVisible)
	goto_if_eq(VAR_RESULT,TRUE,Quest_ManOfManyHats_StartQuest_Dialogue)
    closemessage
    release
    end
}

script Quest_ManOfManyHats_Installnatureprobesworker_Interact_Script{
	lock
	goto_if_quest_reward(QUEST_MANOFMANYHATS,Quest_ManOfManyHats_Reward_Dialogue)
	goto_if_quest_active(QUEST_MANOFMANYHATS,Quest_ManOfManyHats_Active_Dialogue)
	goto_if_quest_complete(QUEST_MANOFMANYHATS,Quest_ManOfManyHats_Complete_Dialogue)
	return
}

script Quest_ManOfManyHats_StartQuest_Dialogue{
	playse(SE_PIN)
	applymovement(INSTALLNATUREPROBESWORKER_INTERACT, moves(emote_exclamation_mark, delay_16, face_player, step_end))
	waitse
	lock
	msgbox("It's you. I remember you.",MSGBOX_NPC,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	msgbox("To this day I'm thankful for your help.\nAnd don't worry, I don't blame you for how\nthings went down.",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_SWEAT)
	closemessage
	applymovement(INSTALLNATUREPROBESWORKER_INTERACT,Common_Movement_FaceLeft)
	msgbox("…Things have of course been rough. I've\nbeen working multiple jobs to pay the\nbills.",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_SWEAT)
	waitmovement(INSTALLNATUREPROBESWORKER_INTERACT)
	closemessage
	msgbox("Yeah, I feel like I've seen you all over\nthe place.",,SPEAKER_PLAYER,TAIL_TALK,EMOTE_SWEAT)
	msgbox("I miss my ranger job…",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	closemessage
	applymovement(INSTALLNATUREPROBESWORKER_INTERACT,Common_Movement_FacePlayer)
	waitmovement(INSTALLNATUREPROBESWORKER_INTERACT)
	buffermapname(STR_VAR_1,MAP_QUEST_MANOFMANYHATS_TARGET)
	msgbox("Worst part is? I left my favorite head-\nphones back at the ranger station on\n{STR_VAR_1}.\pI can't even wile the time away\nwith some music.",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_ANGRY)
	checkitem(ITEM_QUEST_MANOFMANYHATS_HEADPHONES, 1)
	goto_if_eq(VAR_RESULT,TRUE,Quest_ManOfManyHats_RewardPreActive_Dialogue)
	msgbox("I'd go get them if I could, but I'm too\nbusy and don't have the time.",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	msgbox("I don't suppose I could ask you for yet\nanother favor? Do you think you could\nretrieve my headphones from the ranger\lstation on {STR_VAR_1}?",,SPEAKER_INSTALLNATUREPROBESWORKER)
	msgbox("Of course. It's the least I can do.",,SPEAKER_PLAYER,TAIL_TALK)
	msgbox("Oh, please. You shouldn't blame yourself.\nT'was the ever-uncaring nature of the\npowers that be!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	msgbox("Anyway, the door code is “J4CKW41K3r”.\nGood luck!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_HAPPY)
	startquest(QUEST_MANOFMANYHATS)
}

script Quest_ManOfManyHats_RewardPreActive_Dialogue
{
	msgbox("Lucky for you, I already have them!",,SPEAKER_PLAYER,TAIL_TALK)
	closemessage
	cueobjecttalking(LOCALID_PLAYER)
	removeitem(ITEM_QUEST_MANOFMANYHATS_HEADPHONES,1)
	msgbox("O-oh? Really? How is that even possible?",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	msgbox("Well, these'll be a big help for me!\nIn terms of morale, at least. Thank you\nonce again!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
	applymovement(INSTALLNATUREPROBESWORKER_INTERACT,Common_Movement_FaceLeft)
	completequest(QUEST_MANOFMANYHATS)

}

script Quest_ManOfManyHats_Active_Dialogue{
   lock
   faceplayer
   msgbox("Have you found my trusty headphones\nyet?",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
   msgbox("With nothing to listen to I'm left alone\nwith my own thoughts. And let me tell you,\nmy thoughts aren't very fun!",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)
   applymovement(INSTALLNATUREPROBESWORKER_INTERACT, moves(face_original_direction, delay_16*2))
   waitmovement(0)
   closemessage
   release
   end
}

script Quest_ManOfManyHats_Reward_Dialogue{
	msgbox("Hey, I got your headphones back!",,SPEAKER_PLAYER,TAIL_TALK)
	cueobjecttalking(LOCALID_PLAYER)
	msgbox("Wowza! This is the most exciting day I've\nhad all week!",MSGBOX_NPC,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK,EMOTE_HAPPY)

	msgbox("Y'know there were some other things at\nthe ranger station too. Do you want\nthem?",,SPEAKER_PLAYER,TAIL_TALK)
	msgbox("Nah. I know what you're talking about.\pThey were there before I was even hired\nand will probably be there forever if\nsomeone doesn't take them, so I say you\lshould have them.",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_TALK)

	applymovement(INSTALLNATUREPROBESWORKER_INTERACT,Common_Movement_FaceLeft)
	completequest(QUEST_MANOFMANYHATS)
	release
	end
}

script Quest_ManOfManyHats_Complete_Dialogue{
	random(3)
	callnative(Script_Quest_ManOfManyHats_SetForcedTextSpeedFastFlag)
	switch (var(VAR_RESULT)){
		case 0: msgbox("N{PAUSE 2}e{PAUSE 2}e{PAUSE 2}d{PAUSE 2}l{PAUSE 2}e{PAUSE 2}s{PAUSE 2}s {PAUSE 2}t{PAUSE 2}o {PAUSE 2}s{PAUSE 2}a{PAUSE 2}y,{PAUSE 30} I {PAUSE 15}keep {PAUSE 15}a {PAUSE 15}check, \n{PAUSE 30}She {PAUSE 8}was {PAUSE 8}a {PAUSE 15}bad-{PAUSE 15}bad, {PAUSE 30}never{PAUSE 15}the{PAUSE 15}less…\n{PAUSE 8}(Yeah!)",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_SHOUT)
		case 1: msgbox("O{PAUSE 8}o{PAUSE 8}h{PAUSE 8}-{PAUSE 8}o{PAUSE 8}o{PAUSE 8}h, {PAUSE 15}s{PAUSE 2}o{PAUSE 2}m{PAUSE 2}e {PAUSE 2}t{PAUSE 2}h{PAUSE 2}i{PAUSE 2}n{PAUSE 2}g{PAUSE 2}s {PAUSE 2}y{PAUSE 2}o{PAUSE 2}u {PAUSE 2}j{PAUSE 2}u{PAUSE 2}s{PAUSE 2}t {PAUSE 2}c{PAUSE 2}a{PAUSE 2}n't\nre{PAUSE 8}fu{PAUSE 8}u{PAUSE 8}u{PAUSE 8}u{PAUSE 8}u{PAUSE 8}u{PAUSE 2}s{PAUSE 2}e…\p{PAUSE 2}S{PAUSE 2}h{PAUSE 2}e {PAUSE 2}w{PAUSE 2}a{PAUSE 2}n{PAUSE 2}n{PAUSE 2}a {PAUSE 2}r{PAUSE 2}i{PAUSE 2}d{PAUSE 2}e {PAUSE 2}m{PAUSE 2}e {PAUSE 2}l{PAUSE 2}i{PAUSE 2}k{PAUSE 2}e {PAUSE 2}a {PAUSE 2}c{PAUSE 2}r{PAUSE 8}u{PAUSE 8}u{PAUSE 8}u{PAUSE 8}u{PAUSE 2}i{PAUSE 2}s{PAUSE 2}e {PAUSE 15}a{PAUSE 2}n{PAUSE 2}d\n{PAUSE 2}I'm n{PAUSE 8}o{PAUSE 8}o{PAUSE 8}o{PAUSE 8}o{PAUSE 8}ot {PAUSE 2}try{PAUSE 2}na lo{PAUSE 8}o{PAUSE 8}o{PAUSE 8}-ooh{PAUSE 8}-ooh{PAUSE 8}-ose…",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_SHOUT)
		case 2: msgbox("Then you're left in the dust,\n{PAUSE 60}Unless I stuck by ya.\n{PAUSE 60}You're the sunflower…\pI think your love would be too much…",,SPEAKER_INSTALLNATUREPROBESWORKER,TAIL_SHOUT)
	}
	callnative(Script_Quest_ManOfManyHats_ClearForcedTextSpeedFastFlag)
	msgbox("Those headphones must be noise\ncancelling...",,SPEAKER_PLAYER,TAIL_WHISPER,EMOTE_SWEAT)
	closemessage
	release
	end
}

script Quest_ManOfManyHats_GuessDoorCombination_Dialogue
{
	msgbox("It needs a password…",,SPEAKER_PLAYER,TAIL_THOUGHT)
	special(EnterCode)
    waitstate
    special(GetCodeFeedback)
	if(var(VAR_RESULT) == QUEST_MANOFMANYHATS)
	{
		callnative(Quest_ManOfManyHats_SetDoorUnlockBit)
		playse(SE_DING_DONG)
		waitse
		playse(SE_BANG)
		waitse
		setmetatile(13,8,0x248,FALSE)
		special(DrawWholeMapView)
		msgbox("That may be the most insane guess I have\never made in my life.",,SPEAKER_PLAYER,TAIL_THOUGHT)
		closemessage
		warpdoor(MAP_ESPULEE_OUTSKIRTS_RANGER,0)
		waitstate
		end
	}
	else
	{
		playse(SE_FAILURE)
		msgbox("Something tells me guessing isn't gonna\nget me anywhere.",,SPEAKER_PLAYER,TAIL_THOUGHT)
		end
	}
}

script Quest_ManOfManyHats_EnterDoorCombination_Dialogue{
	msgbox("Okay, INSTALLNATUREPROBESWORKER said the\ncombination was J4CKW41K3r{PAUSE 30}.{PAUSE 30}.{PAUSE 30}.",,SPEAKER_PLAYER,TAIL_THOUGHT)
	closemessage
	callnative(Quest_ManOfManyHats_SetDoorUnlockBit)
	playse(SE_DING_DONG)
	waitse
	playse(SE_BANG)
	waitse
	setmetatile(13,8,0x248,FALSE)
	special(DrawWholeMapView)
	warpdoor(MAP_ESPULEE_OUTSKIRTS_RANGER,0)
	waitstate
	end
}

script Quest_ManOfManyHats_CheckDoorLock_Script{
	callnative(Script_Quest_ManOfManyHats_GetDoorUnlockBit)
	if(var(VAR_RESULT)==TRUE){setflag(FLAG_UNLOCK_DOOR)}
}

