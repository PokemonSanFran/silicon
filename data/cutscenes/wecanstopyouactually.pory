const LOCALID_SHARPRISESPIRE_TOP_POLICE_A = (LOCALID_CAMERA + 1)
const LOCALID_SHARPRISESPIRE_TOP_POLICE_B = (LOCALID_CAMERA + 2)

script WeCanStopYouActually_FixPlayerPosition_Script {
    getplayerxy(VAR_TEMP_0,VAR_TEMP_1)

        if (var(VAR_TEMP_0) != 15 || (var(VAR_TEMP_1) != 6)){
            fadescreen(FADE_TO_BLACK)
                applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA,Common_Movement_FaceDown)
                waitmovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA)
                setobjectxy(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA,15,5)
                applymovement(LOCALID_PLAYER,Common_Movement_FaceUp)
                setobjectxy(LOCALID_PLAYER,15,6)
                TeleportCamera(15,6)
                fadescreen(FADE_FROM_BLACK)
        }
}

script WeCanStopYouActually_PostBattle_Dialogue {
    lock
        call(WeCanStopYouActually_FixPlayerPosition_Script)
        endcutscene

        msgbox(format("So, what’s your plan, beat me up and try to expose me? Nobody is going to believe the terrorists that stormed our office building. There's not even a paper trail - do you know how hard it was, not sending a SINGLE email about this? You’re all going to get arrested, the money will keep flowing in, and life is going to keep moving on."),,SPEAKER_LUCREZIA)

        msgbox(format("Lucrezia's phone is ringing."))

        msgbox(format("That’s the authorities, probably here to pick you up."),,SPEAKER_LUCREZIA)

        msgbox(format("…oh no."),,SPEAKER_LUCREZIA)

        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA, moves(walk_up, step_end))
        waitmovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA)
        playse(SE_PC_LOGIN)
        special(TurnOnTVScreen)
        delay(30)
        fadescreen(FADE_TO_BLACK)

        buffermapname(STR_VAR_1,MAP_HALAI_ISLAND)
        msgbox(format("I am Kei-Ying, the SharpRise Capital Chief Operating Officer. This is my confession. Two days ago, SharpRise Capital triggered a machine that is responsible for the devastating earthquake on {STR_VAR_1}. We did it to flush out and destroy …"),,SPEAKER_KEIYING)

        closemessage

        fadescreen(FADE_FROM_BLACK)

        msgbox(format("WHAT THE HELL ARE THEY DOING?"),,SPEAKER_LUCREZIA)

        playse(SE_POKENAV_CALL)
        waitse
        msgbox(format("Lucrezia's phone is ringing."))

        msgbox(format("FIND THEM! SHUT THAT DOWN!"),,SPEAKER_LUCREZIA)

        msgbox(format("I don’t care WHERE THEY ARE JUST END THIS SHIT! I thought they were MISSING! HOW DID THIS HAPPEN?"),,SPEAKER_LUCREZIA)

        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA, moves(walk_faster_left, walk_faster_right * 2, walk_faster_left * 2, walk_faster_right * 2, walk_faster_left * 2, walk_faster_right, face_down, step_end))
        waitmovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA)

        msgbox(format("YOU! They told you! That’s how you found out! And now if they confess… they don’t have to take it from you."),,SPEAKER_LUCREZIA)

        msgbox(format(" I - "),,SPEAKER_ALICIA)

        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA,Common_Movement_FaceLeft)

        msgbox(format("CHARLOTTE! RAMESH! SECURITY!"),,SPEAKER_LUCREZIA)

        msgbox(format("We already beat them. You’re alone."),,SPEAKER_ALICIA)

        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA,Common_Movement_FaceDown)
        waitmovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA)

        msgbox(format("…I’m not going to prison. I’m NOT GOING TO JAIL…"),,SPEAKER_LUCREZIA)
        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA,moves(walk_left, walk_down))
		applymovement(LOCALID_PLAYER,(moves(lock_facing_direction, walk_left, unlock_facing_direction)))
        waitmovement(LOCALID_SHARPRISESPIRE_TOP_LUCREZIA)

        msgbox(format("It's over, Lucrezia."),,SPEAKER_PLAYER)
        msgbox(format("You think you're going to stop me just because you defeated me in a battle?"),,SPEAKER_LUCREZIA,,EMOTE_CONFUSE)
		closemessage
        goto(WeCanStopYouActually_StartBossBattle_Script)
}

script WeCanStopYouActually_StartBossBattle_Script {
        setvar(VAR_TOWER_RAID_STATE,SAVE_LUCREZIA_SHARPRISESPIRE)
        msgbox(format("I'LL THROW YOU OUT OF THIS BUILDING MYSELF, FROM THE TOP FLOOR IF I HAVE TO!"),,SPEAKER_LUCREZIA,TAIL_SHOUT,EMOTE_ANGRY)
        closemessage

        trainerbattle_no_intro(TRAINER_LUCREZIA_B,format("Nonononononono…"))
        setvar(VAR_TOWER_RAID_STATE,DEFEATED_SECOND_LUCREZIA)
}

script WeCanStopYouActually_Arrest_Dialogue {
    lock
        startcutscene(JUMPPLAYER_WECANSTOPYOUACTUALLY)

        setvar(VAR_TOWER_RAID_STATE,DEFEATED_LUCREZIA_SHARPRISESPIRE)
        setvar(VAR_STORYLINE_STATE,STORY_EPILOGUE)

        spawnobject(OBJ_EVENT_GFX_MYSTERY_GIFT_MAN,LOCALID_SHARPRISESPIRE_TOP_POLICE_A,7,7,MOVEMENT_TYPE_FACE_RIGHT)
        spawnobject(OBJ_EVENT_GFX_MYSTERY_GIFT_MAN,LOCALID_SHARPRISESPIRE_TOP_POLICE_B,7,8,MOVEMENT_TYPE_FACE_RIGHT)

        msgbox(format("Lucrezia, you’re under arrest!"))
        closemessage

        applymovement(LOCALID_SHARPRISESPIRE_TOP_POLICE_A, moves(walk_right * 7, walk_up * 2, face_right, step_end))
        applymovement(LOCALID_SHARPRISESPIRE_TOP_POLICE_B, moves(walk_right * 9, walk_up * 3, face_left, step_end))
        applymovement(LOCALID_PLAYER, moves(walk_right * 2, face_left, step_end))

        waitmovement(LOCALID_SHARPRISESPIRE_TOP_POLICE_B)

        msgbox(format("For what? Using the tools YOUR BOSSES gave me? We’re all going down together! You’re all toast!"),,SPEAKER_LUCREZIA)

        closemessage
        endcutscene
        bypass_healblock
        setflag(FLAG_SPAWN_INVISIBLE)
        warpsilent(MAP_BLACK_MAP,0)
        waitstate
        release
        end
}

script WeCanActuallyStopYou_Script_GoToPerpWalk
{
    setflag(FLAG_SYS_GAME_CLEAR)
    setflag(FLAG_REMOVE_WARP_FADE_OUT)
    setflag(FLAG_SHOULD_SKIP_CREDITS)
    startmenu_savescreen
    warpsilent(MAP_WE_CAN_STOP_YOU_ACTUALLY_CUTSCENE,0)
    waitstate
    end
}

script WeCanStopYouActaully_ArrestCutscene {
        setflag(FLAG_DONT_TRANSITION_MUSIC)
        playbgm(MUS_SRC_GETTING_ARRESTED,FALSE)
        callnative(SetPostCreditsSceneWarpLocation)
        startcutscene(JUMPPLAYER_EPILOGUE)
        lockall

        applymovement(LOCALID_WECANSTOPYOUACTUALLY_COMRADE_A,WeCanStopYouActually_MarchRight)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_COMRADE_B,WeCanStopYouActually_MarchLeft)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_COMRADE_C,WeCanStopYouActually_MarchRight)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_ADAORA,WeCanStopYouActually_MarchLeft)
        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_ADAORA)
        applymovement(LOCALID_PLAYER, moves(walk_right, face_left, step_end))
        waitmovement(LOCALID_PLAYER)
        delay(8)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_POLICE_A)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_POLICE_A,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_OLIVER)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_OLIVER,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_LUCREZIA)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_LUCREZIA,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_CHARLOTTE)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_CHARLOTTE,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_RAMESH)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_RAMESH,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_POLICE_B)
        applymovement(LOCALID_WECANSTOPYOUACTUALLY_POLICE_B,WeCanStopYouActually_WalkOutOfBuilding)
        delay(16)

        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_POLICE_B)

        removeobject(LOCALID_WECANSTOPYOUACTUALLY_POLICE_A)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_OLIVER)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_LUCREZIA)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_CHARLOTTE)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_RAMESH)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_POLICE_B)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_ELEANOR)
        random(4)
        if (var(VAR_RESULT) == 1){
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_ELEANOR,WeCanStopYouActually_SalutePlayerHeart)
        }else {
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_ELEANOR,WeCanStopYouActually_SalutePlayer)
        }
    delay(32)
        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_ELEANOR)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_TALA)
        random(4)
        if (var(VAR_RESULT) == 1){
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_TALA,WeCanStopYouActually_SalutePlayerHeart)
        }else {
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_TALA,WeCanStopYouActually_SalutePlayer)
        }
    delay(32)
        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_TALA)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_MAGNUS)
        random(4)
        if (var(VAR_RESULT) == 1){
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_MAGNUS,WeCanStopYouActually_SalutePlayerHeart)
        }else {
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_MAGNUS,WeCanStopYouActually_SalutePlayer)
        }
    delay(32)
        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_MAGNUS)

        addobject(LOCALID_WECANSTOPYOUACTUALLY_FRANK)
        random(4)
        if (var(VAR_RESULT) == 1){
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_FRANK,WeCanStopYouActually_SalutePlayerHeart)
        }else {
            applymovement(LOCALID_WECANSTOPYOUACTUALLY_FRANK,WeCanStopYouActually_SalutePlayer)
        }
    delay(32)

        waitmovement(LOCALID_WECANSTOPYOUACTUALLY_FRANK)

        removeobject(LOCALID_WECANSTOPYOUACTUALLY_TALA)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_MAGNUS)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_FRANK)
        removeobject(LOCALID_WECANSTOPYOUACTUALLY_ELEANOR)

        applymovement(LOCALID_PLAYER,Common_Movement_FaceDown)
        waitmovement(0)

        fadeblackandsetremovewarpfadeflag
        msgbox(format("A few months later..."),MSGBOX_AUTOCLOSE)
        closemessage
        setflag(FLAG_SPAWN_INVISIBLE)
        warpsilent(MAP_ARANTRAZ,255,8,15)
        waitstate
        release
        end
}

movement WeCanStopYouActually_MarchLeft {
        walk_left * 2
        walk_right * 4
        delay_8
        face_up
        step_end
}
movement WeCanStopYouActually_MarchRight {
    walk_right * 2
        walk_left * 4
        delay_8
        face_up
        step_end
}

movement WeCanStopYouActually_WalkOutOfBuilding {
        walk_down * 4
        walk_right * 9
        step_end
}

movement WeCanStopYouActually_SalutePlayerHeart {
    walk_down
        face_right
        emote_heart
        delay_16 * 2
        walk_down * 3
        walk_right * 9
        step_end
}

movement WeCanStopYouActually_SalutePlayer{
    walk_down
        face_right
        delay_16 * 2
        walk_down * 3
        walk_right * 9
        step_end
}
