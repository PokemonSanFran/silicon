const LOCALID_SHARPRISE_STADIUM_ARENA_BAIYA = LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT
const LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA = (LOCALID_CAMERA + 1)

script WelcomeToTheHallOfFame_PostBattle_Dialogue {
    startcutscene(JUMPPLAYER_WELCOMETOTHEHALLOFFAME)
    msgbox(format("Resido! Your Champion! {PLAYER}!"))
        closemessage
        special(DoDomeConfetti)
        playse(SE_M_ENCORE2)
        call(BattleFrontier_BattleDomeBattleRoom_EventScript_AudienceLookAround)
        delay(60)

        spawnobject(OBJ_EVENT_GFX_LUCREZIA,LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA,17,9,MOVEMENT_TYPE_NONE)
        applymovement(LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA, moves(walk_left * 4, walk_up * 3, walk_left * 6, step_end))
        applymovement(LOCALID_SHARPRISE_STADIUM_ARENA_BAIYA, moves(walk_right, walk_up, face_down, step_end))
        waitmovement(LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA)

        msgbox(format("To the hundreds of you, here, in the stands. To the millions of you, watching from all over the world.  To all the fans. We say “Thank you, from the bottom of our hearts”. This first season was absolutely a success, and we can't wait to do it again. "),,SPEAKER_LUCREZIA)

        closemessage

        playse(SE_M_ENCORE2)
        call(BattleFrontier_BattleDomeBattleRoom_EventScript_AudienceLookAround)
        fadescreen(FADE_TO_BLACK)
        setobjectxy(LOCALID_PLAYER,9,6)
        setobjectxy(LOCALID_SHARPRISE_STADIUM_ARENA_BAIYA,8,7)
        setobjectxy(LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA,7,7)
        turnobject(LOCALID_SHARPRISE_STADIUM_ARENA_BAIYA,DIR_SOUTH)
        turnobject(LOCALID_SHARPRISE_STADIUM_ARENA_LUCREZIA,DIR_SOUTH)
        turnobject(LOCALID_PLAYER,DIR_SOUTH)
        TeleportCamera(9,6)
        fadescreen(FADE_FROM_BLACK)

        msgbox(format("And now, let's create history together. I am proud to present the first inductee to the SharpRise Capital Hall of Fame. Resido's Champion: {PLAYER}."),,SPEAKER_LUCREZIA)

        closemessage

        setvar(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE,NO_TOURNAMENT)
        clearflag(FLAG_SHARPRISESTADIUM_TOURNAMENT_HAPPENING)
        setvar(VAR_STORYLINE_STATE,STORY_WON_FINALS)
        setflag(FLAG_IS_RESIDO_CHAMPION)
		callnative(AwardPartyMonChampionRibbon)
        fadescreenspeed(FADE_TO_BLACK,24)

        bypass_healblock
        call(WelcometotheHallofFame_GameClear_Script)
        waitstate
        endcutscene
        releaseall
        end
}

script WelcometotheHallofFame_GameClear_Script{
    special(GameClear)
        return
}

