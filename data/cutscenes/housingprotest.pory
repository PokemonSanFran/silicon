script HousingProtest_StartChanting_Dialogue
{
    locktarget
    msgbox(format("Hey you! Rich and rude! We don't like your attitude!"),,SPEAKER_PROTEST_A,TAIL_SHOUT,EMOTE_ANGRY)
    applymovement(PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    msgbox(format("Hey you! You're no good! Treat the people like you should!"),,SPEAKER_PROTEST_B,TAIL_SHOUT,EMOTE_ANGRY)
    applymovement(PLAYER, Common_Movement_FaceDown)
    waitmovement(0)
    msgbox(format("Why is everybody so angry?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        msgbox(format("We aren't going to stand for this any longer!"),,SPEAKER_PROTEST_B,TAIL_SHOUT,EMOTE_ANGRY)
    msgbox(format("You can't keep pushing us out!"),,SPEAKER_PROTEST_C,TAIL_SHOUT,EMOTE_ANGRY)
    msgbox(format("We deserve to live here too!"),,SPEAKER_PROTEST_D,TAIL_SHOUT,EMOTE_ANGRY)
    closemessage
    goto(HousingProtest_LandlordWalkOutside_Script)
}

script HousingProtest_MovePlayerIntoPosition
{
    if (var(VAR_ROUTE99_STATE) == PROTEST_NOTSTARTED)
    {
        goto(HousingProtest_MovePlayerToProtest)
    }
    elif (var(VAR_ROUTE99_STATE) == SAVE_THE_TIDE_ROUTE99)
    {
       goto(HousingProtest_MovePlayerToBattle)
    }
    else
    {
        return
    }
}

script HousingProtest_MovePlayerToProtest
{
    applymovement(PLAYER,Common_Movement_WalkUp)
    fadescreenswapbuffers(FADE_TO_BLACK)
    waitmovement(PLAYER)
    setobjectxy(PLAYER,5,18)
    turnobject(PLAYER,DIR_EAST)
    TeleportCamera(5,18)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(HousingProtest_StartChanting_Dialogue)
}

script HousingProtest_MovePlayerToBattle
{
    applymovement(PLAYER,Common_Movement_WalkUp)
    fadescreenswapbuffers(FADE_TO_BLACK)
    waitmovement(PLAYER)
    setobjectxy(PLAYER,2,18)
    turnobject(PLAYER,DIR_SOUTH)
    TeleportCamera(2,18)
    fadescreenswapbuffers(FADE_FROM_BLACK)
}

script HousingProtest_LandlordWalkOutside_Script {
    opendoor(2, 17)
    waitdooranim
    applymovement(PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    clearobjectflagfromlocalid(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD)
    addobject(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, Common_Movement_WalkDown)
    waitmovement(0)
    closedoor(2, 17)
    waitdooranim
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, Common_Movement_LookAround)
    waitmovement(0)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, Common_Movement_FaceDown)
    waitmovement(0)
    goto(HousingProtest_LandlordTalkToCrowd_Dialogue)
}

script HousingProtest_LandlordTalkToCrowd_Dialogue {
    msgbox(format("I'm sure we can come to some understanding here, please..."),,SPEAKER_LANDLORD)
    closemessage
    clearobjectflagfromlocalid(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A)
    clearobjectflagfromlocalid(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B)
    playbgm(MUS_RG_ENCOUNTER_ROCKET, FALSE)
    addobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A)
    addobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A, HousingProtest_ApproachLandlord)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B, HousingProtest_ApproachLandlord)
    waitmovement(0)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, Common_Movement_ExclamationMark)
    playse(SE_PIN)
    waitmovement(0)
    msgbox(format("The only thing we're understanding is that you need to leave, and take your fancy apartments with you!"),,SPEAKER_RABIA)
    closemessage
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, moves(lock_facing_direction, walk_slow_up, delay_16, unlock_facing_direction, step_end))
    waitmovement(0)
    msgbox(format("Are you trying to intimidate me? I'm just doing my job. Don't make me call the police!"),,SPEAKER_LANDLORD)
    msgbox(format("They can't arrest of all us, right?"),,SPEAKER_RABIA)
    msgbox(format("Ain't gonna be nothing to defend when we done..."),,SPEAKER_VITOMIR)
    closemessage
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A, Common_Movement_FaceRight)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B, Common_Movement_FaceRight)
    msgbox(format("If we, the people of Oroland can't stay here, nobody can. Let's bring it down!"),,SPEAKER_VITOMIR)
    closemessage
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_A,moves(face_left))
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_B,moves(face_left))
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_C,moves(face_left))
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_D,moves(face_left))
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_E,moves(face_left))
    //applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_F,moves(face_left))
    //applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_G,moves(face_left))
    //applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_H,moves(face_left))
    //applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_I,moves(face_left))
    waitmovement(0)
    //applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_G, Common_Movement_ExclamationMark)
    waitmovement(0)
    msgbox(format("Yeah!"),,SPEAKER_PROTEST_A,TAIL_SHOUT,EMOTE_ANGRY)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_D, Common_Movement_ExclamationMark)
    msgbox(format("Let's do this!"),,SPEAKER_PROTEST_C,TAIL_SHOUT,EMOTE_ANGRY)
    waitmovement(0)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_C, Common_Movement_ExclamationMark)
    msgbox(format("Screw these developers!"),,SPEAKER_PROTEST_D,TAIL_SHOUT,EMOTE_ANGRY)
    waitmovement(0)
    closemessage
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A, Common_Movement_FaceUp)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B, Common_Movement_FaceUp)
    waitmovement(0)
    playse(SE_BALL_OPEN)
    waitse
    clearobjectflagfromlocalid(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_MON)
    callnative(HousingProtest_BufferMostPowerfulAttackAndMove)
    addobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_MON)
    playmoncry(VAR_TEMP_0, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("Look, I'm just the super. I don't own this building, but I am responsible for making sure you don't trash it. I'm trying to reason with you and you're threatening me?"),,SPEAKER_LANDLORD)
    msgbox(format("I don't care if you're the landlord or working for the landlord, and I promise if you don't get out of the way, we're gonna have a problem."),,SPEAKER_VITOMIR)
    msgbox(format("Cut it out!"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        closemessage
    applymovement(PLAYER, moves(walk_left * 3, face_down, step_end))
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD, moves(walk_left, face_down, step_end))
    waitmovement(0)
    msgbox(format("Every time I see you guys, you're attacking innocent people. Don't you have something more productive to do?"),MSGBOX_DEFAULT,SPEAKER_ALICIA,,EMOTE_ANGRY)
        msgbox(format("Innocent? These clowns?! Damn, you transplants really got it twisted."),,SPEAKER_RABIA)
    msgbox(format("This ain't your business. You should un-involve yourself."),,SPEAKER_VITOMIR)
    msgbox(format("I can take both of you. Leave him alone, or you're going through me."),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        closemessage
    setvar(VAR_ROUTE99_STATE,SAVE_THE_TIDE_ROUTE99)
    copyobjectxytoperm(LOCALID_ROUTE_99_HOUSING_PROTEST_LANDLORD)
    copyobjectxytoperm(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A)
    copyobjectxytoperm(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B)
    startmenu_savescreen
    goto(HousingProtest_StartBattle_Script)
}

script HousingProtest_StartBattle_Script {
    lockall
	goto(HousingScript_StartActualBattle_Script)
}

script HousingProtest_StartBattle_PostSave_Script {
    locktarget
    setobjectmovementtype(LOCALID_ROUTE_99_HOUSING_PROTEST_E, MOVEMENT_TYPE_WANDER_UP_AND_DOWN)
    //setobjectmovementtype(LOCALID_ROUTE_99_HOUSING_PROTEST_G, MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT)
	goto(HousingScript_StartActualBattle_Script)
}

script HousingScript_StartActualBattle_Script
{
    callnative(HousingProtest_BufferMostPowerfulAttackAndMove)
    msgbox(format("Pfft, fine with me. {STR_VAR_1}, {STR_VAR_2}!"),,SPEAKER_VITOMIR)
    closemessage
    trainerbattle_two_trainers(TRAINER_HOUSINGPROTEST_A,format("Shit..."),TRAINER_HOUSINGPROTEST_B,format("This is not how this was supposed to go down."))
    goto(HousingProtest_PostBattle_Dialogue)
}

script HousingProtest_PostBattle_Dialogue {
    lockall
    clearflag(FLAG_TALKED_LANDLORD)
    startcutscene(JUMPPLAYER_HOUSINGPROTEST)
    setvar(VAR_STORYLINE_STATE,STORY_DEFEAT_CHASILLA_PROTEST)
    setobjectmovementtype(LOCALID_ROUTE_99_HOUSING_PROTEST_E, MOVEMENT_TYPE_WANDER_UP_AND_DOWN)
    //setobjectmovementtype(LOCALID_ROUTE_99_HOUSING_PROTEST_G, MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT)
    playse(SE_BALL_OPEN)
    waitse
    removeobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_MON)
    setvar(VAR_ROUTE99_STATE,DEFEATED_THE_TIDE_ROUTE99)
    msgbox(format("You proud now? C'mon Vitomir."),,SPEAKER_RABIA)
    msgbox(format("Keep on licking those boots, fam. Dumbass..."),,SPEAKER_VITOMIR)
    closemessage
    call(HousingProtest_GruntsAwalkAway_Script)
    releaseall
    call(TryAutoSave)
    endcutscene
    end
}

script HousingProtest_GruntsAwalkAway_Script {

    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)

    if (var (VAR_TEMP_1) == 21) {
        call(HousingProtest_MoveGruntsAroundPlayer_Script)
    } else {
        call(HousingProtest_MoveGruntsExit_Script)
    }
    waitmovement(0)
    removeobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B)
    removeobject(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A)
    fadedefaultbgm
}

script HousingProtest_MoveGruntsExit_Script {
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B, HousingProtest_WalkSouthFromLandlord)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A, HousingProtest_WalkSouthFromLandlord)
}

script HousingProtest_MoveGruntsAroundPlayer_Script {
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_A, HousingProtest_WalkAroundPlayer)
    applymovement(LOCALID_ROUTE_99_HOUSING_PROTEST_FAKE_COMRADE_B, HousingProtest_WalkAroundPlayer)
}

script HousingProtest_InteractLandlord_Script {
    lock

    if (var (VAR_ROUTE99_STATE) < DEFEATED_THE_TIDE_ROUTE99)
    {
        msgbox(format("Oh god... they're going to kill me!"), MSGBOX_NPC,SPEAKER_LANDLORD)
    }
    elif (!flag(FLAG_TALKED_LANDLORD))
    {
        call(HousingProtest_InteractLandlord_Dialogue)
    }
    else
    {
        msgbox(format("I don't get paid enough to be the super and security..."), MSGBOX_NPC,SPEAKER_LANDLORD,TAIL_WHISPER)
    }

    closemessage
    release
    end
}

script HousingProtest_InteractLandlord_Dialogue {
    setflag(FLAG_TALKED_LANDLORD)
    faceplayer
    msgbox(format("Thank you very much. You're right, The Tide has a tendency to pick on the defenseless like me."), ,SPEAKER_LANDLORD)
    msgbox(format("Why were people protesting?"),,SPEAKER_ALICIA)
    msgbox(format("Some of the citizens of Oroland feel that they are... entitled to live anywhere within their city limits."),,SPEAKER_LANDLORD)
    msgbox(format("I don't get why they don't think they're subject to the same rent rules and regulations as the rest of us."),,SPEAKER_LANDLORD,,EMOTE_ANGRY)
    msgbox(format("So people were coming to take over the building?"),,SPEAKER_ALICIA)
    msgbox(format("I guess so?"),,SPEAKER_LANDLORD)
    msgbox(format("What about the police?"),,SPEAKER_ALICIA)
    msgbox(format("I'm sure they would have stopped it, but these protests are getting more and more common. The police can't be everywhere at once!"),,SPEAKER_LANDLORD)
}

movement HousingProtest_WalkPlayer1Left {
    walk_left * 1
    step_end
}

movement HousingProtest_WalkPlayer2Left {
    walk_left * 2
    step_end
}

movement HousingProtest_WalkPlayer3Left {
    walk_left * 3
    step_end
}

movement HousingProtest_WalkPlayer4Left {
    walk_left * 4
    step_end
}

movement HousingProtest_ApproachLandlord {
    walk_up * 4
    step_end
}

movement HousingProtest_WalkSouthFromLandlord {
    walk_down * 4
    step_end
}

movement HousingProtest_WalkAroundPlayer {
    walk_right * 2
    walk_down * 4
    step_end
}
