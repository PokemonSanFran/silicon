const PLAYER = OBJ_EVENT_ID_PLAYER
const BD = 1

script EnterBD_StartBattle_ObjectSetup_Script {
    setobjectxyperm(BD,3,5)
    setobjectmovementtype(BD, MOVEMENT_TYPE_FACE_RIGHT)
}

script EnterBD_Event_Script {
    goto_if_quest_active(QUEST_INVERSEHALLUCINOGENIC,Quest_Inversehallucinogenic_BD_Interact_Script)
    goto_if_quest_complete(QUEST_INVERSEHALLUCINOGENIC,TirabudinPlace_Gym_BDRematch_Script)
    switch (var (VAR_GYM_7_STATE)) {
    case GYM_SAVE_BEFORE_LEADER:
        faceplayer
        goto(EnterBD_StartBattle_Script)
    case GYM_DEFEATED_LEADER:
        goto(EnterBD_PostDefeat1_Dialogue)
    case GYM_EXPLAINED_BADGE_AND_TM:
        goto(EnterBD_PostDefeat2_Dialogue)
    default:
        goto(EnterBD_MumbleToSelf_Dialogue)
    }
}

script EnterBD_MumbleToSelf_Dialogue {
    lock
    setvar(VAR_GYM_7_STATE, GYM_SAVE_BEFORE_LEADER)
    msgbox(format("stupid fucking parade…"),,SPEAKER_BD,TAIL_WHISPER)
    closemessage
    applymovement(BD, moves(walk_right * 3, face_up, step_end))
    waitmovement(BD)
    msgbox(format("They wouldn't get it…Sharprise were gonna own this place one way or another…It wouldn't even be a Gym anymore if not for me…"),,SPEAKER_BD,TAIL_WHISPER)
    closemessage

    applymovement(BD, moves(walk_left * 3, face_up, step_end))
    waitmovement(BD)

    msgbox(format("Hey, you seem busy, but are you BD?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
    closemessage

    playse(SE_PIN)
    applymovement(BD, moves(emote_exclamation_mark, face_down))
    waitmovement(BD)

    msgbox(format("Shit. Shit shit shit hi, are you a challenger? Hold on yeah, hold on. NOPE, not doing this sober, hold on… Lemme just…"), MSGBOX_NPC,SPEAKER_BD)
    closemessage

    applymovement(BD, moves(walk_left, walk_in_place_slow_up, delay_16, walk_down, walk_right, step_end))
    waitmovement(BD)
    applymovement(PLAYER,Common_Movement_WalkLeft)
    waitmovement(PLAYER)
    goto(EnterPsf7leader_ExplainLab_Dialogue)
}

script EnterPsf7leader_ExplainLab_Dialogue
{
    reveal(REVEAL_BD)
    msgbox(format("So back here, I experiment with new synthetic drugs. Always trying to get an edge, you know? Let's see if I can battle under the influence of MGB-07."),,SPEAKER_BD)

    msgbox(format("Wait, does the League let you battle under the influence like that?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        startmenu_savescreen
    goto(EnterBD_StartBattle_Script)
}

script EnterBD_StartBattle_Script {
    msgbox(format("I don't know the rules… but I'm sure they won't stop me either way."),,SPEAKER_BD)
    closemessage
        trainerbattle_no_intro(TRAINER_BD,format("Ugh, I think this batch makes me too nauseous…"))
    goto(EnterBD_PostBattle_Script)
}

script EnterBD_PostBattle_Script {
    lock
    startcutscene(JUMPPLAYER_ENTERBD)
    cleargymtrainersandgetbadge(GYM_BD)
    setvar(VAR_GYM_7_STATE,GYM_DEFEATED_LEADER)
    setvar(VAR_BD_STATE,BATTLE_1_COMPLETE)
    addvar(VAR_STORYLINE_STATE, 1)
    zapfanfare(ZAP_GYM_TIRABUDIN_PLACE_BADGE,MUS_GET_BADGE)
    cueobjectplayer(BD)
    giveitem(ITEM_GYM_REWARD_TIRABUDIN)
    closemessage
    moveobjecttocoords(BD,3,3,DIR_NORTH)
    waitmovement(BD)
    call(TryAutoSave)
    endcutscene
    release
    end
}

script EnterBD_PostDefeat1_Dialogue {
    lock
    setvar(VAR_GYM_7_STATE,GYM_DEFEATED_LEADER)
    msgbox(format("TMs are like drugs, right? They alter your brain chemistry and let you see stuff you'd never see otherwise… that one will teach Psfgymattack7."),MSGBOX_NPC,SPEAKER_BD)
    closemessage
        applymovement(BD,Common_Movement_FaceUp)
    waitmovement(0)
    release
    end
}

script EnterBD_PostDefeat2_Dialogue {
    lock
    msgbox(format("Let's see if I can bang out MGB-08 while I'm riding this high…"),,SPEAKER_BD)
    closemessage
        release
    end
}

movement EnterBD_BD_WalkToBattlefield {
    walk_left * 2
    walk_down * 4
    face_left
    step_end
}

