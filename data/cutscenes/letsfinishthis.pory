const PLAYER = OBJ_EVENT_ID_PLAYER
const CAMERA = OBJ_EVENT_ID_CAMERA
const BAIYA = 3
const ADAORA = 13
const TALA = 15
const MAGNUS = 16
const FRANK = 17
const ELEANOR = 18

const FLAG_HIDE_POLICE = FLAG_TEMP_2
const FLAG_HIDE_ELITE = FLAG_TEMP_4
const FLAG_HIDE_BAIYA = FLAG_TEMP_1
const FLAG_HIDE_ADAORA = FLAG_TEMP_3

script LetsFinishThis_ObjectHide_Script
{
	setobjectflagfromlocalid(LOCALID_HALAI_TALA)
	setobjectflagfromlocalid(LOCALID_HALAI_FRANK)
	setobjectflagfromlocalid(LOCALID_HALAI_ELEANOR)
	setobjectflagfromlocalid(LOCALID_HALAI_MAGNUS)
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_A)
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_B)
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_C)
	setobjectflagfromlocalid(LOCALID_HALAI_BAIYA)
	setobjectflagfromlocalid(LOCALID_HALAI_ADAORA)
}

script LetsFinishThis_ObjectSetUp_Script {
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_A)
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_B)
	setobjectflagfromlocalid(LOCALID_HALAI_POLICE_C)

        setobjectxy(LOCALID_HALAI_ADAORA,32,12)
        setobjectxyperm(LOCALID_HALAI_ADAORA,32,12)

        setobjectxy(LOCALID_HALAI_BAIYA,33,12)
        setobjectxyperm(LOCALID_HALAI_BAIYA,33,12)
}

script LetsFinishThis_MovePlayer_Script {
    getplayerxy(VAR_TEMP_0,VAR_TEMP_1)

        if (var(VAR_TEMP_0) != 34 || (var(VAR_TEMP_1) != 13)){
            fadescreen(FADE_TO_BLACK)
                setobjectxy(PLAYER,34,13)
                TeleportCamera(34,13)
                fadescreen(FADE_FROM_BLACK)
        }
    applymovement(PLAYER,Common_Movement_FaceLeft)
        waitmovement(0)
        goto(LetsFinishThis_Debrief_Dialogue)
}

script LetsFinishThis_Debrief_Dialogue
{
    lock
        startcutscene(JUMPPLAYER_LETSFINISHTHIS)
        msgbox(format("I don’t think I’m surprised by SharpRise Capital, but the government too? All those talks, those negotiations… they're supposed to protect their citizens!"),,SPEAKER_MAGNUS)

        msgbox(format("That part doesn’t surprise me. Old age getting to ya? We all know, money is their only constituent."),,SPEAKER_FRANK)

        msgbox(format("But innocent people? Attacking an entire island just to wipe out The Tide? This is insane!"),,SPEAKER_TALA)

        msgbox(format("Perfectly sane. It worked on Arantraz didn’t it? There’s no peaceful path forward. Do you all get it now? They’re poised to kill!"),,SPEAKER_ELEANOR)

        msgbox(format("But they weren’t always, were they?"),,SPEAKER_BAIYA_TIDE)

        msgbox(format("SharpRise Capital has always been ruthless! Killing is… new though."),,SPEAKER_ADAORA)

        msgbox(format("That’s what I mean. We spun up this awesome program, we attacked the operations of their corporate partners, our message is really getting out there! I think they’re nervous."),,SPEAKER_BAIYA_TIDE)

        msgbox(format("Or desperate."),,SPEAKER_FRANK)

        msgbox(format("Maybe now it's the time to really bring the fight to them!"),,SPEAKER_BAIYA_TIDE)

        msgbox(format("Now might be the time. We’ve explored every other path."),,SPEAKER_MAGNUS)

        msgbox(format("Public sentiment is strong as hell. A confrontation and confession might be a moonshot, but it's a helluva shot, right?"),,SPEAKER_TALA)

        msgbox(format("Even if we pull it off, will exposing them even matter? Or work?"),,SPEAKER_ADAORA)

        msgbox(format("They came for the kings and missed. This may be the only chance to fight back."),,SPEAKER_ELEANOR)

        msgbox(format("So, break into SharpRise Spire, force a confession from Lucrezia, broadcast it using their equipment and public sentiment will come crashing down. Right?"),,SPEAKER_BAIYA_TIDE)

        msgbox(format("A public confession would force the government to take action."),,SPEAKER_FRANK)

        msgbox(format("I was being sarcastic!"),,SPEAKER_BAIYA_TIDE,TAIL_SHOUT,EMOTE_SHOCK)

        msgbox(format("The hardest part of that plan is actually just getting to Lucrezia. The rest of that is fairly plausible, given we survive."),,SPEAKER_ELEANOR)

	callnative(Script_BufferNumberOfCompletedTakedownQuests)
        msgbox(format("{STR_VAR_1} has-beens, the disgraced Champion and some terriorists running into the belly of the beast... but how to get inside..."),,SPEAKER_ADAORA)
		closemessage
		delay(24)

        msgbox(format("The warp panels!"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        closemessage
        goto(LetsFinishThis_GoToFlashback_Script)
}

script LetsFinishThis_GoToFlashback_Script
{
	fadescreen(FADE_TO_BLACK)
	call(KeiyingRaisonDetre_Dialogue_ExplainWarpPanels)
	closemessage
	fadescreen(FADE_FROM_BLACK)
	goto(LetsFinishThis_StartPlanning_Dialogue)
}

script LetsFinishThis_Script_HintTowardsTakedownFrank
{
	msgbox(format("I'd be there on the front lines, but I can't drop the momentum I'm making with against Arriba. If I finish up early, I'll be there to lend a hand!"),,SPEAKER_FRANK)
}

script LetsFinishThis_Script_HintTowardsTakedownEleanor
{
	msgbox(format("Storming Sharprise Capital is a dream... but I can't abandon my campaign against Presto. I wish you all the best, and I'll join as soon as we're done."),,SPEAKER_ELEANOR)
}

script LetsFinishThis_Script_HintTowardsTakedownTala
{
	msgbox(format("I don't know if I'm young enough for this, but I'm finally getting to the source of the rot within Buzzr. These old bones will make their way over once I've finished."),,SPEAKER_TALA)
}

script LetsFinishThis_StartPlanning_Dialogue {
    lock
        msgbox(format("That works... but nobody has seen Keiying since their stunt in the warehouse. Cops have been crawling all over that neighborhood and house looking for him."),,SPEAKER_ADAORA)

        msgbox(format("How about Ramesh? That workaholic absolutely has a panel in their place. And no police looking for them."),,SPEAKER_FRANK)

		call_if_quest_not_complete(QUEST_WAREHOUSEWARFARE,LetsFinishThis_Script_HintTowardsTakedownEleanor)
		call_if_quest_not_complete(QUEST_BREAKTHEINTERNET,LetsFinishThis_Script_HintTowardsTakedownTala)
		call_if_quest_not_complete(QUEST_PERSUASIVEPASSENGER,LetsFinishThis_Script_HintTowardsTakedownFrank)
        closemessage


        applymovement(LOCALID_HALAI_BAIYA, moves(walk_down, face_right, step_end))
        waitmovement(LOCALID_HALAI_BAIYA)

		buffermapname(STR_VAR_1,MAP_QIU_VILLAGE)
        msgbox(format("You should go prepare! Once we start, I don’t think there’s any turning back. Meet us outside Ramesh’s house in {STR_VAR_1}."),,SPEAKER_BAIYA_TIDE)
        closemessage

        applymovement(LOCALID_HALAI_BAIYA, moves(walk_left, face_up, step_end))
        waitmovement(LOCALID_HALAI_BAIYA)

        setvar(VAR_STORYLINE_STATE,STORY_BEFORE_RAMESH_BREAKIN)
        setvar(VAR_HALAI_ISLAND_STATE,POST_WAIT_EVEN_THEN)

        call(TryAutoSave)
        endcutscene
        release
        end
}

