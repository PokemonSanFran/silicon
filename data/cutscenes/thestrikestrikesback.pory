const PLAYER = OBJ_EVENT_ID_PLAYER
const LOCALID_ROUTE2_CHARLOTTE = LOCALID_CAMERA + 1
const LOCALID_ROUTE2_OLIVER = LOCALID_CAMERA + 2
const LOCALID_ROUTE2_LUCREZIA = LOCALID_CAMERA + 3
const LOCALID_ROUTE2_VIGRIM = LOCALID_CAMERA + 4
const LOCALID_ROUTE2_POLICE_A = LOCALID_CAMERA + 5
const LOCALID_ROUTE2_POLICE_B = LOCALID_CAMERA + 6
const LOCALID_ROUTE2_TIDE_A = LOCALID_CAMERA + 7
const LOCALID_ROUTE2_TIDE_B = LOCALID_CAMERA + 8

script TheStrikeStrikesBack_Script_AddOliverCharlotte
{
    spawnobject(OBJ_EVENT_GFX_OLIVER,LOCALID_ROUTE2_OLIVER,21,26,DIR_NORTH,3)
    spawnobject(OBJ_EVENT_GFX_CHARLOTTE,LOCALID_ROUTE2_CHARLOTTE,22,26,DIR_WEST,3)
}

script TheStrikeStrikesBack_UnblockConstruction_Script
{
    setmetatile(21,19,0x211,FALSE)
    special(DrawWholeMapView)
}

script TheStrikeStrikesBack_AddRocketObjects_Script
{
    spawnobject(OBJ_EVENT_GFX_VIGRIM,LOCALID_ROUTE2_VIGRIM,21,19,DIR_SOUTH,3)
    spawnobject(OBJ_EVENT_GFX_COMRADE_5,LOCALID_ROUTE2_TIDE_A,20,18,DIR_SOUTH,3)
    spawnobject(OBJ_EVENT_GFX_COMRADE_9,LOCALID_ROUTE2_TIDE_B,22,18,DIR_SOUTH,3)
}

script TheStrikeStrikesBack_CrowdFacesNorth_Script
{
    playse(SE_PIN)
    applymovement(LOCALID_ROUTE2_CROWD_A,TheStrikeStrikesBack_FaceNorth)
    applymovement(LOCALID_ROUTE2_CROWD_B,Common_Movement_FaceUp)
    applymovement(LOCALID_ROUTE2_CROWD_C,TheStrikeStrikesBack_FaceNorth)
    applymovement(LOCALID_ROUTE2_POLICE_A,Common_Movement_FaceUp)
    applymovement(LOCALID_ROUTE2_POLICE_B,Common_Movement_FaceUp)
    applymovement(LOCALID_ROUTE2_LUCREZIA,TheStrikeStrikesBack_FaceNorth)
    applymovement(LOCALID_ROUTE2_CHARLOTTE,TheStrikeStrikesBack_FaceNorth)
    applymovement(LOCALID_ROUTE2_OLIVER,TheStrikeStrikesBack_FaceNorth)
    applymovement(PLAYER,Common_Movement_FaceUp)
    waitmovement(PLAYER)
}

script TheStrikeStrikesBack_PhoneCall_Dialogue
{
    lock
    startcutscene(JUMPPLAYER_THESTRIKESTRIKESBACK)
        setvar(VAR_STORYLINE_STATE,STORY_CALLED_TO_CONSTRUCTION)
        setvar(VAR_CONSTRUCTION_STRIKE_STATE,STRIKE_HAS_BEGUN)
        playse(SE_POKENAV_CALL)
        waitse
        playse(SE_POKENAV_CALL)
        msgbox(format("Hello {PLAYER}! I was going to send an email, but Oliver insisted that a call would be more appropriate..."),MSGBOX_DEFAULT,SPEAKER_LUCREZIA,TAIL_DEFAULT,EMOTE_SHOCK,PHONE_ON)
        msgbox(format("Lucrezia! Aren't you busy...?"),MSGBOX_DEFAULT,SPEAKER_ALICIA,TAIL_DEFAULT,EMOTE_DEFAULT,PHONE_ON)

        specialvar(VAR_0x8004,GetCurrentMap)
        switch(var(VAR_0x8004))
        {
            case MAP_IRISINA_TOWN:
            case MAP_HALERBA_CITY:
            case MAP_FORT_YOBU:
            case MAP_TIRABUDIN_PLACE: msgbox(format("Nonsense, I'm never too busy to congratulate you on all eight badges!"),MSGBOX_DEFAULT,SPEAKER_LUCREZIA,TAIL_DEFAULT,EMOTE_DEFAULT,PHONE_ON)
            default: msgbox(format("So busy in fact, that I'm late in congratulating you. I hear you've got all eight badges!"),MSGBOX_DEFAULT,SPEAKER_LUCREZIA,TAIL_DEFAULT,EMOTE_DEFAULT,PHONE_ON)
        }

    msgbox(format("Heh, thanks! Means a lot."),,SPEAKER_ALICIA)
        buffermapname(STR_VAR_1,MAP_ROUTE2)
        msgbox(format("You're right though, we're both about to be very busy. I'll cut to the chase. Could you head down to {STR_VAR_1}? Oliver will meet you there and explain everything."),MSGBOX_DEFAULT,SPEAKER_LUCREZIA,TAIL_DEFAULT,EMOTE_DEFAULT,PHONE_ON)
        msgbox(format("Sure. Be right there!"),MSGBOX_DEFAULT,SPEAKER_ALICIA,TAIL_DEFAULT,EMOTE_DEFAULT,PHONE_ON)
        playse(SE_POKENAV_HANG_UP)
        closemessage
        waitse
        fadeblackandsetremovewarpfadeflag
        warpsilent(MAP_ROUTE2,WARP_ID_NONE,21,25)
        waitstate
    release
        end
}

script TheStrikeStrikesBack_Intro_Dialogue
{
    lock
    setvar(VAR_CONSTRUCTION_STRIKE_STATE,START_VS_GARBODOR)

            msgbox(format("Congratulations to you, {PLAYER}! You're caught up on the strikes, right?"),,SPEAKER_OLIVER)

            msgbox(format("Yeah, I saw them on the news. Why are we involved though?"),,SPEAKER_ALICIA)

            msgbox(format("Well, here's the problem. We - ! oh Lord."),,SPEAKER_OLIVER)

            closemessage

            call(TheStrikeStrikesBack_AddRocketObjects_Script)

            applymovement(LOCALID_ROUTE2_VIGRIM,TheStrikeStrikesBack_WalkIntoFrame)
            applymovement(LOCALID_ROUTE2_TIDE_A,TheStrikeStrikesBack_WalkIntoFrame)
            applymovement(LOCALID_ROUTE2_TIDE_B,TheStrikeStrikesBack_WalkIntoFrame)
            waitmovement(0)

            call(TheStrikeStrikesBack_CrowdFacesNorth_Script)

            msgbox(format("My name is Vigrim, and I am the leader of The Tide. "),,SPEAKER_VIGRIM)

            closemessage
            reveal(REVEAL_VIGRIM)

            msgbox(format("We are fighting alongside the construction workers here, and we are hoping to come to a reasonable conclusion for all."),,SPEAKER_VIGRIM)

            buffermapname(STR_VAR_1,MAP_SHARPRISE_STADIUM_ARENA)
            msgbox(format("Our single demand is that the pay for all {STR_VAR_1} construction workers is doubled. Until this demand is met, these hard-working Resido laborers will dig not another hole, place another brick, or lay another cable."),,SPEAKER_VIGRIM)

            closemessage

            applymovement(LOCALID_ROUTE2_VIGRIM,TheStrikeStrikesBack_WalkOutFrame)
            applymovement(LOCALID_ROUTE2_TIDE_A,TheStrikeStrikesBack_WalkOutFrame)
            applymovement(LOCALID_ROUTE2_TIDE_B,TheStrikeStrikesBack_WalkOutFrame)
            applymovement(LOCALID_ROUTE2_CHARLOTTE,Common_Movement_FaceLeft)
            applymovement(PLAYER,Common_Movement_FaceDown)
            applymovement(LOCALID_ROUTE2_POLICE_A,Common_Movement_FaceDown)
            applymovement(LOCALID_ROUTE2_CROWD_A,Common_Movement_FaceLeft)
            applymovement(LOCALID_ROUTE2_CROWD_B,Common_Movement_FaceRight)

            waitmovement(0)

            msgbox(format("Sigh, of course. Well, they're the reason we brought you here. We've received intel that The Tide is planning on using exploding Pokemon to bring down the construction site. The strike is just a distraction. "),,SPEAKER_OLIVER)

            msgbox(format("Wait, what? That's insane!"),,SPEAKER_ALICIA)

            msgbox(format("Agreed, and that's why we need you two while Lucrezia and I work on a peaceful solution."),,SPEAKER_OLIVER)

            buffermapname(STR_VAR_1,MAP_CAPHE_CITY)
            msgbox(format("The police are working to make sure the protests remain civil but we don't want a repeat of the riots in {STR_VAR_1}."),,SPEAKER_OLIVER)

            bufferspeciesname(STR_VAR_1,SPECIES_GARBODOR)
            msgbox(format("We think The Tide agitated wild {STR_VAR_1}, and we need you to capture or knock them out while Lucrezia and I negotiate with Vigrim. Time is of the essence!"),,SPEAKER_OLIVER)

            closemessage

            applymovement(LOCALID_ROUTE2_OLIVER,TheStrikeStrikesBack_WalkOutFrame)
            applymovement(LOCALID_ROUTE2_CHARLOTTE, moves(walk_left, face_up, step_end))
            waitmovement(LOCALID_ROUTE2_OLIVER)

            msgbox(format("{PLAYER}, I'll be in there when you're ready."),,SPEAKER_CHARLOTTE)

            closemessage
            applymovement(LOCALID_ROUTE2_CHARLOTTE,TheStrikeStrikesBack_WalkOutFrame)
            waitmovement(0)
            removeobject(LOCALID_ROUTE2_CHARLOTTE)
            removeobject(LOCALID_ROUTE2_OLIVER)
            //call(TheStrikeStrikesBack_ObjectCleanup_Script)
    call(TryAutoSave)
endcutscene
            release
            end
}

movement TheStrikeStrikesBack_FaceNorth {
    emote_exclamation_mark
        face_up
        step_end
}
movement TheStrikeStrikesBack_WalkIntoFrame {
    walk_down * 3
        step_end
}
movement TheStrikeStrikesBack_WalkOutFrame {
    walk_left * 2
        walk_up * 8
        step_end
}

