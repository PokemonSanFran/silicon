const PLAYER = OBJ_EVENT_ID_PLAYER

script OffYouGo_Script_HideCharlotteOliver
{
    setobjectflagfromlocalid(LOCALID_PIOCABRIDGE_OLIVER)
    setobjectflagfromlocalid(LOCALID_PIOCABRIDGE_CHARLOTTE)
}

script OffYouGo_WakeUp_Dialogue
{
    fwdtime(MORNING_HOUR_BEGIN,0)
    startcutscene(JUMPPLAYER_OFFYOUGO_PHONE)
    setvar(VAR_PIOCABRIDGE_STATE,CALLED_BY_CHARLOTTE)
    setvar(VAR_STORYLINE_STATE,STORY_ASSIGNED_FRANK_QUESTS)
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_POKENAV_CALL)
    waitmessage
    msgbox(format("Huh? Hello?"),,SPEAKER_ALICIA,TAIL_TALK,EMOTE_CONFUSE,PHONE_ON)

    msgbox(format("Hey, where are you? Are you still asleep?"),,SPEAKER_CHARLOTTE,TAIL_TALK,EMOTE_ANGRY,PHONE_ON)

    msgbox(format("…yeah, I'm in bed."),,SPEAKER_ALICIA,TAIL_TALK,,PHONE_ON)

    msgbox(format("Come on get up, didn't you see Oliver's zap? We're waiting for you!"),,SPEAKER_CHARLOTTE,TAIL_SHOUT,EMOTE_ANGRY,PHONE_ON)

    msgbox(format("Waiting for me…? Hold on, let me read…"),,SPEAKER_ALICIA,TAIL_TALK,EMOTE_CONFUSE,PHONE_ON)

    showzap(ZAP_STORY_SUMMON)
    showzap(ZAP_SUMMON_RESPONSE)

    msgbox(format("Yeah, I didn't see that. I guess I'm on my way."),,SPEAKER_ALICIA,TAIL_TALK,,PHONE_ON)

    msgbox(format("Ugh, fine, get your tail down here!"),,SPEAKER_CHARLOTTE,TAIL_SHOUT,EMOTE_ANGRY,PHONE_ON)
    closemessage

    playse(SE_POKENAV_HANG_UP)

    msgbox(format("(How are they always up so early…?)"),,SPEAKER_ALICIA,TAIL_THOUGHT,EMOTE_SAD)
    waitse
    closemessage
    call(TryAutoSave)
    endcutscene
}

script OffYouGo_WelcomeParty_Dialogue
{
    clearflag(FLAG_FORCE_LOAD_OFFSCREEN_OBJ)
        setvar(VAR_PIOCABRIDGE_STATE,POST_OFF_YOU_GO)
        setvar(VAR_LANJINGTUNNEL_STATE,CHARLOTTE_INSIDE_TUNNEL)
        startcutscene(JUMPPLAYER_OFFYOUGO_BRIDGE)
        moveobjecttocoords(PLAYER,16,14,DIR_NORTH)

        msgbox(format("Welcome to the party, sleepyhead."),,SPEAKER_CHARLOTTE)

        msgbox(format("Honestly {PLAYER}, it's fine. I wasn't expecting Charlotte to be awake so early!"),,SPEAKER_OLIVER)

        msgbox(format("…neither was I."),,SPEAKER_ALICIA)

        msgbox(format("Well, you're both here now. As you may have guessed, the construction strike is going to delay the Championship by a few weeks. Rather than kill your momentum now, Frank has agreed to train you both, and SharpRise Capital will be footing his... substantial consultation fee."),,SPEAKER_OLIVER)

        closemessage

        waitmovement(PLAYER)
        applymovement(LOCALID_PIOCABRIDGE_CHARLOTTE,Common_Movement_FaceRight)
        waitmovement(LOCALID_PIOCABRIDGE_CHARLOTTE)

        msgbox(format("Thanks but - who the hell is that?"),,SPEAKER_CHARLOTTE)

        closemessage

        applymovement(LOCALID_PIOCABRIDGE_OLIVER,Common_Movement_FaceLeft)
        waitmovement(LOCALID_PIOCABRIDGE_OLIVER)

        msgbox(format("Ah yes, you're not from here. Frank is one of the members of the disbanded Resido Elite Four. A powerful trainer indeed, and we think this is an excellent opportunity for you both."),,SPEAKER_OLIVER)

        msgbox(format("So, where is this guy?"),,SPEAKER_CHARLOTTE)

        buffermapname(STR_VAR_1,MAP_LANJING_TUNNEL_B2F)
        msgbox(format("Ah yes, well, they have… unconventional training methods. In the middle of {STR_VAR_1}, you'll find a pathway leading underground where Frank has hidden their notebook. Once you get it, you'll get your next instructions."),,SPEAKER_OLIVER)

        msgbox(format("Weird. Okay. Sounds easy enough, though. Let's make a race of it!"),,SPEAKER_CHARLOTTE)

        closemessage

        moveobjecttocoords(LOCALID_PIOCABRIDGE_CHARLOTTE,15,7,DIR_NORTH,3)
        applymovement(LOCALID_PIOCABRIDGE_OLIVER, Common_Movement_FaceUp)
        waitmovement(LOCALID_PIOCABRIDGE_CHARLOTTE)
        playse(SE_EXIT)
        removeobject(LOCALID_PIOCABRIDGE_CHARLOTTE)
        msgbox(format("Oh wait!"),,SPEAKER_OLIVER)
        closemessage
        waitse

        applymovement(LOCALID_PIOCABRIDGE_OLIVER,Common_Movement_FaceDown)
        waitmovement(LOCALID_PIOCABRIDGE_OLIVER)

        buffermapname(STR_VAR_1,MAP_LANJING_TUNNEL_B2F)
        buffermapname(STR_VAR_2,MAP_LEAVERRA_FOREST)
        msgbox(format("I do wish they'd slow down just a little… two more things, {PLAYER}. First, the training requires teamwork. Charlotte is going to get stuck without you pretty quickly. Second, there's very little cell service in {STR_VAR_1} and {STR_VAR_2}. And now that they're already inside, I can't message them. So can you fill them in?"),,SPEAKER_OLIVER)

        msgbox(format("I'll hurry so they're not waiting too long!"),,SPEAKER_ALICIA,,EMOTE_SWEAT)

        buffermapname(STR_VAR_2,MAP_ESPULEE_OUTSKIRTS)
        msgbox(format("Good luck. It might be a good idea to stock up before you go in. I know the training is extensive, but there is a town, {STR_VAR_2}, after {STR_VAR_1}."),,SPEAKER_OLIVER)
        closemessage
        moveobjecttocoords(LOCALID_PIOCABRIDGE_OLIVER,16,20,DIR_SOUTH)
        delay(48)
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_PIOCABRIDGE_OLIVER)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        call(TryAutoSave)
        endcutscene

        releaseall
        end
}
