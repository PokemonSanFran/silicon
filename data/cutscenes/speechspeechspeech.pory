const VOBJ_ARANTRAZ_MESSHALL_COMRADE_1 = (LOCALID_CAMERA + 1)
const VOBJ_ARANTRAZ_MESSHALL_COMRADE_2 = (LOCALID_CAMERA + 2)
const VOBJ_ARANTRAZ_MESSHALL_COMRADE_3 = (LOCALID_CAMERA + 3)
const VOBJ_ARANTRAZ_MESSHALL_COMRADE_4 = (LOCALID_CAMERA + 4)
const VOBJ_ARANTRAZ_MESSHALL_COMRADE_5 = (LOCALID_CAMERA + 5)
const VOBJ_ARANTRAZ_MESSHALL_COMRADE_6 = (LOCALID_CAMERA + 6)

script SpeechSpeechSpeech_MoveObject_Script {
    setobjectflagfromlocalid(LOCALID_ARANTRAZ_MESSHALL_ELEANOR)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_BAIYA,10,8)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_BAIYA,10,8)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_BAIYA,MOVEMENT_TYPE_FACE_UP)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_TALA,7,3)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_TALA,7,3)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,8,3)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,8,3)
}

script SpeechSpeechSpeech_MovePlayer_Script {
    setobjectxy(LOCALID_PLAYER,9,9)
        TeleportCamera(9,9)
        applymovement(LOCALID_PLAYER,Common_Movement_FaceUp)
        waitmovement(LOCALID_PLAYER)

        createvobject(OBJ_EVENT_GFX_COMRADE_7,VOBJ_ARANTRAZ_MESSHALL_COMRADE_1,8,8)
        createvobject(OBJ_EVENT_GFX_COMRADE_9,VOBJ_ARANTRAZ_MESSHALL_COMRADE_2,11,8)
        createvobject(OBJ_EVENT_GFX_COMRADE_3,VOBJ_ARANTRAZ_MESSHALL_COMRADE_3,7,9)
        createvobject(OBJ_EVENT_GFX_COMRADE_1,VOBJ_ARANTRAZ_MESSHALL_COMRADE_4,9,10)
        createvobject(OBJ_EVENT_GFX_COMRADE_5,VOBJ_ARANTRAZ_MESSHALL_COMRADE_5,10,9)
        createvobject(OBJ_EVENT_GFX_COMRADE_2,VOBJ_ARANTRAZ_MESSHALL_COMRADE_6,7,10)

        call(SpeechSpeechSpeech_ResetFacing_Script)
}

script SpeechSpeechSpeech_CrowdLookAround_Script {
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_1,DIR_WEST)
        delay(16)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_3,DIR_EAST)
        delay(16)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_4,DIR_EAST)
        delay(16)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_6,DIR_EAST)
        delay(16)
}

script SpeechSpeechSpeech_ResetFacing_Script {
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_1,DIR_NORTH)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_2,DIR_NORTH)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_3,DIR_NORTH)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_4,DIR_NORTH)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_5,DIR_NORTH)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_6,DIR_NORTH)
}

script SpeechSpeechSpeech_ProjectAssignment_ObjectSetUp_Script {

    setobjectflagfromlocalid(LOCALID_ARANTRAZ_MESSHALL_BAIYA)
    setobjectflagfromlocalid(LOCALID_ARANTRAZ_MESSHALL_VIGRIM)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_TALA,11,17)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_TALA,11,17)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_TALA,MOVEMENT_TYPE_FACE_DOWN)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,17,15)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,17,15)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,MOVEMENT_TYPE_FACE_LEFT)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_ADAORA,16,15)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_ADAORA,16,15)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_ADAORA,MOVEMENT_TYPE_FACE_RIGHT)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_FRANK,19,6)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_FRANK,19,6)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_FRANK,MOVEMENT_TYPE_FACE_DOWN)

    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,4,6)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,4,6)
    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,MOVEMENT_TYPE_FACE_DOWN)

    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_A,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectnewmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_A,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_COMRADE_A,11,18)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_COMRADE_A,11,18)

    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_B,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectnewmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_B,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_COMRADE_B,17,16)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_COMRADE_B,17,16)

    setobjectxy(LOCALID_FREETHEINNOCENTCOMRADEA,19,7)
    setobjectxyperm(LOCALID_FREETHEINNOCENTCOMRADEA,19,7)

    setobjectmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectnewmovementtype(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,MOVEMENT_TYPE_LOOK_AROUND)
    setobjectxy(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,4,7)
    setobjectxyperm(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,4,7)
}

script SpeechSpeechSpeech_PositionPlayer_Script {
        lock
        startcutscene(JUMPPLAYER_SPEECHSPEECHSPEECH)

        applymovement(LOCALID_PLAYER,Common_Movement_WalkRight)
        applymovement(LOCALID_PLAYER,Common_Movement_WalkRight)
        fadescreen(FADE_TO_BLACK)

        call(SpeechSpeechSpeech_MovePlayer_Script)
        fadescreen(FADE_FROM_BLACK)

        goto(SpeechSpeechSpeech_Intro_Dialogue)
}

script SpeechSpeechSpeech_Intro_Dialogue {

        msgbox(format("Thank you all for coming. For all your hard work. All your support. I have a few announcements for you all."),,SPEAKER_VIGRIM)
        msgbox(format("First of all, I will be taking a leave of absence."),,SPEAKER_VIGRIM)
	closemessage

	call(SpeechSpeechSpeech_CrowdLookAround_Script)
        msgbox(format("Wait what?"),,SPEAKER_ROCKET_MEMBER_A,,EMOTE_SHOCK)
	closemessage

	msgbox(format("As our duly elected second in command, Adaora will succeed me as the Leader of The Tide for the remainder of this term."),,SPEAKER_VIGRIM)
        msgbox(format("Given her track record of service to the cause, she has my full trust and support, and I know you all feel the same."),,SPEAKER_VIGRIM,,EMOTE_HAPPY)
        msgbox(format("If there any objection, speak now!"),,SPEAKER_VIGRIM)
	closemessage
	call(SpeechSpeechSpeech_CrowdLookAround_Script)
        msgbox(format("Then it is so."),,SPEAKER_VIGRIM)
	closemessage
        call(SpeechSpeechSpeech_ResetFacing_Script)

        msgbox(format("Thank you for all you’ve done for us, Vigrim, I hope to live up to your example."),,SPEAKER_ADAORA)

        closemessage

        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_3,DIR_EAST)
        delay(16)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_5,DIR_EAST)
        msgbox(format("Can't wait to see what changes under Adaora! Are we finally going to start going on the offensive?"),SPEAKER_ROCKET_MEMBER_B,TAIL_WHISPER,EMOTE_SHOCK)
        closemessage

        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_2,DIR_EAST)
        delay(16)
        turnvobject(VOBJ_ARANTRAZ_MESSHALL_COMRADE_2,DIR_WEST)
        msgbox(format("How will The Tide feel with a public leader...?"),SPEAKER_ROCKET_MEMBER_B,TAIL_WHISPER,EMOTE_CONFUSE)
        closemessage

        msgbox(format("Yes, Adaora has my full confidence, as well as the backing of…"),,SPEAKER_VIGRIM)

        closemessage
        goto(SpeechSpeechSpeech_StartTransformation_Script)
}

script SpeechSpeechSpeech_StartTransformation_Script {

        clearobjectflagfromlocalid(LOCALID_ARANTRAZ_MESSHALL_FRANK)
        special(SpawnCameraObject)
        applymovement(LOCALID_CAMERA, moves(walk_up * 4, step_end))
        applymovement(LOCALID_ARANTRAZ_MESSHALL_VIGRIM, moves(walk_up * 3, step_end))
        waitmovement(LOCALID_CAMERA)
        delay(32)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_VIGRIM, moves(face_left, face_down, face_right, face_up, face_left, face_down, face_right, face_up, step_end))
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_VIGRIM)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_ELEANOR, moves(face_left, face_down, face_right, face_up, step_end))
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_VIGRIM)
        removeobject(LOCALID_ARANTRAZ_MESSHALL_VIGRIM)
        clearobjectflagfromlocalid(LOCALID_ARANTRAZ_MESSHALL_ELEANOR)
        addobject(LOCALID_ARANTRAZ_MESSHALL_ELEANOR)
        delay(32)

        applymovement(LOCALID_ARANTRAZ_MESSHALL_TALA,SpeechSpeechSpeech_WalkOutElite)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,SpeechSpeechSpeech_WalkOutElite)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_FRANK,SpeechSpeechSpeech_WalkOutElite)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,SpeechSpeechSpeech_WalkOutElite)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_ADAORA, moves(lock_facing_direction, walk_right * 2, unlock_facing_direction, step_end))
        applymovement(LOCALID_CAMERA, moves(walk_down * 3, step_end))
        waitmovement(LOCALID_CAMERA)

        special(RemoveCameraObject)
        goto(SpeechSpeechSpeech_EliteReveal_Dialogue)
}

script SpeechSpeechSpeech_EliteReveal_Dialogue {

        playbgm(MUS_ENCOUNTER_ELITE_FOUR,FALSE)
        addvar(VAR_STORYLINE_STATE,1)

        msgbox(format("… US! The Elite Four of Resido!"),,SPEAKER_TALA)

        closemessage

        msgbox(format("Holy shit ok, good enough for me!"),,SPEAKER_ROCKET_MEMBER_A)
        closemessage

        call(Earthquake_PlayFake_EventScript)


        call(Earthquake_WaitOutShake)

        msgbox(format("Is anybody hurt? …no? Wonderful. Let’s continue. Baiya’s restoration project has been going excellently, and we’re going to use that momentum for our next stage. It’s time to take the fight to SharpRise Capital!"),,SPEAKER_ADAORA)

        closemessage

        msgbox(format("Yeah!"),,SPEAKER_ROCKET_MEMBER_A)

        msgbox(format("Hell yes! Woo! Wait, where did Vigrim go?"),,SPEAKER_ROCKET_MEMBER_B,,EMOTE_CONFUSE)
        closemessage
        applymovement(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,SpeechSpeechSpeech_LookAround)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D)

        msgbox(format("You've all seen the damage that companies like Presto and Buzzr have done to the fabric of Resido's society. But with the combined popularity of the Champion, Elite Four and our manpower, I think we can hurt these people where it counts: their wallets. We can’t drive these parasitic companies out of the region… but all that money has to go somewhere. Let’s use that money to strengthen the region and create a brighter future for us all."),,SPEAKER_ADAORA)

        closemessage

        msgbox(format("We’re finally doing it…"),,SPEAKER_ROCKET_MEMBER_A)
        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D,SpeechSpeechSpeech_LookAround)
        msgbox(format("This is insane yo. But seriously, did Vigrim just disappear?"),,SPEAKER_ROCKET_MEMBER_B,,EMOTE_CONFUSE)
        closemessage
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_COMRADE_D)

        applymovement(LOCALID_ARANTRAZ_MESSHALL_MAGNUS,Common_Movement_WalkDown)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_MAGNUS)
        //Magnus steps forward. Adaora steps aside.

        msgbox(format("We want to begin by attacking the biggest players in Resido. Each of us will handle a different offensive plan."),,SPEAKER_MAGNUS)

        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,Common_Movement_WalkDown)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_ELEANOR)
        //Eleanor steps forward.

        msgbox(format("Eleanor will lead the charge against Presto."),,SPEAKER_MAGNUS)

        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_ELEANOR,SpeechSpeechSpeech_WalkBackwards)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_FRANK,Common_Movement_WalkDown)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_FRANK)
        //Eleanor steps back. Frank steps forward.

        msgbox(format("Frank will lead the charge against Arriba."),,SPEAKER_MAGNUS)

        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_FRANK,SpeechSpeechSpeech_WalkBackwards)
        applymovement(LOCALID_ARANTRAZ_MESSHALL_TALA,Common_Movement_WalkDown)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_TALA)
        //Eleanor steps back. Tala steps forward.

        msgbox(format("Tala will lead the charge against Buzzr."),,SPEAKER_MAGNUS)

        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_TALA,SpeechSpeechSpeech_WalkBackwards)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_TALA)

        //Tala steps back.

        msgbox(format("And I’ll be handling negotiations with the government, and operations here. Adaora will be giving each of you assignments under one of the Elite Four members, so listen up. "),,SPEAKER_MAGNUS)

        closemessage

        fadescreen(FADE_TO_BLACK)
        setvar(VAR_ARANTRAZ_STATE,POST_SPEECHSPEECH)

        TeleportCamera(9,9)
        callnative(DestroyVirtualObjects)
        call(SpeechSpeechSpeech_ProjectAssignment_ObjectSetUp_Script)

        applymovement(LOCALID_ARANTRAZ_MESSHALL_BAIYA, moves(walk_left, face_down, step_end))
        fadescreen(FADE_FROM_BLACK)
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_BAIYA)
        fadedefaultbgm

        //Screen fades to black. Screen fades back in. Elite Four members are spaced around the room, surrounded by groups of The Tide members. Baiya walks up to the player.
        msgbox(format("Damn, this shit is so crazy! The air is electric!"),,SPEAKER_BAIYA_TIDE)

        msgbox(format("It feels really awesome to start making a difference around here."),,SPEAKER_ALICIA)

        msgbox(format("Yeah!"),,SPEAKER_BAIYA_TIDE)

        if (var(VAR_STORYLINE_STATE) != STORY_RAVE_AND_SPEECH_COMPLETE)
        {
            msgbox(format("Also, are you heading to that party in CurenoPort now? I'll catch up with you in a second, I just gotta talk to Adaora first."),,SPEAKER_BAIYA_TIDE)
        }
        else
        {
            msgbox(format("By the way, you and I are free to work with whoever we want. Just talk to the Elite Four member you want to team up with. I gotta go, I told Adaora I’d help set up something."),,SPEAKER_BAIYA_TIDE)
        }
        msgbox(format("Peace!"),,SPEAKER_BAIYA_TIDE)

        closemessage

        applymovement(LOCALID_ARANTRAZ_MESSHALL_BAIYA, moves(walk_left * 7, step_end))
        waitmovement(LOCALID_ARANTRAZ_MESSHALL_BAIYA)
        removeobject(LOCALID_ARANTRAZ_MESSHALL_BAIYA)
    call(TryAutoSave)
        endcutscene
        release
        end

}

movement SpeechSpeechSpeech_WalkOutElite{
    walk_down * 2
	step_end
}

movement SpeechSpeechSpeech_WalkBackwards{
    lock_facing_direction
    walk_up
    unlock_facing_direction
	step_end
}

movement SpeechSpeechSpeech_LookAround {
    face_left
    delay_16
    face_right
    delay_16
    face_up
    step_end
}
