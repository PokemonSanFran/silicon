const PLAYER = OBJ_EVENT_ID_PLAYER

script Battle8_Script_HideBaiya
{
    setobjectflagfromlocalid(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA)
}

script Battle8_FaceGoToPlayer
{
    lock
    setvar(VAR_BATTLE_8_STATE,SAVE_BAIYA_PINTILLONHOUSE)
    playbgm(MUS_ENCOUNTER_CHAMPION,TRUE)

    playse(SE_PIN)
    moveobjecttocoords(LOCALID_PLAYER,19,17,DIR_NORTH)
    applymovement(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA,moves(emote_exclamation_mark))
    waitmovement(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA)
    waitmovement(LOCALID_PLAYER)

    goto(Battle8_ExplainAttraction_Dialogue)
}

script Battle8_InteractBaiya
{
    playbgm(MUS_ENCOUNTER_CHAMPION,TRUE)
    if (var(VAR_BATTLE_8_STATE) == NOT_INTERACTED_BAIYA)
    {
       call(Battle8_ExplainAttraction_Dialogue)
    }
    else
    {
        goto(Battle8_StartBattle_Script)
    }
}

script Battle8_ExplainAttraction_Dialogue
{
    msgbox(format("You know, I was in a good mood after breaking S Rank, and now all of a sudden…"),MSGBOX_DEFAULT,SPEAKER_BAIYA)

        if (var(VAR_TEMP_0) == 26){
            closemessage
                applymovement(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA, moves(walk_right * 6, step_end))
                waitmovement(0)
        }

    msgbox(format("Great to see you too. What rank thing are you talking about?"),,SPEAKER_ALICIA)

        msgbox(format("One of the big attractions of Resido - the Seven Sisters Challenge. It used to be a lot more popular when 1v1 battles were a novelty- before the corporations declared it as the official League format."),MSGBOX_DEFAULT,SPEAKER_BAIYA)

        msgbox(format("So, what's the challenge? And how do you get an S Rank?"),,SPEAKER_ALICIA)

        msgbox(format("The sisters are experts in 1v1, and you've got to beat all of them, in a row, in as few turns as possible. I've heard a rumor that Magnus got an SS Rank once, but those guys are on a different level… but you're not even close to that."),MSGBOX_DEFAULT,SPEAKER_BAIYA)
        closemessage

        startmenu_savescreen
        goto(Battle8_StartBattle_Script)
}

script Battle8_StartBattle_Script
{

    lock
        faceplayer
        msgbox(format("You talk a lot of shit for somebody that's never beaten me."),,SPEAKER_ALICIA)
        closemessage

        trainerbattle_no_intro(TRAINER_BAIYA_BATTLE8,format("Maybe I need to get an SS Rank to keep up with you…"))
        goto(Battle8_BaiyaDefeated_Dialogue)
}

script Battle8_BaiyaDefeated_Dialogue
{
    lock
        startcutscene(JUMPPLAYER_BATTLE8)
        setvar(VAR_BATTLE_8_STATE,DEFEATED_BAIYA_PINTILLONHOUSE)
        call(TheStrikeStrikesBack_Script_IncrementStoryVariable)

        msgbox(format("You know, it doesn't have to be like this. I'm not out to get you."),,SPEAKER_ALICIA)

        msgbox(format("Yeah, that's part of the problem. Your ignorance of the situation and your skill almost makes it worse."),MSGBOX_DEFAULT,SPEAKER_BAIYA)

        msgbox(format("What situation? I'm just doing the Gym Challenge. Just like you."),MSGBOX_NPC,SPEAKER_ALICIA)

        msgbox(format("You're collecting badges on this highly curated route, sure, but you're not engaging with the region - my home - beyond that."),MSGBOX_DEFAULT,SPEAKER_BAIYA)
        msgbox(format("This region has rich with so much culture that you won't see unless you dig deeper. If you actually care, the Seven Sisters Challenge is a good start."),MSGBOX_DEFAULT,SPEAKER_BAIYA)
        closemessage

        moveobjecttocoords(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA,8,16,DIR_WEST)
        waitmovement(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA)
        removeobject(LOCALID_PINTILLION_HOUSE_EXTERIOR_BAIYA)
        fadedefaultbgm
        call(TryAutoSave)
        endcutscene
        release
        end
}
