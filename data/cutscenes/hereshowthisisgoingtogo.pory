const PLAYER = OBJ_EVENT_ID_PLAYER
const LUCREZIA = 1 //FLAG_TEMP_1
const CHARLOTTE = 2 //FLAG_TEMP_2
const BAIYA = 3 //FLAG_TEMP_3
const OLIVER = 4 //FLAG_TEMP_4
