script HeresHowThisIsGoingToGo_CleanUpVObjects_Script {
removeobject(6)
removeobject(7)
removeobject(8)
removeobject(9)
removeobject(10)
removeobject(11)
removeobject(12)
removeobject(13)
removeobject(14)
removeobject(15)
removeobject(16)
removeobject(17)
callnative(DestroyVirtualObjects)
}

script HeresHowThisIsGoingToGo_ExplainLeagueDialogue
{
    lockall
    playbgm(MUS_ACCEPT_LETTER,FALSE)
    startcutscene(JUMPPLAYER_HERESHOWTHISISGOINGTOGO)
    applymovement(PLAYER,Common_Movement_FaceUp)
    applymovement(CHARLOTTE,Common_Movement_FaceUp)
    applymovement(BAIYA,Common_Movement_FaceUp)
    waitmovement(0)

msgbox(format("Congratulations on all of your hard work! Welcome to the first stage of the Resido League Championship!"),,SPEAKER_LUCREZIA)

msgbox(format("Woo! Yay!"))

msgbox(format("I'm sure none of you read the information email -"),,SPEAKER_LUCREZIA)

msgbox(format("Wait, I did! Did nobody else?"),,SPEAKER_CHARLOTTE)

msgbox(format("…"))

msgbox(format("So here's the simple explanation: Win five battles in a row, and you'll be the Champion! If you want the more detailed version, you can view the rules on the monitor to my right."),,SPEAKER_LUCREZIA)
closemessage

applymovement(LUCREZIA,Common_Movement_FaceLeft)
msgbox(format("Your groups, and the eventual final bracket, can also be seen on the monitor. We'll be starting with Group A in two hours. Good luck."),,SPEAKER_LUCREZIA)

    closemessage

fadescreenswapbuffers(FADE_TO_BLACK)
setvar(VAR_STORYLINE_STATE,STORY_CHAMPIONSHIP_EXPLAINED)
playse(SE_EXIT)
waitse
removeobject(LUCREZIA)
removeobject(OLIVER)
call(HeresHowThisIsGoingToGo_CleanUpVObjects_Script)
fadescreenswapbuffers(FADE_FROM_BLACK)
applymovement(BAIYA, moves(walk_down, walk_left * 7, walk_up * 2, step_end))
waitmovement(BAIYA)
	fadedefaultbgm
    call(TryAutoSave)
    endcutscene
    releaseall
    end
}

movement HeresHowThisIsGoingToGo_LeaveLockersA {
    walk_right * 5
    walk_down * 3
    walk_left * 5
    walk_down * 2
    step_end
}
movement HeresHowThisIsGoingToGo_LeaveLockersB {
    walk_right * 6
    walk_down * 4
    walk_left * 5
    walk_down * 2
    step_end
}

