const PLAYER = OBJ_EVENT_ID_PLAYER

script GroupStages_Lockers_ObjectSetUp_Script {
    setobjectxyperm(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE,10,3)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_OLIVER)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_LUCREZIA)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_RAMESH)
}

script GroupStages_Lockers_ObjectCleanUp_Script {
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_OLIVER)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_LUCREZIA)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_STADIUM_LOCKERS_RAMESH)
}

script GroupStages_Skybox_ObjectSetup_Script {
    setobjectxyperm(LOCALID_SHARPRISE_STADIUM_SKYBOX_CHARLOTTE,16,6)
    setobjectmovementtype(LOCALID_SHARPRISE_STADIUM_SKYBOX_CHARLOTTE,MOVEMENT_TYPE_FACE_DOWN)
}

script GroupStages_GreetBeforeStart_Dialogue {
    lock
        playbgm(MUS_CHARLOTTE,TRUE)
        applymovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE, moves(walk_down * 6, face_left, step_end))
        waitmovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE)
        applymovement(PLAYER,Common_Movement_FaceRight)
        waitmovement(PLAYER)
        msgbox(format("Easy peasy! Good luck in there!"),,SPEAKER_CHARLOTTE)
        closemessage
        applymovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE, moves(walk_in_place_down, step_end))
        waitmovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE)
        playse(SE_EXIT)
        waitse
        removeobject(LOCALID_SHARPRISE_STADIUM_LOCKERS_CHARLOTTE)
        fadedefaultbgm
        setvar(VAR_STORYLINE_STATE,STORY_READY_GROUP_STAGE)
        setvar(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE,PRE_BATTLE_1)
        call(TryAutoSave)
        release
        end
}

script GroupStages_PreparePlayer_Script {
    lock
        faceplayer
        msgbox(format("Once you start the Group Stage, there's no turning back. You must complete the group stage before you can leave again, and you must complete the tournament before you can leave SharpRise Stadium. Are you ready to continue?"),MSGBOX_YESNO,SPEAKER_LEAGUE_STAFF_A)
        closemessage

        if (var(VAR_RESULT) == YES){
            call(GroupStages_ChooseParty_Script)
                setflag(FLAG_SHARPRISESTADIUM_TOURNAMENT_HAPPENING)
                call(GroupStages_MoveObjects_Script)

                if (var(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE) != PRE_BATTLE_4){
                    setvar(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE,PRE_BATTLE_1)
                }

        fadeblackandsetremovewarpfadeflag
            warpsilent(MAP_SHARPRISE_STADIUM_ARENA,255,5,6)
			waitstate
        }
    release
        end
}

script GroupStages_MoveObjects_Script {
    applymovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_GUARD,Common_Movement_WalkInPlaceUp)
        opendoor(10,1)
        waitdooranim
        applymovement(LOCALID_SHARPRISE_STADIUM_LOCKERS_GUARD,Common_Movement_WalkUp)
        playse(SE_EXIT)
        waitse
        removeobject(LOCALID_SHARPRISE_STADIUM_LOCKERS_GUARD)

        getplayerxy(VAR_TEMP_0,VAR_TEMP_1)

        switch(var(VAR_TEMP_0)){
            case 9:applymovement(PLAYER, moves(walk_right, walk_up, step_end))
            case 10: applymovement(PLAYER, moves(walk_up * 2, step_end))
            case 11:applymovement(PLAYER, moves(walk_left, walk_up, step_end))
        }

    waitmovement(PLAYER)
        playse(SE_EXIT)
}

script GroupStages_ChooseParty_Script {
        special(SavePlayerParty)
        frontier_set(FRONTIER_DATA_LVL_MODE,2)
        setvar(VAR_0x8005, 3)
        special(ChoosePartyForBattleFrontier)
        dome_reduceparty
}

script GroupStages_RoundRobinMatch_Script {
    applymovement(PLAYER,Common_Movement_FaceRight)
        waitmovement(PLAYER)
        msgbox(format("this is placeholder text."),,SPEAKER_ANNOUNCER,TAIL_SHOUT)
        closemessage
        applymovement(PLAYER,Common_Movement_WalkRight)
        applymovement(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT,Common_Movement_WalkLeft)
        waitmovement(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT)
        msgbox(format("this is placeholder text."),,SPEAKER_ACE_TRAINER_M)
        closemessage

        switch (var(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE)){
            case PRE_BATTLE_1: trainerbattle_no_intro(TRAINER_SHARPRISESTADIUM_A,format(""))
            case PRE_BATTLE_2: trainerbattle_no_intro(TRAINER_SHARPRISESTADIUM_B,format(""))
            case PRE_BATTLE_3: trainerbattle_no_intro(TRAINER_SHARPRISESTADIUM_C,format(""))
        }

    goto(GroupStages_PostRoundRobinMatch_Script)
}

script GroupStages_PostRoundRobinMatch_Script {
    lock
        addvar(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE,1)
        special(LoadPlayerParty)
        special(HealPlayerParty)

        if (var(VAR_SHARPRISESTADIUM_TOURNAMENT_STATE) == PRE_BATTLE_4){
            goto(GroupStages_RoundRobinGroupComplete_Script)
        }

    msgbox(format("this is placeholder text."),,SPEAKER_ANNOUNCER)
        closemessage

        applymovement(PLAYER, moves(walk_left, face_right, step_end))
        applymovement(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT, moves(walk_right * 2, step_end))
        waitmovement(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT)
        msgbox(format("this is placeholder text."),,SPEAKER_ANNOUNCER)
        call(GroupStages_ChooseParty_Script)

        removeobject(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT)
        call(SharpriseStadium_Arena_MapScripts_OnTransition)
        addobject(LOCALID_SHARPRISE_STADIUM_ARENA_OPPONENT)

        goto(GroupStages_RoundRobinMatch_Script)
}

script GroupStages_RoundRobinGroupComplete_Script {
        setvar(VAR_STORYLINE_STATE,STORY_GROUP_STATE_COMPLETE)
        applymovement(PLAYER,GroupStages_WalkToCenterStage)
        waitmovement(PLAYER)
        msgbox(format("this is placeholder text."),SPEAKER_ANNOUNCER,TAIL_SHOUT,EMOTE_SHOCK)
        special(DoDomeConfetti)
        playse(SE_APPLAUSE)
        waitse
        fadeblackandsetremovewarpfadeflag
        warpsilent(MAP_SHARPRISE_STADIUM_LOCKERS,255,10,3)
		waitstate
}

movement GroupStages_WalkToCenterStage {
    walk_right * 3
        face_down
}
