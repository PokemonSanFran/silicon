const PLAYER = OBJ_EVENT_ID_PLAYER
const LOCALID_LEAGUEOPS_ARNAV = LOCALID_CAMERA + 1
const LOCALID_LEAGUEOPS_TECHIE = LOCALID_CAMERA + 2
const LOCALID_LEAGUEOPS_CHIEF = LOCALID_CAMERA + 6

script WelcomeToTheWarRoom_Object_Setup_Script
{
    spawnobject(OBJ_EVENT_GFX_DEVELOPER_2,LOCALID_LEAGUEOPS_ARNAV,21,26,DIR_SOUTH,3)
    spawnobject(OBJ_EVENT_GFX_PRODUCT_MANAGER_1,LOCALID_LEAGUEOPS_TECHIE,17,26,DIR_SOUTH,3)
    spawnobject(OBJ_EVENT_GFX_MART_EMPLOYEE,LOCALID_LEAGUEOPS_CHIEF,21,27,DIR_SOUTH,3)
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_RAMESH)
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_KEIYING)
}

script WelcomeToTheWarRoom_Object_Hide_Script{
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_KEIYING)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_CHARLOTTE)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_LUCREZIA)
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_RAMESH)
    setobjectxy(LOCALID_SHARPRISE_OLIVER,34,2)
    setobjectmovementtype(LOCALID_SHARPRISE_OLIVER,MOVEMENT_TYPE_FACE_DOWN)
}

script WelcomeToTheWarRoom_FaceSpeakerLucrezia {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceUp)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceUp)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceUp)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceUp)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceUp)
    applymovement(PLAYER,Common_Movement_FaceUp)
    waitmovement(0)
}

script WelcomeToTheWarRoom_FaceSpeakerArnav {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceRight)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceUp)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceRight)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceRight)
    applymovement(PLAYER,Common_Movement_FaceRight)
    waitmovement(0)
}
script WelcomeToTheWarRoom_FaceSpeakerTechie {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceLeft)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceLeft)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceUp)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceUp)
    applymovement(PLAYER,Common_Movement_FaceUp)
    waitmovement(0)
}
script WelcomeToTheWarRoom_FaceSpeakerChief {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceRight)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_WalkInPlaceFasterLeft)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceRight)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceRight)
    applymovement(PLAYER,Common_Movement_FaceRight)
    waitmovement(0)
}
script WelcomeToTheWarRoom_FaceSpeakerCharlotte {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceLeft)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceDown)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_WalkInPlaceFasterRight)
    applymovement(PLAYER,Common_Movement_FaceUp)
    waitmovement(0)
}
script WelcomeToTheWarRoom_FaceSpeakerPlayer {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceLeft)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_FaceDown)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceDown)
    applymovement(PLAYER,Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
}
script WelcomeToTheWarRoom_FaceSpeakerOliver {
    applymovement(LOCALID_LEAGUEOPS_TECHIE,Common_Movement_FaceLeft)
    applymovement(LOCALID_LEAGUEOPS_ARNAV,Common_Movement_FaceDown)
    applymovement(LOCALID_LEAGUEOPS_CHIEF,Common_Movement_FaceLeft)
    applymovement(LOCALID_SHARPRISE_OLIVER,Common_Movement_WalkInPlaceFasterRight)
    applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceUp)
    applymovement(PLAYER,Common_Movement_FaceUp)
    waitmovement(0)
}

script WelcomeToTheWarRoom_ExplainSitaution_Dialogue
{
    lock
    startcutscene(JUMPPLAYER_WELCOMETOTHEWARROOM)
    playbgm(MUS_WELCOME_TO_THE_WAR_ROOM,FALSE)
    setvar(VAR_SHARPRISESPIRE_CONFERENCE_STATE,POST_WELCOME_TO_THE_WAR_ROOM)
    setvar(VAR_FERRYBUILDING_STATE,CHIEF_LEFT_WAR_ROOM)

    call(WelcomeToTheWarRoom_FaceSpeakerLucrezia)
        applymovement(LOCALID_SHARPRISE_LUCREZIA, moves(walk_left * 2, walk_right *2, walk_left * 2, walk_right *2, face_down, step_end))
        waitmovement(0)

        msgbox(format("I read the summary email, but I want to hear the whole story."),,SPEAKER_LUCREZIA)
        closemessage

        call(WelcomeToTheWarRoom_FaceSpeakerArnav)

        msgbox(format("All major social media networks were attacked this morning. This hack is wild - we've been locked out of our accounts and the administrative teams of those networks can't get us back in."),,SPEAKER_ARNAV)

        call(WelcomeToTheWarRoom_FaceSpeakerTechie)
        buffermapname(STR_VAR_1,MAP_NAVAL_BASE_EXTERIOR)
        msgbox(format("The new owners of our accounts have been pushing a narrative about SharpRise Capital's “crimes against the region”. They're calling for everybody to boycott the League and the upcoming Championship. We've found evidence that the perpetrators are at {STR_VAR_1}. "),,SPEAKER_TECH)

        call(WelcomeToTheWarRoom_FaceSpeakerChief)
        buffermapname(STR_VAR_1,MAP_NAVAL_BASE_EXTERIOR)
        msgbox(format("We've long theorized that {STR_VAR_1} is The Tide's primary base of operations so we've got reason to believe that they're the ones behind this cyber-attack. We have authorization to raid their headquarters and are looking -"),,SPEAKER_CHIEF)

        call(WelcomeToTheWarRoom_FaceSpeakerLucrezia)
        buffermapname(STR_VAR_1,MAP_SHARPRISE_STADIUM_ARENA)
        msgbox(format("Charlotte, {PLAYER} you really impressed me back at {STR_VAR_1}, and we'd like you to assist as well. You'll work under Chief Bill, and help us shut down these terrorists once and for all."),,SPEAKER_LUCREZIA)

        call(WelcomeToTheWarRoom_FaceSpeakerCharlotte)
        msgbox(format("Hell yeah, we'd love to."),,SPEAKER_CHARLOTTE)

        call(WelcomeToTheWarRoom_FaceSpeakerPlayer)
        msgbox(format("I'm happy to help."),,SPEAKER_ALICIA)

        call(WelcomeToTheWarRoom_FaceSpeakerLucrezia)
        msgbox(format("Everybody understand what they're doing?"),,SPEAKER_LUCREZIA)
        closemessage

        call(WelcomeToTheWarRoom_FaceSpeakerChief)
        msgbox(format("We've already outlined a battle plan. Kids, you're gonna come with me and take the ferry."),,SPEAKER_CHIEF)

        call(WelcomeToTheWarRoom_FaceSpeakerCharlotte)
        buffermovename(STR_VAR_1,MOVE_FLY)
        msgbox(format("Why can't we just {STR_VAR_1} over?"),,SPEAKER_CHARLOTTE)
        closemessage

        call(WelcomeToTheWarRoom_FaceSpeakerChief)
        msgbox(format("Glad to hear I'm answering to kids now! We're splitting up our force into cells to avoid detection and increase agility. "),,SPEAKER_CHIEF)

        call(WelcomeToTheWarRoom_FaceSpeakerCharlotte)
        msgbox(format("…got it Chief."),,SPEAKER_CHARLOTTE)
        closemessage

        call(WelcomeToTheWarRoom_FaceSpeakerChief)
        buffermapname(STR_VAR_1,MAP_FERRYBUILDING)
        buffermapname(STR_VAR_2,MAP_HALAI_ISLAND)
        msgbox(format("Great. We'll start the operation as soon as you're ready. Meet me at {STR_VAR_1}, en route to {STR_VAR_2}."),,SPEAKER_CHIEF)
        closemessage

        applymovement(LOCALID_LEAGUEOPS_CHIEF, moves(walk_right, walk_down * 4, walk_left * 2, walk_down * 3, step_end))
        delay(30)
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_LEAGUEOPS_CHIEF)
        fadescreenswapbuffers(FADE_FROM_BLACK)

        call(WelcomeToTheWarRoom_FaceSpeakerLucrezia)
        msgbox(format("Charlotte, {PLAYER}, don't let the chief's attitude get in the way. You've all got orders, so let's get to it."),,SPEAKER_LUCREZIA)
        closemessage

        applymovement(LOCALID_LEAGUEOPS_ARNAV, moves(walk_right, walk_down * 5, step_end))
        applymovement(LOCALID_LEAGUEOPS_TECHIE, moves(walk_left, walk_down * 5, step_end))
        applymovement(LOCALID_SHARPRISE_LUCREZIA, moves(walk_right * 3, walk_down * 5, step_end))

        delay(30)
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_SHARPRISE_LUCREZIA)
        removeobject(LOCALID_LEAGUEOPS_ARNAV)
        removeobject(LOCALID_LEAGUEOPS_TECHIE)
        fadescreenswapbuffers(FADE_FROM_BLACK)

        applymovement(LOCALID_SHARPRISE_OLIVER, moves(walk_left, walk_down, face_right, step_end))
        applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceLeft)
        applymovement(PLAYER,Common_Movement_FaceLeft)
        waitmovement(LOCALID_SHARPRISE_OLIVER)

        msgbox(format("Thanks again you two. Be careful out there!"),,SPEAKER_OLIVER)
        closemessage

        applymovement(LOCALID_SHARPRISE_OLIVER, moves(walk_down * 4, walk_right * 3, walk_down * 3, step_end))
        delay(30)
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_SHARPRISE_OLIVER)
        fadescreenswapbuffers(FADE_FROM_BLACK)

        applymovement(LOCALID_SHARPRISE_CHARLOTTE,Common_Movement_FaceDown)
        applymovement(PLAYER,Common_Movement_FaceUp)

        buffermapname(STR_VAR_1,MAP_FERRYBUILDING)
        msgbox(format("I'm going to head over to {STR_VAR_1}. Want to come with?"),MSGBOX_YESNO,SPEAKER_CHARLOTTE)
        endcutscene
        fadedefaultbgm

        if (var(VAR_RESULT) == NO)
        {
            msgbox(format("Okay, I'll meet you over there."),,SPEAKER_CHARLOTTE)
            closemessage

            applymovement(LOCALID_SHARPRISE_CHARLOTTE, moves(walk_left, walk_down * 4, step_end))
            fadescreen(FADE_TO_BLACK)
            removeobject(LOCALID_SHARPRISE_CHARLOTTE)
            fadescreen(FADE_FROM_BLACK)
            release
            end
        }
        else
        {
            closemessage

            fadeblackandsetremovewarpfadeflag
            warpsilent(MAP_ROUTE4,18,90)
			waitstate
        }
}

