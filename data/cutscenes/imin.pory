script ImIn_PostWarpSplit_Dialogue
{
    lock
    startcutscene(JUMPPLAYER_IMIN_POSTWARP)
        setvar(VAR_TOWER_RAID_STATE,TEAM_ENTERED_SHARPRISESPIRE)

        applymovement(PLAYER,Common_Movement_WalkUp2)

        msgbox(format("We're all in."),,SPEAKER_FRANK)

        msgbox(format("Let the march begin… good luck!"),,SPEAKER_ADAORA,,,PHONE_ON)

        msgbox(format("Magnus, let's go secure the studio."),,SPEAKER_FRANK)
        closemessage

        applymovement(LOCALID_SHARPRISE_SPIRE_LOBBY_FRANK,ImIn_WalkAwayFromWarpA)
        applymovement(LOCALID_SHARPRISE_SPIRE_LOBBY_MAGNUS,ImIn_WalkAwayFromWarpA)

        msgbox(format("This place is probably crawling with Trainers. Let's spread out."),,SPEAKER_KAREN)

        msgbox(format("Lucrezia has an office on the 38th floor, I've been there myself."),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("38th floor then, let's move!"),,SPEAKER_TALA)
        closemessage

        applymovement(LOCALID_SHARPRISE_SPIRE_LOBBY_TALA,ImIn_WalkAwayFromWarpC)
        applymovement(LOCALID_SHARPRISE_SPIRE_LOBBY_ELEANOR,ImIn_WalkAwayFromWarpC)
        applymovement(LOCALID_SHARPRISE_SPIRE_LOBBY_BAIYA,ImIn_WalkAwayFromWarpC)
        delay(30)

        fadescreen(FADE_TO_BLACK)
        removeobject(LOCALID_SHARPRISE_SPIRE_LOBBY_TALA)
        removeobject(LOCALID_SHARPRISE_SPIRE_LOBBY_MAGNUS)
        removeobject(LOCALID_SHARPRISE_SPIRE_LOBBY_FRANK)
        removeobject(LOCALID_SHARPRISE_SPIRE_LOBBY_ELEANOR)
        removeobject(LOCALID_SHARPRISE_SPIRE_LOBBY_BAIYA)
        fadescreen(FADE_FROM_BLACK)
        call(TryAutoSave)
        endcutscene
        release
        end
}

script ImIn_OfficeReveal_Dialogue
{
    lock
    setvar(VAR_TOWER_RAID_STATE,SAVE_CHARLOTTE_SHARPRISESPIRE)
    playbgm(MUS_ENCOUNTER_MAY,TRUE)

    applymovement(PLAYER, moves(walk_down * 4, step_end))
    waitmovement(PLAYER)

    msgbox(format("Do you like my new office?"),,SPEAKER_CHARLOTTE_SHARPRISE)
    msgbox(format("Charlotte, what are you doing here?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
    msgbox(format("I chose not to align myself with ghetto trash. Turns out if you stick with the good guys, you get a well-paying job and a corner office."),,SPEAKER_CHARLOTTE_SHARPRISE)
    msgbox(format("Wait, trash? Did you hear what these people did to HalaiIsland?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
    msgbox(format("The Tide was destroying this region with their idiocy. We wiped ‘em out. And you decided to help them? After everything SharpRise Capital did for you?"),,SPEAKER_CHARLOTTE_SHARPRISE)
    msgbox(format("So you just don't care that you work for murderers? What is wrong with you?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
    msgbox(format("All this helping people shit is nice and all, but I came here to the best. I don't care to get bogged down in all your allegations and melodrama. If I've done something wrong, I'll wrestle with it AFTER I reach the top. I'll donate to a homeless shelter or something."),,SPEAKER_CHARLOTTE_SHARPRISE)
    msgbox(format("You're the worst…Daddy won't be able to buy you your way out of this one."),MSGBOX_DEFAULT,SPEAKER_ALICIA)
    closemessage

    applymovement(LOCALID_SHARPRISE_CHARLOTTE, moves(walk_right, walk_up * 3, face_left, step_end))
    waitmovement(LOCALID_SHARPRISE_CHARLOTTE)
    applymovement(PLAYER,Common_Movement_FaceRight)

    startmenu_savescreen
    goto(ImIn_StartCharlotteBattle_Script)
}

script ImIn_StartCharlotteBattle_Script
{
    msgbox(format("I'll bet you're missing something anyway, but it doesn't matter. I won't miss, {PLAYER}. I'm finally sending you back to the trash heap you came from!"),,SPEAKER_CHARLOTTE_SHARPRISE)
    closemessage

    trainerbattle_no_intro(TRAINER_CHARLOTTE_IMIN,format("How does this keep happening?!?!?"))
    goto(ImIn_CharlotteDefeated_Dialogue)
}

script ImIn_CharlotteDefeated_Dialogue {
    lock
    startcutscene(JUMPPLAYER_IMIN_POSTRIVAL)
        setvar(VAR_TOWER_RAID_STATE,DEFEATED_CHARLOTTE_SHARPRISESPIRE)

        msgbox(format("Where's Lucrezia?!"),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("What's the secret? What am I missing? Why do I keep LOSING?"),,SPEAKER_CHARLOTTE_SHARPRISE)

        msgbox(format("Everything about SharpRise is a lie. You're not any stronger. The region isn't any better. But as long as they have corporate stooges like you they're gonna get richer and people will suffer for it. Tell me where Lucrezia is."),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("…That warp panel goes to the skydeck… Her real office is there."),,SPEAKER_CHARLOTTE_SHARPRISE)
                call(ImIn_RevealLucreziaWarp_Script)
        closemessage
        call(TryAutoSave)
        endcutscene
        release
        end
}

script ImIn_PostCharlotteBattle_Interact_Dialogue
{
    msgbox(format("…all that training…"),,SPEAKER_CHARLOTTE_SHARPRISE)
    closemessage
    release
    end
}

script ImIn_InteractCharlotte_Event_Script
{
    lock
    faceplayer
    goto_if_eq(VAR_TOWER_RAID_STATE,SAVE_CHARLOTTE_SHARPRISESPIRE,ImIn_StartCharlotteBattle_Script)
    goto_if_ne(VAR_TOWER_RAID_STATE,SAVE_CHARLOTTE_SHARPRISESPIRE,ImIn_PostCharlotteBattle_Interact_Dialogue)
}

movement ImIn_SpreadOutHouse {
    walk_down * 6
        step_end
}

movement ImIn_WalkAwayFromWarpA {
        walk_fast_up
        walk_fast_right * 13
        step_end
}

movement ImIn_WalkAwayFromWarpB {
    walk_down * 4
        step_end
}

movement ImIn_WalkAwayFromWarpC {
        walk_fast_right * 7
        step_end
}

movement ImIn_WalkAwayFromWarpD {
    walk_down * 3
        walk_left * 3
        walk_down * 3
        step_end
}

movement ImIn_WalkAwayFromWarpE {
    walk_left * 2
        walk_down * 4
        step_end
}

