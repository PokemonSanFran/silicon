const LOCALID_IMIN_BAIYA_MON = LOCALID_CAMERA + 2
const PLAYER = OBJ_EVENT_ID_PLAYER

script ImIn_Script_HideEntireQiuRaidParty
{
    setobjectflagfromlocalid(LOCALID_QIU_BAIYA)
    call(ImIn_Script_HideQiuFrank)
    call(ImIn_Script_HideQiuEleanor)
    call(ImIn_Script_HideQiuMagnus)
    call(ImIn_Script_HideQiuTala)
}

script ImIn_Script_HideQiuFrank
{
    setobjectflagfromlocalid(LOCALID_QIU_FRANK)
}
script ImIn_Script_HideQiuEleanor
{
    setobjectflagfromlocalid(LOCALID_QIU_ELEANOR)
}
script ImIn_Script_HideQiuMagnus
{
    setobjectflagfromlocalid(LOCALID_QIU_MAGNUS)
}
script ImIn_Script_HideQiuTala
{
    setobjectflagfromlocalid(LOCALID_QIU_TALA)
}

script ImIn_Script_HideQiuSpecificRaidPartyMembers
{
    call_if_quest_not_complete(QUEST_PERSUASIVEPASSENGER,ImIn_Script_HideQiuFrank)
    call_if_quest_not_complete(QUEST_BREAKTHEINTERNET,ImIn_Script_HideQiuTala)
    call_if_quest_not_complete(QUEST_WAREHOUSEWARFARE,ImIn_Script_HideQiuEleanor)
}

script ImIn_Script_HideAllLeagueOps
{
    setobjectflagfromlocalid(LOCALID_SHARPRISE_OLIVER)
    setobjectflagfromlocalid(LOCALID_SHARPRISE_LUCREZIA)
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_RAMESH)
    setobjectflagfromlocalid(LOCALID_LEAGUEOPS_KEIYING)
}

script ImIn_PreCharlotte_Object_Script
{
    call(ImIn_Script_HideAllLeagueOps)
    setobjectxy(LOCALID_SHARPRISE_CHARLOTTE,6,56)
    setobjectxyperm(LOCALID_SHARPRISE_CHARLOTTE,6,56)
    setobjectmovementtype(LOCALID_SHARPRISE_CHARLOTTE,MOVEMENT_TYPE_FACE_UP)
}

script ImIn_SaveCharlotte_Object_Script{
    call(ImIn_Script_HideAllLeagueOps)
    setobjectxy(LOCALID_SHARPRISE_CHARLOTTE,7,53)
    setobjectxyperm(LOCALID_SHARPRISE_CHARLOTTE,7,53)
    setobjectmovementtype(LOCALID_SHARPRISE_CHARLOTTE,MOVEMENT_TYPE_FACE_LEFT)
}

script ImIn_RevealLucreziaWarp_Script{
    if (var(VAR_TOWER_RAID_STATE) > SAVE_CHARLOTTE_SHARPRISESPIRE){
        setmetatile(10,55,0x2DF,FALSE)
        special(DrawWholeMapView)
    }
    return
}

script ImIn_DestroyWall_Script
{
    setmetatile(15,13,0x0A7,FALSE)
    special(DrawWholeMapView)
}

script ImIn_ReleaseFromBall_Script
{
    playse(SE_BALL_OPEN)
    callnative(ImIn_LoadBaiyaMon)
    spawnobject(OBJ_EVENT_GFX_VAR_0,LOCALID_IMIN_BAIYA_MON,16,13,MOVEMENT_TYPE_WALK_IN_PLACE_LEFT)
    waitse
    callnative(ImIn_GetBaiyaMonCry)
    waitmoncry
}

script ImIn_ObjectSetUp_InsideHouse_Script {
    setobjectxyperm(LOCALID_RAMESH_HOUSE_TALA,15,4)
    setobjectxyperm(LOCALID_RAMESH_HOUSE_MAGNUS,16,3)
    setobjectxyperm(LOCALID_RAMESH_HOUSE_FRANK,17,4)
    setobjectxyperm(LOCALID_RAMESH_HOUSE_ELEANOR,18,5)
    setobjectxyperm(LOCALID_RAMESH_HOUSE_BAIYA,19,3)
}

script ImIn_MoveObject_BeforeWarp_Script {
    addobject(LOCALID_RAMESH_HOUSE_TALA)
        addobject(LOCALID_RAMESH_HOUSE_MAGNUS)
        addobject(LOCALID_RAMESH_HOUSE_FRANK)
        addobject(LOCALID_RAMESH_HOUSE_ELEANOR)
        addobject(LOCALID_RAMESH_HOUSE_BAIYA)

        setobjectxy(LOCALID_RAMESH_HOUSE_TALA,10,3)
        setobjectxy(LOCALID_RAMESH_HOUSE_FRANK,10,4)
        setobjectxy(LOCALID_RAMESH_HOUSE_ELEANOR,12,3)
        setobjectxy(LOCALID_RAMESH_HOUSE_BAIYA,12,4)
        setobjectxy(LOCALID_RAMESH_HOUSE_MAGNUS,11,2)

        setobjectxy(PLAYER,11,4)
        TeleportCamera(11,4)

        applymovement(LOCALID_RAMESH_HOUSE_TALA,Common_Movement_FaceRight)
        applymovement(LOCALID_RAMESH_HOUSE_FRANK,Common_Movement_FaceRight)
        applymovement(LOCALID_RAMESH_HOUSE_ELEANOR,Common_Movement_FaceLeft)
        applymovement(LOCALID_RAMESH_HOUSE_MAGNUS,Common_Movement_FaceDown)
        applymovement(LOCALID_RAMESH_HOUSE_BAIYA,Common_Movement_FaceLeft)
        waitmovement(LOCALID_RAMESH_HOUSE_MAGNUS)
}

script ImIn_CheckPlayer_Script
{
    if (var(VAR_STORYLINE_STATE) != STORY_BEFORE_RAMESH_BREAKIN)
    {
        release
        end
    }
    goto(ImIn_StartHouseBreak_Script)
}

script ImIn_StartHouseBreak_Script
{
    lock
    startcutscene(JUMPPLAYER_IMIN_BREAKIN)
    setvar(VAR_TOWER_RAID_STATE,BROKEN_IN_RAMESH)

    applymovement(PLAYER, moves(walk_up, step_end))
    waitmovement(PLAYER)

    applymovement(LOCALID_QIU_FRANK,Common_Movement_FaceDown)

    msgbox(format("We're certain nobody is home?"),,SPEAKER_FRANK)
    msgbox(format("Ramesh hasn't left work early a day in their life. SharpRise Capital is led by monsters, but at least they're hard-working monsters."),,SPEAKER_MAGNUS)
    buffermapname(STR_VAR_1,MAP_PERLACIA_CITY)
    msgbox(format("We're in position at {STR_VAR_1}. Ready to mobilize this diversion when you are."),,SPEAKER_ADAORA,,,PHONE_ON)
    closemessage

    applymovement(LOCALID_QIU_BAIYA, moves(walk_right, walk_down * 5, step_end))
    waitmovement(LOCALID_QIU_BAIYA)

    applymovement(LOCALID_QIU_TALA,Common_Movement_FaceRight)
    applymovement(LOCALID_QIU_MAGNUS,Common_Movement_FaceRight)
    applymovement(LOCALID_QIU_FRANK,Common_Movement_FaceRight)
    applymovement(LOCALID_QIU_ELEANOR,Common_Movement_FaceRight)
    applymovement(PLAYER,Common_Movement_FaceRight)
    waitmovement(PLAYER)

    msgbox(format("The side door will definitely work, didn't see an alarm either."),,SPEAKER_BAIYA_TIDE)

    msgbox(format("Let's move then!"),,SPEAKER_TALA)
    closemessage

    applymovement(LOCALID_QIU_BAIYA, moves(walk_up * 4, face_down, step_end))
    waitmovement(LOCALID_QIU_BAIYA)

    call(ImIn_ReleaseFromBall_Script)

    buffermovename(STR_VAR_2,MOVE_BRICK_BREAK)
    msgbox(format("{STR_VAR_1}, {STR_VAR_2}!"),,SPEAKER_BAIYA_TIDE)
    closemessage

    playse(SE_M_BRICK_BREAK)
    applymovement(LOCALID_IMIN_BAIYA_MON, moves(lock_facing_direction, walk_left, walk_right, step_end))
    waitse
    waitmovement(LOCALID_IMIN_BAIYA_MON)
    call(ImIn_DestroyWall_Script)

    applymovement(LOCALID_IMIN_BAIYA_MON, moves(walk_left, step_end))
    applymovement(LOCALID_QIU_TALA, moves(walk_right * 5, walk_up * 4, walk_left, step_end))
    applymovement(LOCALID_QIU_MAGNUS, moves(walk_right, walk_up * 4, walk_left, step_end))
    applymovement(LOCALID_QIU_FRANK, moves(walk_right * 4, walk_up * 3, walk_left, step_end))
    applymovement(LOCALID_QIU_ELEANOR, moves(walk_up * 4, walk_left, step_end))
    applymovement(LOCALID_QIU_BAIYA, moves(walk_down, walk_left, step_end))

    playse(SE_EXIT)
    playse(SE_EXIT)
    playse(SE_EXIT)
    waitmovement(LOCALID_QIU_BAIYA)

    removeobject(LOCALID_IMIN_BAIYA_MON)
    removeobject(LOCALID_QIU_TALA)
    removeobject(LOCALID_QIU_MAGNUS)
    removeobject(LOCALID_QIU_FRANK)
    removeobject(LOCALID_QIU_ELEANOR)
    removeobject(LOCALID_QIU_BAIYA)
    waitse
    call(TryAutoSave)
    endcutscene
    release
    end
}

script ImIn_UnlockDoor_Script
{
    setmetatile(11,6,0x228,TRUE)
    special(DrawWholeMapView)
}

script Imin_BeginHouseSearch_Script
{
    lock
        setvar(VAR_TOWER_RAID_STATE,SEARCHING_RAMESH_HOUSE)
        msgbox(format("Okay, spread out. We're looking for the warp panel. Use the walkies if you see anything."),,SPEAKER_TALA)
        closemessage

        applymovement(LOCALID_RAMESH_HOUSE_TALA,ImIn_SpreadOutHouse)
        applymovement(LOCALID_RAMESH_HOUSE_MAGNUS,ImIn_SpreadOutHouse)
        applymovement(LOCALID_RAMESH_HOUSE_FRANK,ImIn_SpreadOutHouse)
        applymovement(LOCALID_RAMESH_HOUSE_ELEANOR,ImIn_SpreadOutHouse)
        applymovement(LOCALID_RAMESH_HOUSE_BAIYA,ImIn_SpreadOutHouse)
        waitmovement(LOCALID_RAMESH_HOUSE_BAIYA)

        setobjectxy(LOCALID_RAMESH_HOUSE_TALA,2,7)
        setobjectxy(LOCALID_RAMESH_HOUSE_MAGNUS,18,9)
        setobjectxy(LOCALID_RAMESH_HOUSE_FRANK,10,11)
        setobjectxy(LOCALID_RAMESH_HOUSE_ELEANOR,15,17)
        setobjectxy(LOCALID_RAMESH_HOUSE_BAIYA,3,13)

        setobjectxyperm(LOCALID_RAMESH_HOUSE_TALA,2,7)
        setobjectxyperm(LOCALID_RAMESH_HOUSE_MAGNUS,18,9)
        setobjectxyperm(LOCALID_RAMESH_HOUSE_FRANK,10,11)
        setobjectxyperm(LOCALID_RAMESH_HOUSE_ELEANOR,15,17)
        setobjectxyperm(LOCALID_RAMESH_HOUSE_BAIYA,3,13)

        release
        end
}

script ImIn_FindLockedDoor_Script
{
    lock

        setvar(VAR_TOWER_RAID_STATE,FOUND_RAMESH_WARP_DOOR)

        msgbox(format("I found a door with an electronic lock! It takes six digits."),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("Guess we're all looking for any numbers that seem important. No way it's just their birthday, right?"),,SPEAKER_BAIYA_TIDE)
                closemessage

        release
        end
}

script ImIn_InteractDoor_Script
{
    checkitem(ITEM_MAGMA_EMBLEM)

        if (var(VAR_RESULT)){
            goto(ImIn_EnterCorrectCode_Script)
        }

    msgbox(format("Find the thing to unlock this door!"),MSGBOX_AUTOCLOSE)
}

script ImIn_EnterCorrectCode_Script
{
    lock
    setvar(VAR_TOWER_RAID_STATE,RAMESH_WARP_DOOR_UNLOCKED)
    setvar(VAR_STORYLINE_STATE,STORY_WARP_TILE_ACCESSIBLE)
    setvar(VAR_SHARPRISESPIRE_CONFERENCE_STATE,TRUE_RAID_START)


    playse(SE_DING_DONG)
    waitse
    playse(SE_SLIDING_DOOR)
    call(ImIn_UnlockDoor_Script)
    delay(16)

    fadescreen(FADE_TO_BLACK)
    call(ImIn_MoveObject_BeforeWarp_Script)
    fadescreen(FADE_FROM_BLACK)

    msgbox(format("Adaora, we're in. Everybody remember the plan?"),,SPEAKER_BAIYA)

    buffermapname(STR_VAR_1,MAP_SHARPRISE_SPIRE_LOBBY)
    msgbox(format("Once you're all through the panel, I'll lead the diversion protest at the front doors of {STR_VAR_1}. Security will be focused on us, letting you to the executive levels and hopefully find Lucrezia."),,SPEAKER_ADAORA,,,PHONE_ON)

    msgbox(format("I'm too old for scaling mountains. I can get into the production studio and get ready to broadcast that confession."),,SPEAKER_MAGNUS)

    msgbox(format("These people are fighting to kill. Stay safe."),,SPEAKER_BAIYA)
            closemessage

    applymovement(LOCALID_RAMESH_HOUSE_TALA,Common_Movement_WalkRight)
    waitmovement(LOCALID_RAMESH_HOUSE_TALA)
    removeobject(LOCALID_RAMESH_HOUSE_TALA)
    playse(SE_WARP_OUT)
    applymovement(LOCALID_RAMESH_HOUSE_FRANK, moves(walk_up, walk_right, step_end))
    waitmovement(LOCALID_RAMESH_HOUSE_FRANK)
    removeobject(LOCALID_RAMESH_HOUSE_FRANK)
    playse(SE_WARP_OUT)
    applymovement(LOCALID_RAMESH_HOUSE_ELEANOR,Common_Movement_WalkLeft)
    waitmovement(LOCALID_RAMESH_HOUSE_ELEANOR)
    removeobject(LOCALID_RAMESH_HOUSE_ELEANOR)
    playse(SE_WARP_OUT)
    applymovement(LOCALID_RAMESH_HOUSE_MAGNUS,Common_Movement_WalkDown)
    waitmovement(LOCALID_RAMESH_HOUSE_MAGNUS)
    removeobject(LOCALID_RAMESH_HOUSE_MAGNUS)
    playse(SE_WARP_OUT)
    applymovement(LOCALID_RAMESH_HOUSE_BAIYA, moves(walk_up, walk_left, step_end))
    waitmovement(LOCALID_RAMESH_HOUSE_BAIYA)
    removeobject(LOCALID_RAMESH_HOUSE_BAIYA)
    playse(SE_WARP_OUT)
    release
    end
}

