script WaitEvenThen_TurnOnMachine_Script {
    setmetatile(32, 2, 0x8D8, TRUE)
        setmetatile(33, 2, 0x8D9, TRUE)
        setmetatile(34, 2, 0x8DA, TRUE)
        setmetatile(35, 2, 0x8DB, TRUE)
        setmetatile(32, 3, 0x8E0, TRUE)
        setmetatile(33, 3, 0x8E1, TRUE)
        setmetatile(34, 3, 0x8E2, TRUE)
        setmetatile(35, 3, 0x8E3, TRUE)
        special(DrawWholeMapView)
}

script WaitEvenThen_BossSetUp_Script {
        clearobjectflagfromlocalid(LOCALID_PARC_BAIYA)
        clearobjectflagfromlocalid(LOCALID_PARC_ADAORA)
        clearobjectflagfromlocalid(LOCALID_PARC_MAGNUS)

        addobject(LOCALID_PARC_ADAORA)
        addobject(LOCALID_PARC_MAGNUS)
        addobject(LOCALID_PARC_BAIYA)

        setobjectmovementtype(LOCALID_PARC_MAGNUS,MOVEMENT_TYPE_FACE_UP)
        setobjectxyperm(LOCALID_PARC_MAGNUS,39,4)
        setobjectxy(LOCALID_PARC_MAGNUS,39,4)

        setobjectmovementtype(LOCALID_PARC_BAIYA,MOVEMENT_TYPE_FACE_UP)
        setobjectxy(LOCALID_PARC_BAIYA,34,6)
        setobjectxyperm(LOCALID_PARC_BAIYA,34,6)

        setobjectmovementtype(LOCALID_PARC_ADAORA,MOVEMENT_TYPE_FACE_UP)
        setobjectxy(LOCALID_PARC_ADAORA,33,7)
        setobjectxyperm(LOCALID_PARC_ADAORA,33,7)

        setobjectxy(LOCALID_PARC_MON_BOSS,33,5)
        setobjectxyperm(LOCALID_PARC_MON_BOSS,33,5)
}

script WaitEvenThen_ObjectSetUp_Script {
    fadescreenswapbuffers(FADE_TO_BLACK)

        setobjectxy(LOCALID_PLAYER,25,4)
        TeleportCamera(25,4)
        applymovement(LOCALID_PLAYER,Common_Movement_FaceRight)

        clearobjectflagfromlocalid(LOCALID_PARC_BAIYA)
        clearobjectflagfromlocalid(LOCALID_PARC_ADAORA)
        clearobjectflagfromlocalid(LOCALID_PARC_MAGNUS)

        addobject(LOCALID_PARC_BAIYA)
        setobjectxy(LOCALID_PARC_BAIYA,25,5)
        applymovement(LOCALID_PARC_BAIYA,Common_Movement_FaceRight)

        addobject(LOCALID_PARC_ADAORA)
        setobjectxy(LOCALID_PARC_ADAORA,24,4)
        applymovement(LOCALID_PARC_ADAORA,Common_Movement_FaceRight)

        addobject(LOCALID_PARC_MAGNUS)
        setobjectxy(LOCALID_PARC_MAGNUS,24,5)
        applymovement(LOCALID_PARC_MAGNUS,Common_Movement_FaceRight)

        fadescreenswapbuffers(FADE_FROM_BLACK)
}

script WaitEvenThen_PrepareBossEncounter_Dialogue {
    lock
        call(WaitEvenThen_ObjectSetUp_Script)
        playbgm(MUS_OKAY_LETS_FIX_IT,TRUE)

        applymovement(LOCALID_PLAYER, moves(walk_right * 6, walk_down * 2, walk_right * 2, face_up, step_end))
        applymovement(LOCALID_PARC_BAIYA, moves(walk_right * 6, walk_down, walk_right * 3, face_up, step_end))
        applymovement(LOCALID_PARC_ADAORA, moves(walk_right * 7, walk_down * 3, walk_right * 2, face_up, step_end))
        applymovement(LOCALID_PARC_MAGNUS, moves(walk_right * 7, walk_down * 2, walk_right * 3, face_up, step_end))
        waitmovement(LOCALID_PARC_MAGNUS)

        msgbox(format("I found the access commands. I think I can turn this off, but I’m certain that it's going to attack us when we do."),,SPEAKER_MAGNUS)

        msgbox(format("{PLAYER} and I can handle it. Let it rip!"),,SPEAKER_BAIYA_TIDE)

        closemessage

        applymovement(LOCALID_PARC_MAGNUS, moves(walk_right, walk_up, walk_right * 2, walk_up * 2, walk_right * 2, face_up, step_end))
        waitmovement(LOCALID_PARC_MAGNUS)

        playse(SE_PC_LOGIN)
        waitse
        delay(10)
        playse(SE_PC_ON)
        waitse

        call(WaitEvenThen_TurnOnMachine_Script)
        applymovement(LOCALID_PARC_MON_BOSS,Common_Movement_WalkDown)

        playmoncry(SPECIES_EXCADRILL,CRY_MODE_ENCOUNTER)
        waitmoncry
        setvar(VAR_PARC_STATE,SAVE_BEFORE_DYNAMAX)

        msgbox(format("ROAR"),MSGBOX_AUTOCLOSE)

        setobjectxy(LOCALID_PARC_BAIYA,34,6)
        setobjectxyperm(LOCALID_PARC_BAIYA,34,6)
        setobjectxy(LOCALID_PARC_ADAORA,33,7)
        setobjectxyperm(LOCALID_PARC_ADAORA,33,7)
        setobjectxyperm(LOCALID_PARC_MAGNUS,39,4)
        setobjectxy(LOCALID_PARC_MAGNUS,39,4)
        setobjectnewmovementtype(LOCALID_PARC_MAGNUS,MOVEMENT_TYPE_FACE_UP)
        startmenu_savescreen
        goto(WaitEvenThen_BossEncounter_Script)
}

script WaitEvenThen_MovePlayerToBoss {
        getplayerxy(VAR_TEMP_0,VAR_TEMP_1)

    if (var(VAR_TEMP_0) != 33 || (var(VAR_TEMP_1) != 6)){
        fadescreenswapbuffers(FADE_TO_BLACK)
        setobjectxy(LOCALID_PLAYER,33,6)
        TeleportCamera(33,6)
        applymovement(LOCALID_PLAYER,Common_Movement_FaceUp)
        fadescreenswapbuffers(FADE_FROM_BLACK)
    }
        goto(WaitEvenThen_BossEncounter_Script)
}

script WaitEvenThen_BossEncounter_Script {
        playbgm(MUS_OKAY_LETS_FIX_IT,TRUE)
    setwildbattle(SPECIES_EXCADRILL,70,ITEM_MUSCLE_BAND,SPECIES_NONE)
        playmoncry(SPECIES_EXCADRILL,CRY_MODE_ENCOUNTER)
        delay(40)
        waitmoncry
        setflag(FLAG_SYS_CTRL_OBJ_DELETE)
        multi_fixed_wild(PARTNER_BAIYA)
        clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
        specialvar(VAR_RESULT, GetBattleOutcome)
        switch (var (VAR_RESULT)) {
            case B_OUTCOME_CAUGHT:
            case B_OUTCOME_WON:
                goto(WaitEvenThen_ClearBossPokemon_Script)
        }
    release
        end
}

script WaitEvenThen_ClearBossPokemon_Script
{
        setvar(VAR_PARC_STATE,DEFEATED_DYNAMAX)

        lock
        startcutscene(JUMPPLAYER_WAITEVENTHEN)
        closemessage
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_PARC_MON_BOSS)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        goto(WaitEvenThen_PostBossDialogue)
}

script WaitEvenThen_PostBossDialogue {
    lock

        setvar(VAR_STORYLINE_STATE,STORY_POST_DYNAMAX_BOSS)
        setvar(VAR_HALAI_ISLAND_STATE,POST_THIS_ISNT_RANDOM)

        applymovement(LOCALID_PLAYER,Common_Movement_FaceDown)
        applymovement(LOCALID_PARC_BAIYA,Common_Movement_FaceDown)
        applymovement(LOCALID_PARC_MAGNUS,Common_Movement_FaceDown)

        msgbox(format("Damn, a Power Spot, all the way out here?"),,SPEAKER_BAIYA_TIDE)

        msgbox(format("Between SharpRise Capital and the government, I guess nothing is off limits."),,SPEAKER_MAGNUS)

        msgbox(format("I’ll have some other The Tide members clear out the rest of the trapped Pokémon… Let’s go back to HalaiIsland."),,SPEAKER_ADAORA)

        closemessage

        applymovement(LOCALID_PARC_MAGNUS, moves(walk_down * 2, walk_left * 14, step_end))
        applymovement(LOCALID_PARC_ADAORA, moves(walk_left * 6, walk_up * 3, walk_left * 4, step_end))
        waitmovement(LOCALID_PARC_ADAORA)

        applymovement(LOCALID_PARC_BAIYA,Common_Movement_FaceLeft)
        applymovement(LOCALID_PLAYER,Common_Movement_FaceRight)

        msgbox(format("Coming with me, {PLAYER}?"),MSGBOX_YESNO,,SPEAKER_BAIYA_TIDE)

        closemessage

        if (var(VAR_RESULT) == YES){
        fadeblackandsetremovewarpfadeflag
            warpsilent(MAP_HALAI_ISLAND,255,34,13)
		waitstate
                end
        }else {
                msgbox(format("Meet us in the center of town, okay?"),,SPEAKER_BAIYA_TIDE)
                closemessage

                applymovement(LOCALID_PARC_BAIYA, moves(walk_up, walk_left * 9, step_end))
                waitmovement(LOCALID_PARC_BAIYA)

                removeobject(LOCALID_PARC_BAIYA)
                removeobject(LOCALID_PARC_MAGNUS)
                removeobject(LOCALID_PARC_ADAORA)
        }
        fadedefaultbgm
        call(TryAutoSave)
    endcutscene
    release
        end
}

