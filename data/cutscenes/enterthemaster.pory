	if (defeated(TRAINER_FRANK_ROBOT_3))
	{
		call(EnterTheMaster_CheckTrainer_Script)
	}

    closemessage
    trainerbattle_continue_after_lose(TRAINER_FRANK_ROBOT_3,format("Robot 3 lose text."))
    msgbox(format("Excellent work!"),,SPEAKER_ROBOT)
