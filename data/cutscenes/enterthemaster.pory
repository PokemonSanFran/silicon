const PLAYER = OBJ_EVENT_ID_PLAYER

script EnterTheMaster_Script_HideCharlotteEntrance
{
	setobjectflagfromlocalid(LOCALID_ROUTE100_CHARLOTTE)
}

script EnterTheMaster_Script_HideCharlotte
{
	setobjectflagfromlocalid(LOCALID_LEAVERRA_FOLLOWER_CHARLOTTE)
}

script EnterTheMaster_LeaverraForest_Inner_ObjectSetup_Script
{
    switch (var(VAR_LEAVERRA_FOREST_STATE))
    {
        case CHARLOTTE_WAITING_LEAVERRA_FOREST:
            call(EnterTheMaster_LeaverraForest_Inner_HideObjects_Script)
        case CHARLOTTE_ENTERED_LEAVERRA_FOREST:
            call(EnterTheMaster_LeaverraForest_Inner_HideObjects_Script)
        case POST_HAVE_YOU_SEEN_THE_NEWS:
			call_if_lt(VAR_STORYLINE_STATE,STORY_CLEAR,Quest_Rematches_Script_HideFrank)
			call_if_quest_not_complete(QUEST_WAREHOUSEWARFARE,Quest_Rematches_Script_HideFrank)
			setobjectflagfromlocalid(LOCALID_LEAVERRA_CHARLOTTE)
			setobjectflagfromlocalid(LOCALID_LEAVERRA_ROBOT_LEFT)
			setobjectflagfromlocalid(LOCALID_LEAVERRA_ROBOT_RIGHT)
        case LEAVERRA_FOREST_MAZE_COMPLETE:
            return
        case MET_FRANK:
            call(EnterTheMaster_RepositionCharlotteToRobot_Script)
        case FINISHED_FRANK_PUZZLES:
            return
		default:
            return
    }
}

script EnterTheMaster_LeaverraForest_Inner_HideObjects_Script
{
    setobjectflagfromlocalid(LOCALID_LEAVERRA_FRANK)
    setobjectflagfromlocalid(LOCALID_LEAVERRA_CHARLOTTE)
    setobjectflagfromlocalid(LOCALID_LEAVERRA_ROBOT_LEFT)
    setobjectflagfromlocalid(LOCALID_LEAVERRA_ROBOT_RIGHT)
}

script EnterTheMaster_RepositionCharlotteToRobot_Script
{
    setobjectxy(LOCALID_LEAVERRA_CHARLOTTE,2,5)
    setobjectxyperm(LOCALID_LEAVERRA_CHARLOTTE,2,5)
    turnobject(LOCALID_LEAVERRA_CHARLOTTE,DIR_NORTH)
}

script EnterTheMaster_Interact_Script
{
    lock
        faceplayer
        goto(EnterTheMaster_Ready_Dialogue)
}

script EnterTheMaster_WalkingTrigger_Script
{
    lock
        applymovement(PLAYER,Common_Movement_FaceLeft)
        waitmovement(0)
        goto(EnterTheMaster_Ready_Dialogue)
}

script EnterTheMaster_Ready_Dialogue
{

    setvar(VAR_LEAVERRA_FOREST_STATE,CHARLOTTE_ENTERED_LEAVERRA_FOREST)
        msgbox(format("Morning. Ready to find this old dude?"),,SPEAKER_CHARLOTTE)

        msgbox(format("As ready as I'm going to be!"),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("Daddy sent another care package, so if we stick together, I'll keep you healed up."),,SPEAKER_CHARLOTTE)

        msgbox(format("Thanks… dad?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        closemessage

        moveobjecttocoords(LOCALID_LEAVERRA_CHARLOTTE,4,6,DIR_NORTH)
        waitmovement(LOCALID_LEAVERRA_CHARLOTTE)
        playse(SE_EXIT)
        removeobject(LOCALID_LEAVERRA_CHARLOTTE)
        waitse
        call(TryAutoSave)
        release
        end
}

script EnterTheMaster_Script_StartFollow
{
	checkfollowernpc
	if (var(VAR_RESULT) == TRUE)
	{
		release
		end
	}
    special(HealPlayerParty)
	setfollowernpc(LOCALID_LEAVERRA_FOLLOWER_CHARLOTTE,FNPC_ALL,EnterTheMaster_InteractFollower_Script,PARTNER_CHARLOTTE)
}

script EnterTheMaster_InteractFollower_Script
{
	random(4)

        switch(var(VAR_RESULT)){
            case 0: msgbox(format("How do you think my new Pokémon is faring? I'm curious to see how it integrates with the rest of my team."),MSGBOX_NPC,SPEAKER_CHARLOTTE)
            case 1: msgbox(format("You know, I'm really sick of The Tide's shit. Its their fault we're stuck in this stupid forest."),MSGBOX_NPC,SPEAKER_CHARLOTTE)
            case 2: msgbox(format("I thought Resido's Gym Leaders would be tougher. I wonder how their old Elite Four stacks up to Unova's?"),MSGBOX_NPC,SPEAKER_CHARLOTTE)
            case 3: msgbox(format("Do you think they're going to be worth all this hassle?"),MSGBOX_NPC,SPEAKER_CHARLOTTE)
        }

    closemessage
        release
        end
}

script EnterTheMaster_LeaveWoods_Script
{
    lock
	checkfollowernpc
	if (var(VAR_RESULT) == FALSE)
	{
		release
		end
	}
	facefollowernpc
	msgbox(format("Tired already? I'll be waiting here."),,SPEAKER_CHARLOTTE)
	closemessage
	moveobjecttocoords(OBJ_EVENT_ID_NPC_FOLLOWER,48,24,DIR_NORTH)
	waitmovement(OBJ_EVENT_ID_NPC_FOLLOWER)
	destroyfollowernpc
	clearobjectflagfromlocalid(LOCALID_LEAVERRA_FOLLOWER_CHARLOTTE)
	addobject(LOCALID_LEAVERRA_FOLLOWER_CHARLOTTE)
	release
	end
}

script EnterTheMaster_CompleteMaze_Dialogue {

    setvar(VAR_LEAVERRA_FOREST_STATE,LEAVERRA_FOREST_MAZE_COMPLETE)
        lock
		facefollowernpc
        msgbox(format("I don't think there's anywhere else for them to be… they've gotta be in here."),,SPEAKER_CHARLOTTE)
        bufferspeciesname(STR_VAR_1,SPECIES_DIALGA)
        msgbox(format("You think they've just been alone in here, waiting for us for {STR_VAR_1} knows how long?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        msgbox(format("They're getting paid. "),,SPEAKER_CHARLOTTE)
        closemessage
		moveobjecttocoords(OBJ_EVENT_ID_NPC_FOLLOWER,25,21,DIR_NORTH)
        waitmovement(OBJ_EVENT_ID_NPC_FOLLOWER)
        playse(SE_EXIT)
        waitse
		destroyfollowernpc
        call(TryAutoSave)
        release
        end
}

script EnterTheMaster_ClearingIntro_Dialogue
{
        startcutscene(JUMPPLAYER_ENTERTHEMASTER)
    setvar(VAR_LEAVERRA_FOREST_STATE,MET_FRANK)
        playbgm(MUS_ENCOUNTER_ELITE_FOUR,FALSE)

        moveobjecttocoords(PLAYER,10,16,DIR_NORTH)
        waitmovement(PLAYER)

    buffermapname(STR_VAR_1,MAP_LEAVERRA_FOREST)
	msgbox(format("Charlotte and {PLAYER}! Welcome to the deepest part of {STR_VAR_1}."),,SPEAKER_FRANK)
        msgbox(format("Are you Frank?"),MSGBOX_DEFAULT,SPEAKER_ALICIA,,EMOTE_CONFUSE)

        reveal(REVEAL_FRANK)
        msgbox(format("Yeah! My notebook?"),,SPEAKER_FRANK)
        closemessage

        applymovement(LOCALID_LEAVERRA_FRANK,Common_Movement_FaceLeft)
        applymovement(LOCALID_LEAVERRA_CHARLOTTE, moves(walk_up, face_right, delay_16, walk_in_place_slow_right, step_end))
        waitmovement(LOCALID_LEAVERRA_CHARLOTTE)

		bufferspeciesname(STR_VAR_1,SPECIES_FRANK_MON_LEAD)
		bufferspeciesname(STR_VAR_2,SPECIES_FRANK_MON_PARTNER)
        buffermapname(STR_VAR_3,MAP_LANJING_TUNNEL)
        msgbox(format("I hope {STR_VAR_1} and {STR_VAR_2} in {STR_VAR_3} weren't too much trouble. Getting 'em to battle without my direct commands was a challenge!"),,SPEAKER_FRANK)

        msgbox(format("Is that what you're teaching us? Battling with our eyes closed? Sounds useful."),,SPEAKER_CHARLOTTE)

        msgbox(format("Every client always sends me one of these… Let's get -"),,SPEAKER_FRANK)
        closemessage

        call(EnterTheMaster_StartEarthquake_Script)

        applymovement(LOCALID_LEAVERRA_CHARLOTTE, moves(walk_down, face_up, step_end))
        waitmovement(LOCALID_LEAVERRA_CHARLOTTE)

        applymovement(LOCALID_LEAVERRA_FRANK, moves(walk_left * 2, walk_right *2, walk_left * 2, walk_right *2, face_down, step_end))
        waitmovement(LOCALID_LEAVERRA_FRANK)

        msgbox(format("Either of you familiar with Scott's Trainer Theory?"),,SPEAKER_FRANK)

        msgbox(format("Yeah, that's the Battle Frontier guy, right?"),,SPEAKER_CHARLOTTE)

        msgbox(format("Hmm, the smart alec actually knows something!"),,SPEAKER_FRANK)

        msgbox(format("Oh… does each part of this training map to each of those principles?"),,SPEAKER_CHARLOTTE)

        msgbox(format("Sorry, didn't go to Battle prep school. Who is Scott and what are these principles?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)

        applymovement(LOCALID_LEAVERRA_CHARLOTTE,Common_Movement_FaceRight)
        applymovement(PLAYER,Common_Movement_FaceLeft)
        waitmovement(0)

        msgbox(format("Scott is the founder of an amusement park in Hoenn. Its attractions were designed to test what Scott believed were the qualities that all Master trainers require… "),,SPEAKER_CHARLOTTE)

        delay(16)
        fadescreenswapbuffers(FADE_TO_BLACK)
        applymovement(LOCALID_LEAVERRA_CHARLOTTE,Common_Movement_FaceUp)
        applymovement(PLAYER,Common_Movement_FaceUp)
        waitmovement(PLAYER)
        fadescreenswapbuffers(FADE_FROM_BLACK)

        msgbox(format("…and so concludes my theory on how your silly little tests correspond with each of Scott's 7 principles."),,SPEAKER_CHARLOTTE)

        msgbox(format("…sorta, kinda, not really. If you think life is gonna to map one to one like that, you've gotta rude awakening ahead."),,SPEAKER_FRANK)
        msgbox(format("…Oh."),,SPEAKER_CHARLOTTE)

        msgbox(format("So what's next?"),MSGBOX_DEFAULT,SPEAKER_ALICIA)
        bufferitemname(STR_VAR_1,ITEM_MEGA_RING)
        msgbox(format("{PLAYER}, you've probably seen other Trainers using Mega Evolution. SharpRise wants their Trainers have access to the most powerful techniques, so in addition to my fee, SharpRise has provided {PLAYER} with a {STR_VAR_1}. Charlotte, I know you've already started to get a handle on it, but {PLAYER} here..."),,SPEAKER_FRANK)
        closemessage
        cueobjectplayer(LOCALID_LEAVERRA_FRANK)
        giveitem(ITEM_MEGA_RING)
        msgbox(format("Charlotte, do you wanna - "),,SPEAKER_FRANK)
        bufferitemname(STR_VAR_1,ITEM_MEGA_RING)
        msgbox(format("When your Pokémon is holding its Mega Stone and you have a {STR_VAR_1}, you can press {START_BUTTON} in battle to trigger a transformation! At the beginning of your turn, your Pokémon will Mega Evolve, which will juice their stats and sometimes give them a new type or ability."),,SPEAKER_CHARLOTTE)
        bufferitemname(STR_VAR_1,ITEM_MEGA_RING)
        msgbox(format("Your {STR_VAR_1} will only work once per battle, and your Pokémon will revert back to normal after it faints or when the battle ends."),,SPEAKER_CHARLOTTE)
        call(EnterTheMaster_MegaEvolution_Dialogue)
        msgbox(format("Pretty much got all the basics."),,SPEAKER_FRANK)
        msgbox(format("If you go further back into the clearing, there's battle simulation bots there. The right side one is for {PLAYER} - they're calibrated specifically based on the battle data that SharpRise Capital gave me for both of you."),MSGBOX_DEFAULT,SPEAKER_FRANK)
        goto(EnterTheMaster_ExplainRobots_Dialogue_First)
}

script EnterTheMaster_StartEarthquake_Script
{
    call(Earthquake_PlayNatural_EventScript)

    playse(SE_PIN)
    applymovement(PLAYER,Common_Movement_ExclamationMark)
    applymovement(LOCALID_LEAVERRA_FRANK,Common_Movement_ExclamationMark)
    applymovement(LOCALID_LEAVERRA_CHARLOTTE,Common_Movement_ExclamationMark)
    waitmovement(LOCALID_LEAVERRA_CHARLOTTE)

    call(Earthquake_Natural_Aftershock)

    msgbox(format("No injuries? Fantastic."),,SPEAKER_FRANK)
    msgbox(format("Now that's an idea...\n{PAUSE 30}A training course set during a constant earthquake..."),,SPEAKER_FRANK,TAIL_WHISPER)
    closemessage
}

script EnterTheMaster_MegaEvolution_Dialogue
{
    specialvar(VAR_0x8004,GetPartySlotIfMonCanMegaEvolve)
    if (var(VAR_0x8004) == PARTY_SIZE)
    {
        return
    }

    bufferpartymonnick(STR_VAR_1,VAR_0x8004)
    if (var(VAR_RESULT))
    {
        msgbox(format("Your {STR_VAR_1} will be capable of Mega Evolution once it fully evolves, but it needs to be holding its corresponding Mega Stone, the {STR_VAR_2}."),MSGBOX_DEFAULT,SPEAKER_CHARLOTTE)
    }
    else
    {
        msgbox(format("Your {STR_VAR_1} is capable of Mega Evolution, as long as its holding the correspond Mega Stone, the {STR_VAR_2}."),MSGBOX_DEFAULT,SPEAKER_CHARLOTTE)
    }
}

script EnterTheMaster_Dialogue_InteractExplainRobots
{
    lock
    call(EnterTheMaster_ExplainRobots_Dialogue)
    closemessage
    release
    end
}

script EnterTheMaster_ExplainRobots_Dialogue
{
    msgbox(format("If you talk to 'em, the robots will give you a refresher on how they work, but its pretty simple."),MSGBOX_DEFAULT,SPEAKER_FRANK)
    msgbox(format("The second stage of your training will be defeating the robot that is assigned to you."),MSGBOX_DEFAULT,SPEAKER_FRANK)
        msgbox(format("The first stage needed you to work together, but this time, you're on your own."),,SPEAKER_FRANK)
}

script EnterTheMaster_ExplainRobots_Dialogue_First{
        call(EnterTheMaster_ExplainRobots_Dialogue)
        msgbox(format("Okay, let's take a crack at these..."),,SPEAKER_CHARLOTTE)
        closemessage
        moveobjecttocoords(LOCALID_LEAVERRA_CHARLOTTE,7,10,DIR_NORTH)
        delay(16)
        fadescreenswapbuffers(FADE_TO_BLACK)
        call(EnterTheMaster_RepositionCharlotteToRobot_Script)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        fadedefaultbgm
        call(TryAutoSave)
        endcutscene
        release
        end
}

script EnterTheMaster_Interact_Charlotte_Script{
    lock
    msgbox(format("Okay, what if I send out this Pokémon first..."),,SPEAKER_CHARLOTTE,TAIL_WHISPER)
    release
    end
}


script EnterTheMaster_Interact_Robot_Script
{
    lock
    faceplayer
    msgbox(format("Which scenario would you like to run?"),,SPEAKER_ROBOT)

    dynmultichoice(0,0,FALSE,3,0,NULL,
        "Scenario 1",
        "Scenario 2",
        "Scenario 3",
        "Scenario 4",
        "Never mind.",
    )

    switch (var(VAR_RESULT))
    {
        case 0:goto(EnterTheMaster_Battle_Robot1_Script)
        case 1:goto(EnterTheMaster_Battle_Robot2_Script)
        case 2:goto(EnterTheMaster_Battle_Robot3_Script)
        case 3:goto(EnterTheMaster_Battle_Robot4_Script)
    }
    closemessage
    release
    end
}

script EnterTheMaster_CheckTrainer_Script
{
    msgbox(format("You've already completed this puzzle. Are you going to try again?"),MSGBOX_YESNO,SPEAKER_ROBOT)
    goto_if_eq(VAR_RESULT,NO,EnterTheMaster_Interact_Robot_Script)
}

script EnterTheMaster_Battle_Robot1_Script{
	if (defeated(TRAINER_FRANK_ROBOT_1))
	{
		call(EnterTheMaster_CheckTrainer_Script)
	}

    closemessage
    trainerbattle_continue_after_lose(TRAINER_FRANK_ROBOT_1,format("Robot 1 lose text."))
    msgbox(format("Excellent work!"),,SPEAKER_ROBOT)
    call(EnterTheMaster_CheckReward_Script)
    release
    end
}

script EnterTheMaster_Battle_Robot2_Script{

	if (defeated(TRAINER_FRANK_ROBOT_2))
	{
		call(EnterTheMaster_CheckTrainer_Script)
	}
    closemessage
    trainerbattle_continue_after_lose(TRAINER_FRANK_ROBOT_2,format("Robot 2 lose text."))
    msgbox(format("Excellent work!"),,SPEAKER_ROBOT)
    call(EnterTheMaster_CheckReward_Script)
    release
    end
}

