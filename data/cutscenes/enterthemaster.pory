script EnterTheMaster_Battle_Robot4_Script{

	if (defeated(TRAINER_FRANK_ROBOT_4))
	{
		call(EnterTheMaster_CheckTrainer_Script)
	}
    closemessage
    trainerbattle_continue_after_lose(TRAINER_FRANK_ROBOT_4,format("Robot 4 lose text."))
    msgbox(format("Excellent work!"),,SPEAKER_ROBOT)
