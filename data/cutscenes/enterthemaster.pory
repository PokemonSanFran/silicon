script EnterTheMaster_CheckReward_Script
{
	if (!defeated(TRAINER_FRANK_ROBOT_1))
	{
        goto(EnterTheMaster_Interact_Robot_Script)
	}
	if (!defeated(TRAINER_FRANK_ROBOT_2))
	{
        goto(EnterTheMaster_Interact_Robot_Script)
	}
	if (!defeated(TRAINER_FRANK_ROBOT_3))
	{
        goto(EnterTheMaster_Interact_Robot_Script)
	}
	if (!defeated(TRAINER_FRANK_ROBOT_4))
	{
        goto(EnterTheMaster_Interact_Robot_Script)
	}
    closemessage
	goto(EnterTheMaster_CompleteQuest_Script)
}

script EnterTheMaster_Interact_CharlotteRobot_Script{
    lock
    msgbox(format("This robot is for Charlotte."),MSGBOX_AUTOCLOSE,SPEAKER_ROBOT)
    release
    end
}

script EnterTheMaster_SetUpCompletion_Script{
    fadescreenswapbuffers(FADE_TO_BLACK)
    adddays(7)
    setobjectxy(LOCALID_LEAVERRA_CHARLOTTE,9,16)
    setobjectxyperm(LOCALID_LEAVERRA_CHARLOTTE,9,16)
    setobjectxy(PLAYER,10,16)
    applymovement(PLAYER,Common_Movement_FaceUp)
    TeleportCamera(10,16)
    applymovement(LOCALID_LEAVERRA_FRANK,Common_Movement_FaceDown)
    waitmovement(LOCALID_LEAVERRA_FRANK)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    return
}

script EnterTheMaster_CompleteQuest_Script{
    call(EnterTheMaster_SetUpCompletion_Script)
    setvar(VAR_LEAVERRA_FOREST_STATE,FINISHED_FRANK_PUZZLES)
    msgbox(format("It's been quite a week. Impressed you were both able to clear those puzzles so quickly."),,SPEAKER_FRANK)
    msgbox(format("A week?!?"),,SPEAKER_CHARLOTTE,TAIL_SHOUT,EMOTE_SHOCK)
    msgbox(format("It feels like maybe a day at most!"),,SPEAKER_ALICIA,,EMOTE_SHOCK)
    msgbox(format("Yeah, the forest has that effect on people..."),,SPEAKER_FRANK)
    msgbox(format("Either way, good job. Go ahead and rest -"),,SPEAKER_FRANK)
    closemessage
    end
}
