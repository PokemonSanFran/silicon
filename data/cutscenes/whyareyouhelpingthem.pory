const PLAYER = OBJ_EVENT_ID_PLAYER

const LOCALID_NAVAL_BASE_INTERIOR_POLICE_A = LOCALID_CAMERA + 1
const LOCALID_NAVAL_BASE_INTERIOR_POLICE_B = LOCALID_CAMERA + 2
const LOCALID_NAVAL_BASE_INTERIOR_POLICE_C = LOCALID_CAMERA + 3

script WhyAreYouHelpingThem_HideObject_Script {
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
}

script WhyAreYouHelpingThem_ObjectCleanUp_Script {
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
}

script WhyAreYouHelpingThem_MoveObject_Script
{
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    callnative(WhyAreYouHelpingThem_LoadAdaoraMon)
    callnative(WhyAreYouHelpingThem_LoadCharlotteMon)
}

script WhyAreYouHelpingThem_MoveObjectBoss_Script {
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,7,3)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,7,3)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    callnative(WhyAreYouHelpingThem_LoadAdaoraMon)
    callnative(WhyAreYouHelpingThem_LoadCharlotteMon)
}

script WhyAreYouHelpingThem_MoveObjectAdaora_Script {
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_ADAORA,1,9)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_ADAORA,1,9)
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    turnobject(LOCALID_NAVAL_BASE_INTERIOR_ADAORA,DIR_NORTH)
}

script WhyAreYouHelpingThem_BlowHoleWall {
    setmetatile(12,1,0x3F2,FALSE)
    special(DrawWholeMapView)
}

script WhyAreYouHelpingThem_ObjectSetUpPostSave_Script {
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
    setobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_BAIYA,6,3)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_BAIYA,6,3)
    turnobject(LOCALID_NAVAL_BASE_INTERIOR_BAIYA,DIR_WEST)
    setobjectxy(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,2,16)
}

script WhyAreYouHelpingThem_ObjectDebriefSetUp_Script
{
    setobjectflagfromlocalid(LOCALID_HALAI_TALA)
    setobjectflagfromlocalid(LOCALID_HALAI_FRANK)
    setobjectflagfromlocalid(LOCALID_HALAI_ELEANOR)
    setobjectflagfromlocalid(LOCALID_HALAI_MAGNUS)
    setobjectflagfromlocalid(LOCALID_HALAI_ADAORA)
    setobjectflagfromlocalid(LOCALID_HALAI_BAIYA)
    setobjectxyperm(LOCALID_HALAI_CHIEF,26,4)
    setobjectxyperm(LOCALID_HALAI_CHARLOTTE,25,6)
    setobjectxyperm(LOCALID_HALAI_POLICE_A,27,6)
    setobjectxyperm(LOCALID_HALAI_POLICE_B,25,7)
    setobjectxyperm(LOCALID_HALAI_POLICE_C,27,7)
}

script WhyAreYouHelpingThem_BackAtCompound_ObjectSetUp_Script {
    setobjectxy(1,6,6)
    setobjectxy(2,6,5)
    setobjectxyperm(1,6,6)
    setobjectxyperm(2,6,5)
    turnobject(2,DIR_SOUTH)

    setobjectmovementtype(2,MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype(1,MOVEMENT_TYPE_FACE_UP)
    return
}

script WhyAreYouHelpingThem_Script_CreateRaidPolice
{
    spawnobject(OBJ_EVENT_GFX_MYSTERY_GIFT_MAN,LOCALID_NAVAL_BASE_INTERIOR_POLICE_A,21,24,MOVEMENT_TYPE_FACE_LEFT)
    spawnobject(OBJ_EVENT_GFX_MYSTERY_GIFT_MAN,LOCALID_NAVAL_BASE_INTERIOR_POLICE_B,21,25,MOVEMENT_TYPE_FACE_LEFT)
    spawnobject(OBJ_EVENT_GFX_MYSTERY_GIFT_MAN,LOCALID_NAVAL_BASE_INTERIOR_POLICE_C,21,26,MOVEMENT_TYPE_FACE_LEFT)
}

script WhyAreYouHelpingThem_StartRaid
{
    lock
    setvar(VAR_NAVAL_BASE_STATE,NAVAL_BASE_RAID_START)
    playse(SE_FAILURE)
    playse(SE_FAILURE)
    playse(SE_FAILURE)
    playse(SE_FAILURE)
    applymovement(SHARPRISE_COMPOUND_1F_CHARLOTTE,moves(face_down))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_POLICE_A,moves(walk_left * 8))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_POLICE_B,moves(walk_left * 8))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_POLICE_C,moves(walk_left * 8))
    msgbox(format("STRUCTURAL BREACH DETECTED. BASE IS NOW SHIFTING TO DEFENSE MODE. EVACUATE IMMEDIATELY."),MSGBOX_AUTOCLOSE,SPEAKER_SPEAKER)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_POLICE_C)

    msgbox(format("“Defense mode” is pretty advanced for some abandoned buildings."),,SPEAKER_CHARLOTTE)

    msgbox(format("We should redefine abandoned…"),,SPEAKER_ALICIA)

    msgbox(format("Let's split up. I'm faster than you and can cut off the leaders before they escape."),,SPEAKER_CHARLOTTE)

    msgbox(format("wha - fine, I'll try to find the source of the hack and shut it down."),,SPEAKER_ALICIA)

    msgbox(format("See ya."),,SPEAKER_CHARLOTTE)

    closemessage

    waitse
    applymovement(SHARPRISE_COMPOUND_1F_CHARLOTTE,moves(walk_left * 8))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_POLICE_A)
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_POLICE_B)
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_POLICE_C)
    call(WhyAreYouHelpingThem_MoveObject_Script)
    call(TryAutoSave)
    release
    end
}

script WhyAreYouHelpingThem_WitnessBattle
{
    lock
    setvar(VAR_NAVAL_BASE_STATE,CHASE_VIGRIM)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM, moves(walk_up * 4, step_end))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
    call(WhyAreYouHelpingThem_MoveObjectBoss_Script)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,moves(face_down))
    msgbox(format("Go after Vigrim! I'll hold this one off."),,SPEAKER_CHARLOTTE)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,moves(face_up))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    closemessage
    release
    end
}

script WhyAreYouHelpingThem_Dialogue_AdaoraBattle
{
    lock
    msgbox(format("Adaora is deeply focused on her battle with Charlotte. She doesn't even seem to acknowledge that you're there."))
    closemessage
    release
    end
}

script WhyAreYouHelpingThem_Dialogue_CharlotteBattle
{
    lock
    msgbox(format("Hurry up and go after Vigrim!"))
    closemessage
    release
    end
}

script WhyAreYouHelpingThem_Script_AdaoraCharlotteBattle
{
    lock
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE_MON,moves(walk_faster_up,delay_8,lock_facing_direction,walk_faster_down,delay_8))
    callnative(WhyAreYouHelpingThem_GetCharlotteMonCry)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE_MON)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA_MON,moves(walk_faster_down,delay_8,lock_facing_direction,walk_faster_up,delay_8))
    callnative(WhyAreYouHelpingThem_GetAdaoraMonCry)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA_MON)
    waitmoncry
    release
    end
}

script WhyAreYouHelpingThem_PreBattleBoss_Script {
    lock
        applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,moves(face_left))
        applymovement(PLAYER, moves(walk_up * 2, walk_right * 4, step_end))
        waitmovement(0)
        msgbox(format("It's a shame that the police have totally infiltrated our youth. "),,SPEAKER_VIGRIM)

        closemessage

        applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,Common_Movement_WalkLeft)
        waitmovement(0)

        msgbox(format("But beating you is going to be the best route out of here."),,SPEAKER_VIGRIM)

        closemessage

        trainerbattle_continue_after_lose(TRAINER_VIGRIM,format("Wait a minute…"))
        goto(WhyAreYouHelpingThem_PostBattleBoss_Dialogue)
}

script WhyAreYouHelpingThem_Script_HealOrReward
{
    specialvar(VAR_RESULT,GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON)
    {
        msgbox(format("You're incredible. Or a cheater. Can't quite tell. Either way, you can have this."),,SPEAKER_VIGRIM)
        closemessage
        cueobjectplayer(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
        waitmovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
        giveitem(ITEM_MASTER_BALL,1)
        clearflag(TRAINER_FLAGS_START + TRAINER_VIGRIM)
    }
    else
    {
        bypass_healblock
        msgbox(format("…I didn't even touch them…"),,SPEAKER_ALICIA)
    }
}

script WhyAreYouHelpingThem_PostBattleBoss_Dialogue{
		clearflag(B_FLAG_NO_WHITEOUT)
        setvar(VAR_NAVAL_BASE_STATE,SAVE_BAIYA_NAVAL_BASE)
        addobject(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
        call(WhyAreYouHelpingThem_MoveObjectAdaora_Script)
        applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA, moves(walk_up * 4, walk_right * 5, walk_up))
        call(WhyAreYouHelpingThem_Script_HealOrReward)
        msgbox(format("I'm sorry you have to experience this. I hope you eventually understand what's at stake here, {PLAYER}. Let me help you."),,SPEAKER_VIGRIM)
        closemessage
        cueobjectplayer(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
        playse(SE_USE_ITEM)
        waitmovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
        applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM, moves(face_down))
        waitmovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)

        msgbox(format("I handled the brat. I'm guessing you beat -"),,SPEAKER_ADAORA)
        closemessage

        playse(SE_PIN)
        waitse
        applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA, moves(emote_exclamation_mark, face_left, step_end))
        waitmovement(0)

        msgbox(format("Damn, you too, {PLAYER}?"),,SPEAKER_ADAORA)

        msgbox(format("What was all that shit you tried to tell me before?! What the hell is The Tide doing?"),,SPEAKER_ALICIA)

        msgbox(format("We've got to help more comrades escape. Another time."),,SPEAKER_VIGRIM)

        closemessage

        applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,moves(walk_right * 3))
        applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA,moves(walk_right * 3))
        waitmovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
        goto(WhyAreYouHelpingThem_ExplodeWall_Script)
}

script WhyAreYouHelpingThem_ExplodeWall_Script {
    playse(SE_M_EXPLOSION)
    waitse
    setvar(VAR_0x8004,1)
    setvar(VAR_0x8005,2)
    setvar(VAR_0x8006,8)
    setvar(VAR_0x8007,5)
    special(ShakeCamera)
    waitstate
    call(WhyAreYouHelpingThem_BlowHoleWall)
    clearobjectflagfromlocalid(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    playse(SE_EXIT)
    waitse
    addobject(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA, moves(walk_down, walk_left * 3, face_down, step_end))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM,moves(face_up))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA,moves(face_up))

    msgbox(format("This place is swarming with cops. You two need to get the hell out, right now. This goes straight out."),,SPEAKER_BAIYA_TIDE)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)

    msgbox(format("We can't leave people behind. "),,SPEAKER_VIGRIM)

    msgbox(format("We don't have time for this! If you get arrested, this all falls apart! You. Need. To. Go."),,SPEAKER_BAIYA_TIDE)

    msgbox(format("I think Baiya is right."),,SPEAKER_ADAORA)
    closemessage
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM, moves(walk_right * 3, walk_up * 2, set_invisible))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA, moves(walk_right * 3, walk_up * 3, set_invisible))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
    playse(SE_EXIT)
    waitse
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_ADAORA)
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_VIGRIM)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA, moves(walk_down, walk_left * 3, step_end))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)

    msgbox(format("You're working with The Tide too?!?"),,SPEAKER_ALICIA)
    closemessage
    startmenu_savescreen
    goto(WhyAreYouHelpingThem_StartBattle_Script)
}

script WhyAreYouHelpingThem_InteractBattle_Script {
    lock
    faceplayer
    goto(WhyAreYouHelpingThem_StartBattle_Script)
}

script WhyAreYouHelpingThem_StartBattle_Script{
    msgbox(format("Always have been."),,SPEAKER_BAIYA_TIDE)
    closemessage
    trainerbattle_no_intro(TRAINER_BAIYA_WHYAREYOUHELPINGTHEM,format("Another victory for the establishment."))
    goto(WhyAreYouHelpingThem_PostBattle_Dialogue)
}

script WhyAreYouHelpingThem_PostBattle_Dialogue
{
    setvar(VAR_HALAI_ISLAND_STATE,WHY_ARE_YOU_HELPING_THEM)
    startcutscene(JUMPPLAYER_WHYAREYOUHELPINGTHEM)

    setvar(VAR_NAVAL_BASE_STATE,DEFEATED_BAIYA_NAVAL_BASE)
    msgbox(format("Adaora tells me you're all good guys… now all this shit? And you? None of this makes any sense!"),,SPEAKER_ALICIA)

    msgbox(format("Why would it? You don't see what your bosses are doing to Resido. You don't see what you're doing to Resido."),,SPEAKER_BAIYA_TIDE)

    msgbox(format("{PLAYER}!"),,SPEAKER_CHARLOTTE)
    closemessage

    setobjectxyperm(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE,1,8)
    addobject(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE, moves(walk_up * 5, walk_right * 3, step_end))
    applymovement(PLAYER,moves(face_left))
    applymovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA, moves(player_run_right * 6, player_run_up * 2))
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    playse(SE_EXIT)
    removeobject(LOCALID_NAVAL_BASE_INTERIOR_BAIYA)
    waitmovement(LOCALID_NAVAL_BASE_INTERIOR_CHARLOTTE)
    waitse

    msgbox(format("I got knocked out. Did you stop Vigrim?"),,SPEAKER_CHARLOTTE)
    msgbox(format("No, they got away."),,SPEAKER_ALICIA)
    closemessage
    fadeblackandsetremovewarpfadeflag
    warpsilent(MAP_HALAI_ISLAND,255,26,6)
    waitstate
}

script WhyAreYouHelpingThem_MissionDebrief_Dialogue
{
    lock
    setvar(VAR_HALAI_ISLAND_STATE,SLEPT_AFTER_RAID)
    setvar(VAR_STORYLINE_STATE,STORY_COMPLETED_NAVAL_BASE)
    setvar(VAR_PLAYER_HOME_STATE,POST_NAVAL_BASE_RAID)
    applymovement(PLAYER,moves(face_up))

    msgbox(format("Great work in there, team. Andre, what's the sitrep regarding The Tide leadership?"),,SPEAKER_CHIEF)
    closemessage

    applymovement(LOCALID_HALAI_POLICE_A,moves(walk_up))
    waitmovement(LOCALID_HALAI_POLICE_A)

    buffermovename(STR_VAR_1,MOVE_FLY)
    msgbox(format("We spotted Vigrim and their lieutenant escaping on Pokemon using {STR_VAR_1}. We were unable to track them given our resources."),,SPEAKER_POLICE)
    closemessage

    applymovement(LOCALID_HALAI_POLICE_A, moves(lock_facing_direction, walk_down, unlock_facing_direction, step_end))
    waitmovement(LOCALID_HALAI_POLICE_A)

    msgbox(format("A shame. Still, we've shut down their primary base of operations, and we arrested a bunch of these shitheads. This was an absolute win!"),,SPEAKER_CHIEF)
    closemessage

    applymovement(LOCALID_HALAI_CHIEF,moves(walk_down))
    waitmovement(LOCALID_HALAI_CHIEF)

    buffermapname(STR_VAR_1,MAP_CUCONU_TOWN_SHARPRISE_COMPOUND_1F)
    msgbox(format("Not bad in there. Oliver wants you kids back at {STR_VAR_1}."),,SPEAKER_CHIEF)
    msgbox(format("{PLAYER}, I'm gonna head over. Wanna come?"),MSGBOX_YESNO,SPEAKER_CHARLOTTE)
    endcutscene

    if (var(VAR_RESULT) == YES)
    {
        closemessage
        warpsilent(MAP_CUCONU_TOWN_SHARPRISE_COMPOUND_1F,0)
        waitstate
    }
    else
    {
        buffermapname(STR_VAR_1,MAP_CUCONU_TOWN_SHARPRISE_COMPOUND_1F)
        msgbox(format("Suit yourself. See you in {STR_VAR_1}!"),,SPEAKER_CHARLOTTE)
        closemessage
        applymovement(LOCALID_HALAI_CHIEF,moves(walk_down * 3))
        applymovement(LOCALID_HALAI_POLICE_A,moves(walk_down * 3))
        applymovement(LOCALID_HALAI_POLICE_B,moves(walk_down * 3))
        applymovement(LOCALID_HALAI_POLICE_C,moves(walk_down * 3))
        applymovement(LOCALID_HALAI_CHARLOTTE,moves(walk_down * 3))
        fadescreenswapbuffers(FADE_TO_BLACK)
        removeobject(LOCALID_HALAI_CHIEF)
        removeobject(LOCALID_HALAI_POLICE_A)
        removeobject(LOCALID_HALAI_POLICE_B)
        removeobject(LOCALID_HALAI_POLICE_C)
        removeobject(LOCALID_HALAI_CHARLOTTE)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        release
        end
    }
}

script WhyAreYouHelpingThem_BackAtCompound_Dialogue
{
        lock
        startcutscene(JUMPPLAYER_WHYAREYOUHELPINGTHEM)
        setvar(VAR_PLAYER_HOME_STATE,NEXT_DAY_CHAMPIONSHIP)
        applymovement(PLAYER, moves(walk_up * 3, step_end))
        waitmovement(PLAYER)

        msgbox(format("What… a day. I know that was a lot of pressure, but from what I hear, you were both fantastic. Thank you."),,SPEAKER_OLIVER)
        msgbox(format("…it was a day."),,SPEAKER_ALICIA)

        buffermapname(STR_VAR_1,MAP_ESPULEE_OUTSKIRTS)
        buffermapname(STR_VAR_2,MAP_SHARPRISE_STADIUM_ARENA)
        msgbox(format("Good news - while you were training in {STR_VAR_1}, construction on {STR_VAR_2} finished up. The Group Stage will start in few days. Hopefully, that's enough time to rest up and get ready."),,SPEAKER_OLIVER)

        msgbox(format("Oh, that was fast. How did you…"),,SPEAKER_CHARLOTTE)

        msgbox(format("Don't worry about it! You two just focus on winning! "),,SPEAKER_OLIVER)

        msgbox(format("Now, I've got a lot of work to do between now and then. I'll see you both in a few days!"),,SPEAKER_OLIVER)

        closemessage

        applymovement(SHARPRISE_COMPOUND_1F_OLIVER, moves(walk_right, walk_down * 4, walk_left, walk_in_place_down, face_down, step_end))
        waitmovement(SHARPRISE_COMPOUND_1F_OLIVER)
        playse(SE_EXIT)
        removeobject(SHARPRISE_COMPOUND_1F_OLIVER)
        waitse

        applymovement(SHARPRISE_COMPOUND_1F_CHARLOTTE,moves(face_left))
        applymovement(PLAYER,moves(face_right))
        waitmovement(SHARPRISE_COMPOUND_1F_CHARLOTTE)

        msgbox(format("We've all got some work to do! I'll see you around, {PLAYER}."),,SPEAKER_CHARLOTTE)
        closemessage

        applymovement(SHARPRISE_COMPOUND_1F_CHARLOTTE, moves(walk_down * 3, step_end))
        waitmovement(SHARPRISE_COMPOUND_1F_CHARLOTTE)
        playse(SE_EXIT)
        removeobject(SHARPRISE_COMPOUND_1F_CHARLOTTE)
        waitse
        endcutscene
        release
        end
}

script WhyAreYouHelpingThem_StartChampionship_Dialogue
{
    msgbox(format("Are you ready to begin the Championship?"),MSGBOX_YESNO)

    if (var(VAR_RESULT) == NO)
    {
        closemessage
        return
    }
    else
    {
        callnative(WhyAreYouHelpingThemTimeJump)
        setvar(VAR_STORYLINE_STATE,STORY_START_CHAMPIONSHIP)
        warpsilent(MAP_SHARPRISE_STADIUM_LOCKERS,9,6)
        waitstate
    }
}
