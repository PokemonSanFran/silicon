const PLAYER = OBJ_EVENT_ID_PLAYER
const ATTENDANT = 8
const FLAG_HIDE_TALA = FLAG_TEMP_2

script TheStorySoFar_ExplainExhibit_Dialogue {
    lock
        call(ResetArantrazExhibit_Script)
        buffermapname(STR_VAR_1,MAP_ARANTRAZ)
        buffernumberstring(STR_VAR_2,STORY_ARANTRAZ_EXHIBIT_TRAINERS_COUNT)
        msgbox(format("Welcome to the {STR_VAR_1} Exhibit! If you're looking to learn about the island's history and culture, you'll need to complete our challenge! Across the island, there are {STR_VAR_2} signs. Those signs will teach you some history, but you'll have the defeat the Trainer guarding it. If you can defeat all {STR_VAR_2} Trainers without leaving the park, you'll win a prize! If you leave, you'll need to start the challenge over again."),,SPEAKER_ATTENDANT)
        closemessage
        applymovement(PLAYER,Common_Movement_WalkUp)
        waitmovement(PLAYER)
        setvar(VAR_ARANTRAZ_EXHIBIT_STATE,ARANTRAZ_EXHIBIT_START)
        release
        end
}

script Arantraz_InteractWithAttendant_Script {
    lock
       applymovement(ATTENDANT,Common_Movement_FacePlayer)
        goto(TheStorySoFar_Event_Script)
}

script TheStorySoFar_EntranceTrigger_Script {
    lock
        applymovement(PLAYER,Common_Movement_FaceRight)
        applymovement(ATTENDANT,Common_Movement_FaceLeft)
        goto(TheStorySoFar_Event_Script)
}

script TheStorySoFar_Event_Script {
    waitmovement(ATTENDANT)
        switch(var(VAR_ARANTRAZ_EXHIBIT_STATE))
        {
            case ARANTRAZ_EXHIBIT_NOT_STARTED: goto(TheStorySoFar_ExplainExhibit_Dialogue)
            case ARANTRAZ_EXHIBIT_START: goto(TheStorySoFar_CheckNumberDefeated_Script)
            case ARANTRAZ_EXHIBIT_FINISH: goto(TheStorySoFar_AwardPlayer_Script)
            case ARANTRAZ_EXHIBIT_REWARD: goto(TheStorySoFar_Congratulate_Dialogue)
            case ARANTRAZ_EXHIBIT_COMPLETE: goto(ArantrazAttendant_HealPlayer_Script)
        }
}

script TheStorySoFar_CheckNumberDefeated_Script
{
    callnative(Script_CountArantrazExhibitDefeated)
    callnative(TryIncrementArantrazVariable)

    if (var(VAR_RESULT) >= STORY_ARANTRAZ_EXHIBIT_TRAINERS_COUNT)
    {
        goto(TheStorySoFar_AwardPlayer_Script)
    }
    msgbox(format("You're not quite done."),,SPEAKER_ATTENDANT)
    callnative(BufferNumberArantrazExhibitDefeated)

    msgbox(format("You need to defeat {STR_VAR_1} more staff member(s) without leaving to complete the challenge."),,SPEAKER_ATTENDANT)
    call(TheStorySoFar_Script_PreventPlayerLeaving)

    closemessage
    release
    end
}

script TheStorySoFar_Script_PreventPlayerLeaving
{
    getplayerxy(VAR_TEMP_0,VAR_TEMP_1)
    if (var(VAR_TEMP_0) != 37)
    {
        return
    }

    if (var(VAR_TEMP_1) != 60)
    {
        return
    }

    msgbox(format("Are you sure you want to leave? You'll need to start the challenge over."),MSGBOX_YESNO,SPEAKER_ATTENDANT)
    if (var(VAR_RESULT) == NO)
    {
        applymovement(PLAYER,Common_Movement_WalkUp)
    }
    else
    {
        applymovement(PLAYER,Common_Movement_WalkDown)
        call(ResetArantrazExhibit_Script)
    }
    waitmovement(PLAYER)
}

script TheStorySoFar_AwardPlayer_Script
{
    setvar(VAR_ARANTRAZ_EXHIBIT_STATE,ARANTRAZ_EXHIBIT_REWARD)
    setvar(VAR_ARANTRAZ_STATE,FIRST_ARRIVED_ARANTRAZ)
    msgbox(format("Excellent work! For completing the challenge, here is your prize!"),,SPEAKER_ATTENDANT)
    closemessage
    cueobjectplayer(ATTENDANT)
    giveitem(ITEM_ARANTRAZ_EXHIBIT_REWARD,1)
    goto(YoungPadawan_Intro_Dialogue)
    release
    end
}

script TheStorySoFar_Congratulate_Dialogue
{
    lock
    msgbox(format("Congratulations! We hope you return for more training!"),,SPEAKER_ATTENDANT)
    closemessage
    release
    end
}

script TheStorySoFar_StartBattle1_Script
{
    trainerbattle_single(TRAINER_0D416B2C,gText_TheStorySoFar_IHopeYouDont,gText_TheStorySoFar_SlowDown, TheStorySoFar_ReadSign1_Dialogue)
    msgbox(format("Don't forget to stop and smell the roses."),MSGBOX_AUTOCLOSE,SPEAKER_MACK)
}

script TheStorySoFar_ReadSign1_Dialogue {
    callnative(TryIncrementArantrazVariable)
    startcutscene(JUMPPLAYER_THESTORYSOFAR_A)
    moveobjecttocoords(LOCALID_ARANTAZ_TRAINER_1,28,65,DIR_NORTH)
    waitmovement(LOCALID_ARANTAZ_TRAINER_1)
    moveobjecttocoords(LOCALID_PLAYER,29,64,DIR_NORTH)
    waitmovement(LOCALID_PLAYER)
    call(Arantaz_Dialogue_Sign1)
    call(TryAutoSave)
    endcutscene
}

